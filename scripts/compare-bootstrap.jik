// Run from the repository root after building jik-stage2 and jik-stage3.
use "jik/bytes"
use "jik/fs"
use "jik/io"
use "jik/process"
use "jik/string"
use "jik/sys"


throws func translate(foreign name: String, embedded: bool, r: Region) -> bytes::Bytes:
    output := "build/bootstrap-sequence/bootstrap.c"
    if fs::is_file(output):
        try fs::remove_file(output)
    end
    suffix := ".exe" if sys::platform() == "windows" else ""
    executable := concat("./", name, suffix)
    println("Comparing bootstrap C: ", executable)
    args := ["tran", "src/jik/main.jik", "--out", output]
    if embedded:
        args.push("--embed-core")
    end
    status := try process::run(executable, args)
    if status != 0:
        fail(concat(name, " translation failed (exit ", string::from_int(status), ")"))
    end
    data := try io::read_file_bytes(output, r)
    if bytes::len(data) == 0:
        fail(concat(name, " produced empty C output"))
    end
    mode := "embedded" if embedded else "header"
    try io::write_file_bytes(concat("build/bootstrap-sequence/", name, "-", mode, ".c"), data)
    return data
end


throws func compare(embedded: bool) -> void:
    try fs::mkdir_all("build/bootstrap-sequence")
    outputs := ["bootstrap.c"]
    for name in outputs:
        output := concat("build/bootstrap-sequence/", name)
        if fs::is_file(output):
            try fs::remove_file(output)
        end
    end
    // Identical output paths prevent filenames from affecting generated C.
    first := try translate("jik-stage2", embedded, _)
    second := try translate("jik-stage3", embedded, _)
    if not bytes::equals(first, second):
        offset := 0
        while offset < bytes::len(first) and offset < bytes::len(second) and bytes::get(first, offset) == bytes::get(second, offset):
            offset += 1
        end
        fail(concat("Stages 2 and 3 generated different C at byte ", string::from_int(offset),
            "; inspect build/bootstrap-sequence/"))
    end
    println("C comparison passed: stages 2 and 3 match; embedded runtime: ", embedded)
end


throws func compare_both():
    try compare(false)
    try compare(true)
end


func main():
    try compare_both():
    except:
        println("Bootstrap comparison failed: ", error_msg())
        sys::exit(1)
    end
end
