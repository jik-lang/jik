// Example: throwing functions, recovery, propagation, must, and postfix !

throws func parse_count(s):
    if s == "many":
        fail("expected digits, got 'many'")
    end
    if s == "bad-code":
        fail("custom parse failure", 17)
    end
    return 42
end

func show_parse(s):
    try value := parse_count(s):
        println("parsed ", s, " as ", value)
    except:
        println("failed to parse ", s)
        println("  msg:  ", error_msg())
        println("  code: ", error_code())
    end
end

throws func half_count(s):
    // A declaration with try propagates a failure to half_count's caller.
    count := try parse_count(s)
    return count / 2
end

func main():
    show_parse("ok")
    show_parse("many")
    show_parse("bad-code")

    value := must parse_count("ok")
    println("must succeeded with value ", value)
    println("postfix ! succeeded with value ", parse_count("ok")!)

    try half := half_count("many"):
        println("half: ", half)
    except:
        println("propagated failure: ", error_msg())
    end
end
