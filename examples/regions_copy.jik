// Example: retain selected notes after a temporary batch's region ends.
// Prefer allocating directly in the destination region when practical.
// Copy when existing data must be retained beyond its source region's lifetime.
//
// copy does not support arbitrary objects or general recursive deep copying.
// It supports String; Vec/Dict/Option with primitive, enum, or String elements;
// and non-extern structs/variants with only primitive, enum, or String fields/payloads.
// Nested composites, such as Vec[Vec[int]] or structs containing vectors, are
// unsupported. Neither Notebook in regions_basic nor User in region_ergonomics
// can be copied. Note below can, since its fields are String and bool.

struct Note:
    text: String
    pinned: bool
end


func retain_note(foreign note: Note, saved: Vec[Note]):
    // foreign allows note to come from a different region than saved.
    // It cannot be stored in saved directly.
    // Copy the whole Note, including fresh storage for its text, into saved's region.
    // note.copy(.saved) is shorthand for copy(note, .saved).
    push(saved, note.copy(.saved))
end


func process_batch(saved: Vec[Note]):
    // Keep the batch temporary; only selected notes need to survive this call.
    batch := [
        Note{text = "discard this draft", pinned = false},
        Note{text = "remember this idea", pinned = true}
    ]
    for note in batch:
        if note.pinned:
            retain_note(note, saved)
        end
    end
    // The batch and its original notes are released when this function returns.
end


func main():
    saved: Vec[Note]
    process_batch(saved)

    // The retained copy remains valid after process_batch's local region ends.
    for note in saved:
        println(note.text, " (pinned: ", note.pinned, ")")
    end
end
