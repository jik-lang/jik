use "../source"


enum TokenType:
	INTEGER
	STRING
	IDENTIFIER
	ASSIGN
	DECLARE
	COLON
	DOUBLE_COLON
	NEWLINE
	LPAREN
	RPAREN
	COMMA
	OP_PLUS
	OP_MINUS
	KWD_FUNC
	KWD_IF
	KWD_RETURN
	KWD_END
	KWD_USE
	KWD_AS
	ERROR
	EOF
end


table TokenTypeNames[TokenType] -> String:
    INTEGER: "integer"
    STRING: "string"
    IDENTIFIER: "identifier"
    ASSIGN: "="
    DECLARE: ":="
    COLON: ":"
    DOUBLE_COLON: "::"
    NEWLINE: "newline"
    LPAREN: "("
    RPAREN: ")"
    COMMA: ","
    OP_PLUS: "+"
    OP_MINUS: "-"
    KWD_FUNC: "func"
    KWD_IF: "if"
    KWD_RETURN: "return"
    KWD_END: "end"
    KWD_USE: "use"
    KWD_AS: "as"
    ERROR: "invalid token"
    EOF: "end of file"
end


struct Token:
	type: TokenType
	span: source::Span
end
