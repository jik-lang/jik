use "ast"
use "jik/strbuf"
use "jik/string"


func append_indent(sb: strbuf::StrBuf, depth: int) -> void:
    i := 0
    while i < depth:
        sb.append("  ")
        i += 1
    end
end


func append_int(sb: strbuf::StrBuf, value: int) -> void:
    sb.append(string::from_int(value, .sb))
end


func format(foreign ast: ast::Ast, r: Region) -> String:
    sb := strbuf::new("")
    if len(ast.nodes) > 0:
        format_node(ast, ast.root, 0, sb)
    end
    return strbuf::to_string(sb, r)
end


func format_node(foreign ast: ast::Ast, id: int, depth: int, sb: strbuf::StrBuf) -> void:
    node := ast.nodes[id]
    kind := node.kind
    append_indent(sb, depth)

    match kind:
    case MODULE{module}:
        sb.append("MODULE #")
        append_int(sb, id)
        sb.append(" [")
        append_int(sb, node.span.start)
        sb.append("..")
        append_int(sb, node.span.stop)
        sb.append("]\n")
        for import in module.imports:
            format_node(ast, import, depth + 1, sb)
        end
        for declaration in module.declarations:
            format_node(ast, declaration, depth + 1, sb)
        end
    case IMPORT{import}:
        sb.append("IMPORT #")
        append_int(sb, id)
        sb.append(" path=\"")
        sb.append(import.path)
        sb.append("\"")
        if import.alias is Some:
            sb.append(" alias=\"")
            sb.append(import.alias?)
            sb.append("\"")
        end
        sb.append("\n")
    case FUNCTION_DECL{function}:
        sb.append("FUNCTION #")
        append_int(sb, id)
        sb.append(" name=")
        sb.append(function.name)
        sb.append("\n")
        for parameter in function.parameters:
            format_node(ast, parameter, depth + 1, sb)
        end
        for statement in function.body.statements:
            format_node(ast, statement, depth + 1, sb)
        end
    case PARAMETER{parameter}:
        sb.append("PARAMETER #")
        append_int(sb, id)
        sb.append(" name=")
        sb.append(parameter.name)
        sb.append("\n")
        if parameter.annotation is Some:
            format_node(ast, parameter.annotation?, depth + 1, sb)
        end
    case TYPE_NAME{type_name}:
        sb.append("TYPE_NAME #")
        append_int(sb, id)
        sb.append(" name=")
        if type_name.qualifier is Some:
            sb.append(type_name.qualifier?)
            sb.append("::")
        end
        sb.append(type_name.name)
        sb.append("\n")
    case LOCAL_DECL{declaration}:
        sb.append("DECLARE #")
        append_int(sb, id)
        sb.append(" name=")
        sb.append(declaration.name)
        sb.append("\n")
        format_node(ast, declaration.initializer, depth + 1, sb)
    case IF{statement}:
        sb.append("IF #")
        append_int(sb, id)
        sb.append("\n")
        format_node(ast, statement.condition, depth + 1, sb)
        for body_statement in statement.body.statements:
            format_node(ast, body_statement, depth + 1, sb)
        end
    case RETURN{statement}:
        sb.append("RETURN #")
        append_int(sb, id)
        sb.append("\n")
        if statement.value is Some:
            format_node(ast, statement.value?, depth + 1, sb)
        end
    case INTEGER_LITERAL:
        sb.append("INTEGER #")
        append_int(sb, id)
        sb.append(" [")
        append_int(sb, node.span.start)
        sb.append("..")
        append_int(sb, node.span.stop)
        sb.append(")\n")
    case IDENTIFIER_EXPR{identifier}:
        sb.append("IDENTIFIER #")
        append_int(sb, id)
        sb.append(" name=")
        if identifier.qualifier is Some:
            sb.append(identifier.qualifier?)
            sb.append("::")
        end
        sb.append(identifier.name)
        sb.append("\n")
    case CALL{call}:
        sb.append("CALL #")
        append_int(sb, id)
        sb.append("\n")
        format_node(ast, call.callee, depth + 1, sb)
        for argument in call.arguments:
            format_node(ast, argument, depth + 1, sb)
        end
    case BINARY{binary}:
        sb.append("BINOP #")
        append_int(sb, id)
        sb.append(" ")
        if binary.op == ast::BinaryOp.PLUS:
            sb.append("PLUS\n")
        elif binary.op == ast::BinaryOp.MINUS:
            sb.append("MINUS\n")
        elif binary.op == ast::BinaryOp.LT:
            sb.append("LT\n")
        end
        format_node(ast, binary.left, depth + 1, sb)
        format_node(ast, binary.right, depth + 1, sb)
    end
end
