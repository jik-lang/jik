//! Module declarations and parse entry point; composes the expression and statement grammar.

use "state"
use "expressions"
use "statements"
use "ast"
use "../diag"
use "../source"
use "../lexer/token"
use "../language/native"
use "../language/types"


func add_import(p: state::Parser, id: int) -> void:
    module := p.ast.nodes[p.ast.root].kind.MODULE
    module.imports.push(id)
end


func add_declaration(p: state::Parser, id: int) -> void:
    module := p.ast.nodes[p.ast.root].kind.MODULE
    module.declarations.push(id)
end


throws func parse_import(p: state::Parser) -> int:
    start := try p.expect(token::TokenType.KWD_USE)
    path_tok := try p.expect(token::TokenType.STRING)
    path := copy(path_tok.text?, .p)
    stop := path_tok.span.stop

    alias: Option[String] = None@
    if p.current_type() == token::TokenType.KWD_AS:
        p.advance()
        alias_tok := try p.expect(token::TokenType.IDENTIFIER)
        alias = Some{p.text(alias_tok.span)}@
        stop = alias_tok.span.stop
    end
    try p.expect(token::TokenType.NEWLINE)

    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = stop}@
    return p.ast.add_import(span, path, alias)
end


throws func parse_parameter(p: state::Parser) -> int:
    start := p.current().span.start
    is_foreign := p.current_type() == token::TokenType.KWD_FOREIGN
    if is_foreign:
        p.advance()
    end
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    annotation: Option[int] = None@
    stop := name_tok.span.stop
    if p.current_type() == token::TokenType.COLON:
        p.advance()
        type_name := try p.parse_type_name()
        annotation = Some{type_name}@
        stop = p.ast.nodes[type_name].span.stop
    end
    span := source::Span{source_id = name_tok.span.source_id, start, stop}@
    id := p.ast.add_parameter(span, p.text(name_tok.span), annotation)
    p.ast.nodes[id].kind.PARAMETER.is_foreign = is_foreign
    return id
end



throws func parse_function(p: state::Parser) -> int:
    start := p.current()
    is_throwing := false
    is_external := false
    is_initializer := false
    while true:
        if p.current_type() == token::TokenType.KWD_THROWS and not is_throwing:
            is_throwing = true
            p.advance()
        elif p.current_type() == token::TokenType.KWD_EXTERN and not is_external:
            is_external = true
            p.advance()
        elif p.current_type() == token::TokenType.KWD_INIT and not is_initializer:
            is_initializer = true
            p.advance()
        else:
            break
        end
    end
    if is_initializer and (not is_external or is_throwing):
        diag::error(p.diagnostics, "invalid init declaration", "init requires a nonthrowing extern function", Some{start.span})
        fail("parse error")
    end
    try p.expect(token::TokenType.KWD_FUNC)
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    external_name: Option[String] = None[.p]
    if is_external:
        external_name = Some{p.text(name_tok.span)}[.p]
        try p.expect(token::TokenType.KWD_AS)
        p.skip_newlines()
        name_tok = try p.expect(token::TokenType.IDENTIFIER)
    end
    try p.expect(token::TokenType.LPAREN)
    parameters: Vec[int][.p]
    if p.current_type() != token::TokenType.RPAREN:
        param_id := try parse_parameter(p)
        parameters.push(param_id)
        while p.current_type() == token::TokenType.COMMA:
            p.advance()
            p.skip_newlines()
            param_id = try parse_parameter(p)
            parameters.push(param_id)
        end
    end
    try p.expect(token::TokenType.RPAREN)
    if is_external:
        for parameter_id in parameters:
            p.ast.nodes[parameter_id].kind.PARAMETER.is_external = true
            if p.ast.nodes[parameter_id].kind.PARAMETER.annotation is None:
                diag::error(p.diagnostics, "expected type annotation", "extern parameters require explicit types", Some{p.ast.nodes[parameter_id].span})
                fail("parse error")
            end
        end
        try p.expect(token::TokenType.ARROW)
        annotation := try p.parse_type_name()
        function := ast::FunctionDecl{is_throwing, external_name, is_initializer, name = p.text(name_tok.span), parameters, return_annotation = Some{annotation}}[.p]
        span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = p.ast.nodes[annotation].span.stop}@
        return p.ast.add_function_decl(span, function)
    end
    return_annotation: Option[int] = None[.p]
    if p.current_type() == token::TokenType.ARROW:
        p.advance()
        annotation := try p.parse_type_name()
        return_annotation = Some{annotation}[.p]
    end
    try p.expect(token::TokenType.COLON)
    try p.expect(token::TokenType.NEWLINE)

    function := ast::FunctionDecl{is_throwing, name = p.text(name_tok.span), parameters, return_annotation}[.p]
    p.skip_newlines()
    while p.current_type() != token::TokenType.KWD_END:
        if p.at_end():
            actual := p.current()
            diag::error(p.diagnostics, "unterminated function", "expected end", Some{actual.span})
            fail("unterminated function")
        end
        try statement := statements::parse_statement(p):
            function.body.statements.push(statement)
        except:
            p.synchronize_statement()
        end
        p.skip_newlines()
    end

    end_tok := try p.expect(token::TokenType.KWD_END)
    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = end_tok.span.stop}@
    return p.ast.add_function_decl(span, function)
end


throws func parse_type_declaration(p: state::Parser) -> int:
    start := p.advance()
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    kind := types::NamedKind.STRUCT
    if start.type == token::TokenType.KWD_ENUM:
        kind = types::NamedKind.ENUM
    elif start.type == token::TokenType.KWD_VARIANT:
        kind = types::NamedKind.VARIANT
    end
    declaration := ast::TypeDecl{name = p.text(name_tok.span), kind}[.p]
    try p.expect(token::TokenType.COLON)
    try p.expect(token::TokenType.NEWLINE)
    p.skip_newlines()
    while p.current_type() != token::TokenType.KWD_END:
        if p.at_end() or state::is_declaration_start(p.current_type()) or state::is_global_start(p):
            diag::error(p.diagnostics, "unterminated type declaration", "expected end", Some{p.current().span})
            fail("parse error")
        end
        member_tok := try p.expect(token::TokenType.IDENTIFIER)
        member := ast::TypeMember{name = p.text(member_tok.span)}[.p]
        stop := member_tok.span.stop
        if kind == types::NamedKind.STRUCT or (kind == types::NamedKind.VARIANT and p.current_type() == token::TokenType.COLON):
            try p.expect(token::TokenType.COLON)
            annotation := try p.parse_type_name()
            member.annotation = Some{annotation}
            stop = p.ast.nodes[annotation].span.stop
        end
        try p.expect(token::TokenType.NEWLINE)
        span := source::Span{source_id = p.file.id, start = member_tok.span.start, stop}[.p]
        declaration.members.push(p.ast.add(span, ast::NodeKind.TYPE_MEMBER{member}))
        p.skip_newlines()
    end
    end_tok := try p.expect(token::TokenType.KWD_END)
    span := source::Span{source_id = p.file.id, start = start.span.start, stop = end_tok.span.stop}[.p]
    return p.ast.add(span, ast::NodeKind.TYPE_DECL{declaration})
end


throws func parse_extern_type(p: state::Parser) -> int:
    start := try p.expect(token::TokenType.KWD_EXTERN)
    try p.expect(token::TokenType.KWD_STRUCT)
    external := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.KWD_AS)
    p.skip_newlines()
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.NEWLINE)
    declaration := ast::TypeDecl{name = p.text(name_tok.span), kind = types::NamedKind.EXTERN_STRUCT, external_name = Some{p.text(external.span)}}[.p]
    span := source::Span{source_id = p.file.id, start = start.span.start, stop = name_tok.span.stop}[.p]
    return p.ast.add(span, ast::NodeKind.TYPE_DECL{declaration})
end


throws func parse_table(p: state::Parser) -> int:
    start := try p.expect(token::TokenType.KWD_TABLE)
    name := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.LBRACKET)
    key := try p.parse_type_name()
    try p.expect(token::TokenType.RBRACKET)
    try p.expect(token::TokenType.ARROW)
    value := try p.parse_type_name()
    try p.expect(token::TokenType.COLON)
    try p.expect(token::TokenType.NEWLINE)
    declaration := ast::TableDecl{name = p.text(name.span), key_annotation = key, value_annotation = value, initialization_order = -1}[.p]
    p.skip_newlines()
    while p.current_type() != token::TokenType.KWD_END:
        if p.at_end() or state::is_declaration_start(p.current_type()) or state::is_global_start(p):
            diag::error(p.diagnostics, "unterminated table", "expected end", Some{p.current().span})
            fail("parse error")
        end
        tag := try p.expect(token::TokenType.IDENTIFIER)
        try p.expect(token::TokenType.COLON)
        entry := try expressions::parse_expression(p)
        try p.expect(token::TokenType.NEWLINE)
        declaration.entries.push(ast::TableEntry{name = p.text(tag.span), span = copy(tag.span, .p), value = entry, member = -1}[.p])
        p.skip_newlines()
    end
    close := try p.expect(token::TokenType.KWD_END)
    span := source::Span{source_id = p.file.id, start = start.span.start, stop = close.span.stop}[.p]
    return p.ast.add(span, ast::NodeKind.TABLE_DECL{declaration}[.p])
end


throws func parse_global(p: state::Parser) -> int:
    name := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.DECLARE)
    initializer := try expressions::parse_expression(p)
    if not p.at_end():
        try p.expect(token::TokenType.NEWLINE)
    end
    span := source::Span{source_id = p.file.id, start = name.span.start, stop = p.ast.nodes[initializer].span.stop}[.p]
    return p.ast.add(span, ast::NodeKind.GLOBAL_DECL{ast::GlobalDecl{name = p.text(name.span), initializer}}[.p])
end


throws func parse_named_declaration(p: state::Parser) -> int:
    if p.current_type() == token::TokenType.KWD_TABLE:
        id := try parse_table(p)
        return id
    end
    if p.current_type() == token::TokenType.KWD_EXTERN:
        declaration := try parse_extern_type(p)
        return declaration
    end
    declaration := try parse_type_declaration(p)
    return declaration
end


throws func parse_directive(p: state::Parser) -> void:
    start := p.advance()
    try p.expect(token::TokenType.LPAREN)
    if start.type == token::TokenType.DIRECTIVE_PLATFORM or start.type == token::TokenType.DIRECTIVE_PROFILE:
        value := try p.expect(token::TokenType.IDENTIFIER)
        name := p.text(value.span)
        if start.type == token::TokenType.DIRECTIVE_PROFILE:
            while p.current_type() == token::TokenType.OP_MINUS:
                p.advance()
                part := try p.expect(token::TokenType.IDENTIFIER)
                name = concat(name, "-", p.text(part.span), .p)
            end
            if name == "all":
                p.build_profile = native::Profile.ALL
            elif name == "windows-x64-mingw":
                p.build_profile = native::Profile.WINDOWS_X64_MINGW
            elif name == "linux-x64-gnu":
                p.build_profile = native::Profile.LINUX_X64_GNU
            else:
                diag::error(p.diagnostics, "unknown build profile", name, Some{value.span})
                fail("parse error")
            end
        else:
            if name == "all":
                p.build_platform = native::Platform.ALL
            elif name == "windows":
                p.build_platform = native::Platform.WINDOWS
            elif name == "linux":
                p.build_platform = native::Platform.LINUX
            else:
                diag::error(p.diagnostics, "unknown build platform", name, Some{value.span})
                fail("parse error")
            end
        end
        try p.expect(token::TokenType.RPAREN)
    else:
        kind := native::Kind.INCLUDE_DIR
        if start.type == token::TokenType.DIRECTIVE_LIBDIR:
            kind = native::Kind.LIB_DIR
        elif start.type == token::TokenType.DIRECTIVE_LINK:
            kind = native::Kind.LINK
        elif start.type == token::TokenType.DIRECTIVE_COPY:
            kind = native::Kind.COPY
        end
        requirement := native::Requirement{kind, platform = p.build_platform, profile = p.build_profile}[.p]
        while true:
            argument := try p.expect(token::TokenType.STRING)
            requirement.arguments.push(copy(argument.text?, .p))
            if p.current_type() != token::TokenType.COMMA:
                break
            end
            p.advance()
        end
        close := try p.expect(token::TokenType.RPAREN)
        requirement.span = source::Span{source_id = p.file.id, start = start.span.start, stop = close.span.stop}[.p]
        p.ast.nodes[p.ast.root].kind.MODULE.requirements.push(requirement)
    end
    if not p.at_end():
        try p.expect(token::TokenType.NEWLINE)
    end
end


/// Parse one module into the inferred result region. Recover from declaration
/// errors and return partial syntax with diagnostics; callers must gate later phases.
func parse(file: source::SourceFile, tokens: Vec[token::Token], diagnostics: diag::Diagnostics) -> ast::Ast:
    p := state::new(file, tokens, diagnostics)
    imports_finished := false
    p.skip_newlines()
    while not p.at_end():
        if p.current_type() == token::TokenType.KWD_USE:
            if imports_finished:
                actual := p.current()
                diag::error(p.diagnostics, "imports must precede top-level declarations", "", Some{actual.span})
            end
            try import := parse_import(p):
                if not imports_finished:
                    add_import(p, import)
                end
            except:
                p.synchronize_top_level()
            end
        elif state::is_directive(p.current_type()):
            try parse_directive(p):
            except:
                p.synchronize_top_level()
            end
        elif p.current_type() == token::TokenType.EMBEDDED_C:
            embedded := p.advance()
            add_declaration(p, p.ast.add(copy(embedded.span, .p), ast::NodeKind.EMBEDDED_C{copy(embedded.text?, .p)}[.p]))
        elif p.current_type() == token::TokenType.KWD_INIT or p.current_type() == token::TokenType.KWD_FUNC or p.current_type() == token::TokenType.KWD_THROWS or (p.current_type() == token::TokenType.KWD_EXTERN and p.tokens[p.pos + 1].type != token::TokenType.KWD_STRUCT):
            imports_finished = true
            try function := parse_function(p):
                add_declaration(p, function)
            except:
                p.synchronize_top_level()
            end
        elif p.current_type() == token::TokenType.IDENTIFIER:
            imports_finished = true
            try declaration := parse_global(p):
                add_declaration(p, declaration)
            except:
                p.synchronize_top_level()
            end
        elif state::is_declaration_start(p.current_type()):
            imports_finished = true
            try declaration := parse_named_declaration(p):
                add_declaration(p, declaration)
            except:
                p.synchronize_top_level()
            end
        else:
            imports_finished = true
            actual := p.current()
            if actual.type != token::TokenType.ERROR:
                diag::error(p.diagnostics, "expected import or function declaration", "", Some{actual.span})
            end
            p.synchronize_top_level()
        end
        p.skip_newlines()
    end
    return p.ast
end
