use "jik/string"

use "../diag"
use "../source"
use "../lexer/token"
use "ast"


struct Parser:
    file: source::SourceFile
    tokens: Vec[token::Token]
    diagnostics: diag::Diagnostics
    pos: int
    ast: ast::Ast
end


func new(file: source::SourceFile, tokens: Vec[token::Token], diagnostics: diag::Diagnostics) -> Parser:
    p := Parser{file, tokens, diagnostics, ast = ast::Ast{}}@
    span := source::Span{source_id = file.id, start = 0, stop = len(file.text)}@
    p.ast.root = p.ast.add_module(span)
    return p
end


func current(p: Parser) -> token::Token:
    return p.tokens[p.pos]
end


func current_type(p: Parser) -> token::TokenType:
    return p.tokens[p.pos].type
end


func at_end(p: Parser) -> bool:
    return p.current_type() == token::TokenType.EOF
end


func advance(p: Parser) -> token::Token:
    tok := p.current()
    if not p.at_end():
        p.pos += 1
    end
    return tok
end


throws func expect(p: Parser, kind: token::TokenType) -> token::Token:
    if p.current_type() != kind:
        actual := p.current()
        if actual.type == token::TokenType.ERROR:
            p.advance()
            fail("parse error")
        end
        diag::error(p.diagnostics, "unexpected token", concat("expected ", token::TokenTypeNames[kind]), Some{actual.span})
        fail("parse error")
    end
    return p.advance()
end


func skip_newlines(p: Parser) -> void:
    while p.current_type() == token::TokenType.NEWLINE:
        p.advance()
    end
end


func synchronize_statement(p: Parser) -> void:
    while not p.at_end():
        if p.current_type() == token::TokenType.NEWLINE:
            p.advance()
            return
        end
        if p.current_type() == token::TokenType.KWD_END:
            return
        end
        p.advance()
    end
end


func synchronize_top_level(p: Parser) -> void:
    while not p.at_end():
        if p.current_type() == token::TokenType.KWD_USE or p.current_type() == token::TokenType.KWD_FUNC:
            return
        end
        p.advance()
    end
end


func text(p: Parser, span: source::Span) -> String:
    return must string::slice(p.file.text, span.start, span.stop, .p)
end


func add_import(p: Parser, id: int) -> void:
    module := p.ast.nodes[p.ast.root].kind.MODULE
    module.imports.push(id)
end


func add_function(p: Parser, id: int) -> void:
    module := p.ast.nodes[p.ast.root].kind.MODULE
    module.declarations.push(id)
end


throws func parse_import(p: Parser) -> int:
    start := try p.expect(token::TokenType.KWD_USE)
    path_tok := try p.expect(token::TokenType.STRING)
    path := must string::slice(p.file.text, path_tok.span.start + 1, path_tok.span.stop - 1, .p)
    stop := path_tok.span.stop

    alias: Option[String] = None@
    if p.current_type() == token::TokenType.KWD_AS:
        p.advance()
        alias_tok := try p.expect(token::TokenType.IDENTIFIER)
        alias = Some{p.text(alias_tok.span)}@
        stop = alias_tok.span.stop
    end
    try p.expect(token::TokenType.NEWLINE)

    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = stop}@
    return p.ast.add_import(span, path, alias)
end


throws func parse_primary(p: Parser) -> int:
    tok := p.current()
    if tok.type == token::TokenType.INTEGER:
        p.advance()
        return p.ast.add_integer(tok.span)
    elif tok.type == token::TokenType.IDENTIFIER:
        p.advance()
        qualifier: Option[String] = None@
        name := p.text(tok.span)
        last_span := tok.span
        if p.current_type() == token::TokenType.DOUBLE_COLON:
            p.advance()
            qualifier = Some{name}@
            member := try p.expect(token::TokenType.IDENTIFIER)
            name = p.text(member.span)
            last_span = member.span
        end
        identifier_id := p.ast.add_identifier(tok.span, last_span, qualifier, name)
        if p.current_type() == token::TokenType.LPAREN:
            p.advance()
            arguments: Vec[int]@
            if p.current_type() != token::TokenType.RPAREN:
                argument := try p.parse_expression()
                arguments.push(argument)
                while p.current_type() == token::TokenType.COMMA:
                    p.advance()
                    argument = try p.parse_expression()
                    arguments.push(argument)
                end
            end
            close := try p.expect(token::TokenType.RPAREN)
            return p.ast.add_call(identifier_id, arguments, close.span)
        end
        return identifier_id
    end
    if tok.type == token::TokenType.ERROR:
        p.advance()
    else:
        diag::error(p.diagnostics, "expected expression", "expected integer or identifier", Some{tok.span})
    end
    fail("parse error")
end


throws func parse_additive(p: Parser) -> int:
    left := try p.parse_primary()
    while p.current_type() == token::TokenType.OP_PLUS or p.current_type() == token::TokenType.OP_MINUS:
        op_type := p.current_type()
        p.advance()
        right := try p.parse_primary()
        op := ast::BinaryOp.PLUS
        if op_type == token::TokenType.OP_MINUS:
            op = ast::BinaryOp.MINUS
        end
        left = p.ast.add_binary(left, right, op)
    end
    return left
end


throws func parse_expression(p: Parser) -> int:
    left := try p.parse_additive()
    while p.current_type() == token::TokenType.OP_LT:
        p.advance()
        right := try p.parse_additive()
        left = p.ast.add_binary(left, right, ast::BinaryOp.LT)
    end
    return left
end



throws func parse_declaration(p: Parser) -> int:
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.DECLARE)
    value := try p.parse_expression()
    try p.expect(token::TokenType.NEWLINE)
    span := source::Span{source_id = name_tok.span.source_id, start = name_tok.span.start, stop = p.ast.nodes[value].span.stop}@
    return p.ast.add_local_decl(span, p.text(name_tok.span), value)
end


throws func parse_return(p: Parser) -> int:
    start := try p.expect(token::TokenType.KWD_RETURN)
    value: Option[int] = None@
    stop := start.span.stop
    if p.current_type() != token::TokenType.NEWLINE:
        expression := try p.parse_expression()
        value = Some{expression}@
        stop = p.ast.nodes[expression].span.stop
    end
    try p.expect(token::TokenType.NEWLINE)
    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop}@
    return p.ast.add_return(span, value)
end


throws func parse_if(p: Parser) -> int:
    start := try p.expect(token::TokenType.KWD_IF)
    condition := try p.parse_expression()
    try p.expect(token::TokenType.COLON)
    try p.expect(token::TokenType.NEWLINE)

    statement := ast::IfStmt{condition}@
    p.skip_newlines()
    while p.current_type() != token::TokenType.KWD_END:
        if p.at_end():
            actual := p.current()
            diag::error(p.diagnostics, "unterminated if", "expected end", Some{actual.span})
            fail("unterminated if")
        end
        try body_statement := p.parse_statement():
            statement.body.statements.push(body_statement)
        except:
            p.synchronize_statement()
        end
        p.skip_newlines()
    end

    end_tok := try p.expect(token::TokenType.KWD_END)
    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = end_tok.span.stop}@
    return p.ast.add_if(span, statement)
end


throws func parse_statement(p: Parser) -> int:
    if p.current_type() == token::TokenType.KWD_IF:
        if_id := try p.parse_if()
        return if_id
    end
    if p.current_type() == token::TokenType.KWD_RETURN:
        return_id := try p.parse_return()
        return return_id
    end
    declaration_id := try p.parse_declaration()
    return declaration_id
end


throws func parse_type_name(p: Parser) -> int:
    first := try p.expect(token::TokenType.IDENTIFIER)
    qualifier: Option[String] = None@
    name := p.text(first.span)
    last_span := first.span
    if p.current_type() == token::TokenType.DOUBLE_COLON:
        p.advance()
        qualifier = Some{name}@
        member := try p.expect(token::TokenType.IDENTIFIER)
        name = p.text(member.span)
        last_span = member.span
    end
    return p.ast.add_type_name(first.span, last_span, qualifier, name)
end



throws func parse_parameter(p: Parser) -> int:
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    annotation: Option[int] = None@
    stop := name_tok.span.stop
    if p.current_type() == token::TokenType.COLON:
        p.advance()
        type_name := try p.parse_type_name()
        annotation = Some{type_name}@
        stop = p.ast.nodes[type_name].span.stop
    end
    span := source::Span{source_id = name_tok.span.source_id, start = name_tok.span.start, stop}@
    return p.ast.add_parameter(span, p.text(name_tok.span), annotation)
end



throws func parse_function(p: Parser) -> int:
    start := try p.expect(token::TokenType.KWD_FUNC)
    name_tok := try p.expect(token::TokenType.IDENTIFIER)
    try p.expect(token::TokenType.LPAREN)
    parameters: Vec[int]@
    if p.current_type() != token::TokenType.RPAREN:
        param_id := try p.parse_parameter()
        parameters.push(param_id)
        while p.current_type() == token::TokenType.COMMA:
            p.advance()
            param_id = try p.parse_parameter()
            parameters.push(param_id)
        end
    end
    try p.expect(token::TokenType.RPAREN)
    try p.expect(token::TokenType.COLON)
    try p.expect(token::TokenType.NEWLINE)

    function := ast::FunctionDecl{name = p.text(name_tok.span), parameters}@
    p.skip_newlines()
    while p.current_type() != token::TokenType.KWD_END:
        if p.at_end():
            actual := p.current()
            diag::error(p.diagnostics, "unterminated function", "expected end", Some{actual.span})
            fail("unterminated function")
        end
        try statement := p.parse_statement():
            function.body.statements.push(statement)
        except:
            p.synchronize_statement()
        end
        p.skip_newlines()
    end

    end_tok := try p.expect(token::TokenType.KWD_END)
    span := source::Span{source_id = start.span.source_id, start = start.span.start, stop = end_tok.span.stop}@
    return p.ast.add_function_decl(span, function)
end


func parse(file: source::SourceFile, tokens: Vec[token::Token], diagnostics: diag::Diagnostics) -> ast::Ast:
    p := new(file, tokens, diagnostics)
    imports_finished := false
    p.skip_newlines()
    while not p.at_end():
        if p.current_type() == token::TokenType.KWD_USE:
            if imports_finished:
                actual := p.current()
                diag::error(p.diagnostics, "imports must precede top-level declarations", "", Some{actual.span})
            end
            try import := p.parse_import():
                if not imports_finished:
                    p.add_import(import)
                end
            except:
                p.synchronize_top_level()
            end
        elif p.current_type() == token::TokenType.KWD_FUNC:
            imports_finished = true
            try function := p.parse_function():
                p.add_function(function)
            except:
                p.synchronize_top_level()
            end
        else:
            imports_finished = true
            actual := p.current()
            if actual.type != token::TokenType.ERROR:
                diag::error(p.diagnostics, "expected import or function declaration", "", Some{actual.span})
            end
            p.synchronize_top_level()
        end
        p.skip_newlines()
    end
    return p.ast
end
