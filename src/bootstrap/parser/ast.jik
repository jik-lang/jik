use "../source"


struct Node:
    span: source::Span
    kind: NodeKind
end


variant NodeKind:
    MODULE: Module
    IMPORT: Import
    FUNCTION_DECL: FunctionDecl
    LOCAL_DECL: LocalDecl
    INTEGER_LITERAL
    BINARY: BinaryExpr
end


struct LocalDecl:
    name: String
    initializer: int
end


enum BinaryOp:
    PLUS
    MINUS
end


struct BinaryExpr:
    left: int
    right: int
    op: BinaryOp
end


struct Module:
    imports: Vec[int]
    declarations: Vec[int]
end


struct Import:
    path: String
    alias: Option[String]
end


func as_import(nd: Node) -> Import:
    return nd.kind[NodeKind.IMPORT]
end


struct FunctionDecl:
    name: String
    body: Vec[int]
end

// Represents entire program ast
struct Ast:    
    root: int
    nodes: Vec[Node]
end

func get_root_module(ast: Ast):
    return ast.nodes[ast.root].kind[NodeKind.MODULE]
end


func add(ast: Ast, span: source::Span, kind: NodeKind) -> int:
    id := len(ast.nodes)
    ast.nodes.push(Node{span, kind})
    return id
end

