//! Collect and render diagnostics with source spans in reporting order.

use "jik/io"
use "jik/string"
use "jik/strbuf"

use "source"


enum MessageLevel:
    ERROR
    WARNING
end


table MessageLevelNames[MessageLevel] -> String:
    ERROR: "error"
    WARNING: "warning"
end


// One diagnostic with optional source context.
struct Message:
    level: MessageLevel
    summary: String    // Primary diagnostic text.
    detail: String    // Additional explanation; empty when no detail is needed.
    span: Option[source::Span]    // None for diagnostics without a source location.
end

// Accumulated diagnostics for one compilation.
struct Diagnostics:
    messages: Vec[Message]    // Diagnostics in reporting order.
    error_count: int    // Number of ERROR messages; warnings do not block compilation.
end


func new_message(level: MessageLevel, foreign summary: String, foreign detail: String, span: Option[source::Span], r: Region) -> Message:
    return Message{
        level,
        summary = copy(summary, r),
        detail = copy(detail, r),
        span
    }[r]
end


/// Append an error in reporting order, copying message text into diagnostics.
/// The optional span must belong to the diagnostics region.
func error(diag: Diagnostics, foreign summary: String, foreign detail: String, span: Option[source::Span]) -> void:
    message := new_message(MessageLevel.ERROR, summary, detail, span, .diag)
    diag.messages.push(message)
    diag.error_count += 1
end


func append_spaces(sb: strbuf::StrBuf, count: int) -> void:
    i := 0
    while i < count:
        sb.append(" ")
        i += 1
    end
end


func append_message(sb: strbuf::StrBuf, foreign message: Message, foreign src_mngr: source::SourceManager) -> void:
    sb.append("jik ")
    sb.append(MessageLevelNames[message.level])
    sb.append(": ")
    sb.append(message.summary)
    sb.append("\n")

    if message.span is None:
        if len(message.detail) > 0:
            sb.append("    ")
            sb.append(message.detail)
            sb.append("\n")
        end
        return
    end

    span := message.span?
    file := src_mngr.sources[span.source_id]
    line := source::line_index(file, span.start)
    start := source::line_start(file, line)
    stop := source::line_stop(file, line)
    column := span.start - start
    line_number := string::from_int(line + 1)
    line_text := must string::slice(file.text, start, stop)

    sb.append("      --> ")
    sb.append(file.path)
    sb.append(":")
    sb.append(line_number)
    sb.append(":")
    sb.append(string::from_int(column + 1))
    sb.append("\n  |\n")
    sb.append(line_number)
    sb.append(" |")
    sb.append(line_text)
    sb.append("\n")
    append_spaces(sb, len(line_number) + 1)
    sb.append("|")
    for i = 0, column:
        if i < len(line_text) and line_text[i] == '\t':
            sb.append("\t")
        else:
            sb.append(" ")
        end
    end
    sb.append("^\n")

    if len(message.detail) > 0:
        sb.append("    = ")
        sb.append(message.detail)
        sb.append("\n")
    end
end


/// Render accumulated messages into a String allocated in r.
func format_all(foreign diag: Diagnostics, foreign src_mngr: source::SourceManager, r: Region) -> String:
    sb := strbuf::new("", r)
    for m in diag.messages:
        append_message(sb, m, src_mngr)
    end
    return strbuf::to_string(sb, r)
end


func print_all(diag: Diagnostics, foreign src_mngr: source::SourceManager) -> void:
    io::write_stderr(format_all(diag, src_mngr))
end
