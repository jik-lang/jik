//! Shared CLI options, C compiler selection, and temporary build workspaces.

use "jik/argparse" as ap
use "jik/fs"
use "jik/path"
use "jik/process"
use "jik/string"
use "jik/sys"
use "jik/time"

use "../compiler"


func add_runtime_options(parser: ap::Parser):
    ap::add_option(parser, "--unsafe-no-bounds-checks", "", "Disable runtime vector bounds checks.")
    ap::add_option(parser, "--region-stats", "", "Print runtime region statistics at program exit.")
    ap::add_option(parser, "--region-tree", "", "Print the runtime region lifetime hierarchy.")
end


func apply_options(config: compiler::Config, result: ap::ParseResult):
    config.dump_ast = result.options["--dump-ast"] is Some
    config.verbose = result.options["--verbose"] is Some
    config.unsafe_no_bounds_checks = result.options["--unsafe-no-bounds-checks"] is Some
    config.region_stats = result.options["--region-stats"] is Some
    config.region_tree = result.options["--region-tree"] is Some
end


throws func select_compiler(foreign explicit: String, r: Region) -> String:
    if len(explicit) > 0:
        return copy(explicit, r)
    end
    configured := sys::getenv("JIK_CC")
    if configured is Some and len(configured?) > 0:
        return copy(configured?, r)
    end
    candidates := ["clang", "gcc", "cc"]
    for candidate in candidates:
        try result := process::capture(candidate, ["--version"]):
            if result.code == 0:
                return copy(candidate, r)
            end
        except:
            // An unavailable candidate does not prevent trying the next one.
        end
    end
    fail("no C compiler found; set JIK_CC or use --cc")
end


throws func make_workspace(r: Region) -> String:
    base := fs::temp_dir()
    stamp := time::unix_seconds()
    for index = 0, 1000:
        candidate := path::join([base, concat("jik-bootstrap-run-", string::from_int(stamp), "-", string::from_int(index))])
        if fs::exists(candidate):
            continue
        end
        try fs::mkdir(candidate):
            return copy(candidate, r)
        except:
            // mkdir reserves the directory atomically, including concurrent runs.
            if not fs::exists(candidate):
                msg := error_msg()
                code := error_code()
                fail(msg, code)
            end
        end
    end
    fail("could not reserve a temporary directory for jik run")
end


throws func cleanup_workspace(workspace: String) -> void:
    // The directory is exclusively reserved for this invocation. Native @copy
    // requirements may have added files, including before a later copy fails.
    names := try fs::read_dir(workspace)
    for name in names:
        file := path::join([copy(workspace), name])
        if fs::exists(file):
            try fs::remove_file(file)
        end
    end
    try fs::remove_dir(workspace)
end
