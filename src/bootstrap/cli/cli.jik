use "jik/argparse" as ap

use "help"


func run(args: Vec[String]) -> void:
    if len(args) == 1:
        println(help::format_help())
        return
    end

    if args[1] == "help":
        if len(args) == 2:
            println(help::format_help())
        else:
            help::run(args[2:])
        end
    end
end
