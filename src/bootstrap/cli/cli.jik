use "jik/argparse" as ap

use "help"


throws func run(args: Vec[String]) -> void:
    if len(args) == 1:
        println(help::format_help())
        return
    end

    if args[1] == "help":
        if len(args) == 2:
            println(help::format_help())
        else:
            try help::run(args[2:])
        end
    else:
        fail(concat("unknown command: ", args[1]))
    end
end
