use "jik/argparse" as ap
use "jik/strbuf"

use "command"
use "tran"


func format_help(r: Region) -> String:
    sb := strbuf::new("")
    strbuf::append(sb, "The command-line toolchain for the Jik programming language.\n\n")
    strbuf::append(sb, "Usage:\n\n")
    strbuf::append(sb, "    jik <command> [<args>...] [--<option> [<value>]]...\n\n")
    strbuf::append(sb, "Available commands:\n\n")

    width := 12
    for command in command::COMMANDS:
        if len(command.name) > width:
            width = len(command.name)
        end
    end

    for command in command::COMMANDS:
        strbuf::append(sb, "    ")
        strbuf::append(sb, command.name)
        _append_spaces(sb, width - len(command.name) + 2)
        strbuf::append(sb, command.summary)
        strbuf::append(sb, "\n")
    end

    return strbuf::to_string(sb, r)
end


func _append_spaces(sb: strbuf::StrBuf, count: int) -> void:
    i := 0
    while i < count:
        strbuf::append_char(sb, ' ')
        i += 1
    end
end


func make_parser(r: Region) -> ap::Parser:
    parser := ap::new("jik help", r)
    ap::add_positional(parser, "topic", "Show help for a command or documentation topic.")
    return parser
end


throws func run(args: Vec[String]):
    p := make_parser()
    res := try ap::parse(p, args)
    topic := res.positionals["topic"]?
    if topic == "help":
        println(ap::format_help(p))
    elif topic == "tran":
        println(ap::format_help(tran::make_parser()))
    else:
        fail(concat("unknown help topic: ", topic))
    end
end
