//! Reserve a temporary build workspace, compile, execute, and clean up.

use "jik/argparse" as ap
use "jik/io"
use "jik/path"
use "jik/process"
use "jik/sys"

use "../compiler"
use "native_build"
use "cc_flags"
use "utils"


func make_parser(r: Region) -> ap::Parser:
    parser := ap::new("jik run", r)
    ap::set_description(parser, "Translate a Jik source code file to C, build it with the selected C compiler, and run the executable.")
    ap::add_positional(parser, "input", "Input file")
    cc := ap::add_option(parser, "--cc", "", "C compiler executable (overrides JIK_CC; otherwise discover clang, gcc or cc).")
    ap::add_option_positional(cc, "compiler", "Executable name or path.")
    flags := ap::add_option(parser, "--ccflags", "", "Extra C compiler arguments (quote arguments containing spaces).")
    ap::add_option_positional(flags, "args", "C compiler arguments.")
    ap::add_option(parser, "--release", "", "Optimize the generated program with -O3.")
    ap::add_option(parser, "--dump-ast", "", "Print the parsed AST for each module.")
    ap::add_option(parser, "--verbose", "", "Print compilation and execution stages to stderr.")
    utils::add_runtime_options(parser)
    return parser
end


throws func execute(comp: compiler::Compiler, foreign cc: String, foreign workspace: String, foreign flags: Vec[String], release: bool, verbose: bool) -> int:
    executable := path::join([copy(workspace), "program.exe"])
    try native_build::compile(comp, cc, executable, flags, release, false, verbose)
    if verbose:
        io::write_stderr(concat("jik: run ", executable, "\n"))
    end
    program_args: Vec[String]
    exit_status := try process::run(executable, program_args)
    return exit_status
end


throws func compile_and_execute(foreign input: String, foreign workspace: String, foreign cc: String, foreign flags: Vec[String], foreign options: ap::ParseResult, release: bool, verbose: bool) -> int:
    config := compiler::Config{
        input_path = copy(input),
        output_path = path::join([copy(workspace), "program.c"])
    }
    comp := try compiler::new(config)
    utils::apply_options(comp.config, options)
    status := try execute(comp, cc, workspace, flags, release, verbose)
    return status
end


throws func run(args: Vec[String]) -> int:
    parser := make_parser()
    result := try ap::parse(parser, args)
    input := result.positionals["input"]?
    explicit := result.options["--cc"]?["compiler"]? if result.options["--cc"] is Some else ""
    flag_text := result.options["--ccflags"]?["args"]? if result.options["--ccflags"] is Some else ""
    flags := try cc_flags::parse(flag_text, sys::platform() == "windows")
    cc := try utils::select_compiler(explicit)
    workspace := try utils::make_workspace()
    status := 0
    try completed := compile_and_execute(input, workspace, cc, flags,
        result, result.options["--release"] is Some,
        result.options["--verbose"] is Some):
        status = completed
    except:
        msg := error_msg()
        code := error_code()
        try utils::cleanup_workspace(workspace):
        except:
            io::write_stderr(concat("jik: temporary cleanup failed: ", error_msg(), "\n"))
        end
        fail(msg, code)
    end
    try utils::cleanup_workspace(workspace)
    return status
end
