use "jik/io"
use "jik/path"


struct SourceFile:
    id: int
    path: String
    text: String
    line_starts: Vec[int]
end


struct SourceManager:
    source_cnt: int
    sources: Vec[SourceFile]
end


throws func add_source(sm: SourceManager, foreign path: String):
    text := try io::read_file(path, .sm)
    normalized := path::normalize(path, .sm)
    sf := SourceFile{
        id = sm.source_cnt,
        path = normalized,
        text = text
    }[.sm]
    sm.sources.push(sf)
    sm.source_cnt += 1
end


struct Span:
    source_id: int
    start: int
    stop: int
end
