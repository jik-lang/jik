//! Run semantic checks in order and stop when a step reports an error.

use "jik/io"

use "../program"
use "resolution/resolve"
use "typing/inference"
use "typing/typecheck"
use "regions/regions"


/// Resolve, select the entry, infer, validate types, and analyze regions.
/// Errors accumulate in Program diagnostics rather than being thrown.
/// With no diagnostics, syntax/type/region metadata is ready for codegen.
/// The caller prepares the graph schedules separately in Program.
func analyze_program(program: program::Program, entry_source_id: int, verbose: bool) -> void:
    diagnostics := program.diagnostics
    if diagnostics.error_count > 0:
        return
    end
    if verbose:
        io::write_stderr("jik: analyze program\n")
    end
    resolve::resolve_declarations(program)
    if diagnostics.error_count > 0:
        return
    end
    resolve::check_entry(program, entry_source_id)
    if diagnostics.error_count > 0:
        return
    end
    inference::run(program, entry_source_id)
    if diagnostics.error_count > 0:
        return
    end
    typecheck::run(program)
    if diagnostics.error_count == 0:
        if verbose:
            io::write_stderr("jik: check regions\n")
        end
        regions::run(program)
    end
end
