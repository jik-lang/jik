//! Generate the C file and its program startup code.

use "jik/string"

use "../program"
use "../version"
use "backend"
use "c_names"
use "type_support"
use "operations"
use "writer"
use "../modules/module"
use "../language/types"
use "../language/region_source"


// C generation settings supplied by the compiler driver.
struct Options:
    core_source: Option[String]    // Support header contents to embed; None emits a core.h include.
    emit_source_loc: bool
    unsafe_no_bounds_checks: bool
    region_stats: bool
    region_tree: bool
end


throws func emit_table_storage(g: backend::Translation) -> void:
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        root := mod.ast.get_root_module()
        for id in root.declarations:
            node := mod.ast.nodes[id]
            if not (node.kind is TABLE_DECL):
                continue
            end
            declaration := node.kind.TABLE_DECL
            backend::emit_source_location(g, node)
            g.output.write("static ")
            try backend::write_type(g, mod, declaration.value_type?, node)
            g.output.write(" ")
            backend::write_table_name(g, source_id, declaration.name)
            g.output.write(concat("[", string::from_int(len(declaration.ordered_values)), "];"))
            g.output.end_line()
            for value in declaration.initializer_nodes:
                if types::is_allocated(mod.type_store, mod.ast.nodes[value].inferred_type?):
                    g.needs_global_region = true
                end
            end
        end
    end
end

throws func emit_table_initializers(body: operations::BodyContext) -> void:
    g := body.translation
    // Resolution validates table references against this declaration order.
    // Tables are initialized before ordinary globals, whose expressions may read them.
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        root := mod.ast.get_root_module()
        for id in root.declarations:
            node := mod.ast.nodes[id]
            if node.kind is TABLE_DECL:
                declaration := node.kind.TABLE_DECL
                for member, value in declaration.ordered_values:
                    g.output.start_line()
                    backend::write_table_name(g, source_id, declaration.name)
                    g.output.write(concat("[", string::from_int(member), "] = "))
                    try operations::emit_expression(body, mod, value)
                    g.output.write(";")
                    g.output.end_line()
                end
            end
        end
    end
end

throws func emit_global_storage(g: backend::Translation) -> void:
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        for id in mod.ast.get_root_module().declarations:
            node := mod.ast.nodes[id]
            if not (node.kind is GLOBAL_DECL):
                continue
            end
            declaration := node.kind.GLOBAL_DECL
            backend::emit_source_location(g, node)
            g.output.write("static ")
            try backend::write_type(g, mod, node.inferred_type?, node)
            g.output.write(" ")
            backend::write_global_name(g, source_id, declaration.name)
            g.output.write(";")
            g.output.end_line()
            for value in declaration.initializer_nodes:
                child := mod.ast.nodes[value]
                if child.region_source.kind == region_source::Kind.GLOBAL:
                    g.needs_global_region = true
                end
            end
        end
    end
end

throws func emit_global_initializers(body: operations::BodyContext) -> void:
    g := body.translation
    // Module scheduling is prepared by the driver; declarations retain source order.
    for source_id in g.initialization_order:
        mod := g.modules[source_id]
        for id in mod.ast.get_root_module().declarations:
            node := mod.ast.nodes[id]
            if node.kind is GLOBAL_DECL:
                g.output.start_line()
                backend::write_global_name(g, source_id, node.kind.GLOBAL_DECL.name)
                g.output.write(" = ")
                try operations::emit_expression(body, mod, node.kind.GLOBAL_DECL.initializer)
                g.output.write(";")
                g.output.end_line()
            end
        end
    end
end

throws func emit_program(g: backend::Translation, foreign options: Options) -> void:
    // C dependencies constrain these phases even in one translation unit.
    // See README.md for the declaration/helper and runtime initialization orders.
    g.output.line(concat("// Generated with Jik version: ", version::VERSION))
    if options.unsafe_no_bounds_checks:
        g.output.line("#define JIK_UNSAFE_NO_BOUNDS_CHECKS")
    end
    if options.region_stats:
        g.output.line("#define JIK_REGION_STATS")
    end
    if options.region_tree:
        g.output.line("#define JIK_REGION_TREE")
    end
    if options.core_source is Some:
        g.output.write(options.core_source?)
        g.output.line("")
        g.output.line("// JIK TRANSLATION")
    else:
        g.output.line("#include \"core.h\"")
    end
    g.output.line("")
    // Embedded headers/C own external names and prototypes used by generated types.
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        for id in mod.ast.get_root_module().declarations:
            if mod.ast.nodes[id].kind is EMBEDDED_C:
                g.output.write(mod.ast.nodes[id].kind.EMBEDDED_C)
                g.output.line("")
            end
        end
    end
    type_support::emit_enums(g)
    try type_support::emit_data_types(g)
    try type_support::emit_copy_functions(g)
    type_support::emit_printers(g)
    try emit_table_storage(g)
    try emit_global_storage(g)
    // User prototypes and throwing-wrapper prototypes precede all Jik function bodies.
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        root := mod.ast.get_root_module()
        for id in root.declarations:
            if mod.ast.nodes[id].kind is FUNCTION_DECL:
                // The C header/embed owns external prototypes, including C's
                // permitted conversions (for example toupper(int) for char).
                if mod.ast.nodes[id].kind.FUNCTION_DECL.external_name is None:
                    try operations::emit_signature(g, mod, id, false)
                    g.output.write(";")
                    g.output.end_line()
                end
                if mod.ast.nodes[id].kind.FUNCTION_DECL.is_throwing:
                    try operations::emit_signature(g, mod, id, true)
                    g.output.write(";")
                    g.output.end_line()
                end
            end
        end
    end
    g.output.line("")
    for source_id in g.dependency_order:
        mod := g.modules[source_id]
        root := mod.ast.get_root_module()
        for id in root.declarations:
            if mod.ast.nodes[id].kind is FUNCTION_DECL:
                if mod.ast.nodes[id].kind.FUNCTION_DECL.external_name is None:
                    try operations::emit_function(g, mod, id)
                end
                if mod.ast.nodes[id].kind.FUNCTION_DECL.is_throwing:
                    try operations::emit_must_wrapper(g, mod, id)
                end
            end
        end
    end
    entry := g.modules[g.main_source_id]
    if entry.entry_origin is None:
        fail("semantic analysis must validate the entry function")
    end
    function := entry.ast.nodes[entry.entry_origin?].kind.FUNCTION_DECL
    has_arguments := len(function.parameters) == 1
    g.output.line("int main(int argc, char **argv) {" if has_arguments else "int main(void) {")
    g.output.indent()
    if options.region_stats:
        g.output.line("jik_region_register_global_stats_printer();")
    end
    if options.region_tree:
        g.output.line("jik_region_register_tree_printer();")
    end
    if g.needs_global_region:
        g.output.start_line()
        c_names::write_atom_type(g.output, types::Atom.REGION)
        g.output.write("jik_global_region = jik_region_new(0);")
        g.output.end_line()
        backend::emit_region_enter(g, "global")
    end
    // Table dependencies use semantic declaration order; ordinary globals use
    // the retained seed-compatible startup schedule. Both precede the Jik entry.
    startup := operations::BodyContext{translation = g}[.g]
    try emit_table_initializers(startup)
    try emit_global_initializers(startup)
    if has_arguments:
        argument_type := entry.ast.nodes[function.parameters[0]].inferred_type?
        g.output.start_line()
        c_names::write_atom_type(g.output, types::Atom.REGION)
        g.output.write("jik_argument_region = jik_region_new(0);")
        g.output.end_line()
        backend::emit_region_enter(g, "main.arguments")
        g.output.start_line()
        g.output.write("struct ")
        backend::write_vector_name(g, argument_type)
        g.output.write(" *jik_args = ")
        backend::write_vector_name(g, argument_type)
        g.output.write("_new(jik_argument_region, (size_t)argc);")
        g.output.end_line()
        g.output.line("for (int jik_i = 0; jik_i < argc; jik_i++) {")
        g.output.indent()
        g.output.line("jik_args->data[jik_i] = jik_string_new(argv[jik_i], jik_argument_region);")
        g.output.dedent()
        g.output.line("}")
    end
    g.output.start_line()
    needs_cleanup := g.needs_global_region or has_arguments
    g.output.write("int jik_status = " if needs_cleanup else "return ")
    backend::write_name(g, entry.source_id, function.name)
    g.output.write("(jik_args);" if has_arguments else "();")
    g.output.end_line()
    if has_arguments:
        backend::emit_region_free(g, "jik_argument_region")
    end
    if g.needs_global_region:
        backend::emit_region_free(g, "jik_global_region")
    end
    if needs_cleanup:
        g.output.line("return jik_status;")
    end
    g.output.dedent()
    g.output.line("}")
end

/// Return one C translation in r, propagating emission failures.
/// Requires successful semantic analysis and both prepared Program schedules.
/// Copy the integer schedules into the output region, not the modules or ASTs.
throws func generate(program: program::Program, main_source_id: int, foreign options: Options, r: Region) -> String:
    modules := program.modules
    dependency_order := program.dependency_order
    sources := program.sources
    diagnostics := program.diagnostics
    output := writer::new(r)
    g := backend::Translation{output, modules, dependency_order = copy(dependency_order, r), initialization_order = copy(program.initialization_order, r), sources, diagnostics, main_source_id}[r]
    g.emit_source_loc = options.emit_source_loc
    g.region_tree = options.region_tree
    try emit_program(g, options)
    return writer::finish(g.output, r)
end
