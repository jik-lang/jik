//! Load and deduplicate source files with stable IDs and byte-based line indexes.

use "jik/io"
use "jik/path"
use "jik/string"


// Loaded source text and its line index, retained by SourceManager.
struct SourceFile:
    id: int    // Stable zero-based index in SourceManager.sources and Program.modules.
    path: String    // Normalized filesystem path used to deduplicate sources.
    text: String
    // Byte offsets in text; element 0 is 0, later entries follow newline bytes.
    line_starts: Vec[int]
    origin: Origin    // Import root classification; constrains relative imports from this file.
end


variant Origin:
    LOCAL
    STDLIB: String
    PACKAGE: String
end


// Compilation-wide source registry; source IDs remain stable as imports are discovered.
struct SourceManager:
    sources: Vec[SourceFile]    // Discovery order; each SourceFile.id equals its index here.
    source_id_by_path: Dict[int]    // Normalized filesystem path -> index in sources.
    stdlib_path: String    // Installation's jiklib directory, supplied by compiler construction.
    package_path: Option[String]    // Package repository root from JIK_PKG_PATH; None when unset.
end


func _add_line_starts(sf: SourceFile) -> void:
    sf.line_starts.push(0)
    i := 0
    while i < len(sf.text):
        if sf.text[i] == '\n':
            sf.line_starts.push(i + 1)
        end
        i += 1
    end
end


/// Return a stable source ID, reusing a normalized path already loaded.
/// Keep text and line indexes in the manager region; pass source I/O errors to the caller.
throws func add_source(sm: SourceManager, foreign path: String) -> int:
    normalized := path::normalize(path, .sm)
    src_id := sm.source_id_by_path[normalized]
    if src_id is Some:
        return src_id?
    end
    text: String[.sm]
    try loaded := io::read_file(normalized, .sm):
        text = loaded
    except:
        msg := error_msg()
        code := error_code()
        prefix := "io::open: "
        if string::starts_with(msg, prefix):
            msg = must string::slice(msg, len(prefix), len(msg))
        end
        fail(concat("could not read source: ", normalized, ": ", msg), code)
    end
    num_sources := len(sm.sources)
    sm.source_id_by_path[normalized] = num_sources
    sf := SourceFile{
        id = num_sources,
        path = normalized,
        text
    }@
    _add_line_starts(sf)
    sm.sources.push(sf)
    return sf.id
end


// Source range using zero-based byte offsets and an exclusive end.
struct Span:
    source_id: int    // Index in SourceManager.sources.
    start: int    // Inclusive offset in the source file text.
    stop: int    // Exclusive offset in the same text; equals start for an empty range.
end


func line_index(file: SourceFile, offset: int) -> int:
    line := 0
    while line + 1 < len(file.line_starts) and file.line_starts[line + 1] <= offset:
        line += 1
    end
    return line
end


func line_start(file: SourceFile, line: int) -> int:
    return file.line_starts[line]
end


func line_stop(file: SourceFile, line: int) -> int:
    stop := len(file.text)
    if line + 1 < len(file.line_starts):
        stop = file.line_starts[line + 1] - 1
    end
    if stop > file.line_starts[line] and file.text[stop - 1] == '\r':
        stop -= 1
    end
    return stop
end
