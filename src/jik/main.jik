//! Process entry point and final CLI error reporting.

use "jik/io"

use "cli/cli"
use "compiler"


func main(args):
    try status := cli::run(args):
        return status
    except:
        if error_code() != compiler::ERROR_REPORTED:
            command := args[1] if len(args) > 1 else ""
            message := cli::error_message(command, error_msg())
            io::write_stderr(concat("jik error: ", message, "\n"))
        end
        return 1
    end
end
