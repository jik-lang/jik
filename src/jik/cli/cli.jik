//! Dispatch CLI commands and return the selected command status.

use "jik/string"

use "help"
use "check" as check_command
use "tran"
use "run" as run_command
use "build" as build_command
use "version"
use "env"


/// Hide parser implementation details when reporting command-line errors.
/// Other compiler messages pass through unchanged.
func error_message(foreign command: String, foreign message: String, r: Region) -> String:
    if message == "argparse: missing positional input":
        return concat("missing input file; try `jik help ", command, "`", r)
    end
    prefix := "argparse: unexpected positional "
    if string::starts_with(message, prefix):
        argument := must string::slice(message, len(prefix), len(message))
        return concat("unexpected argument: ", argument, r)
    end
    prefix = "argparse: "
    if string::starts_with(message, prefix):
        return must string::slice(message, len(prefix), len(message), r)
    end
    return copy(message, r)
end


throws func run(args: Vec[String]) -> int:
    if len(args) == 1:
        print(help::format_help())
        return 0
    end

    command := args[1]
    if command == "help":
        if len(args) == 2:
            print(help::format_help())
        else:
            try help::run(args[2:])
        end
    elif command == "version":
        try version::run(args[2:])
    elif command == "env":
        try env::run(args[2:])
    elif command == "check":
        if len(args) == 2:
            fail("missing input file; try `jik help check`")
        end
        try check_command::run(args[2:])
    elif command == "tran":
        if len(args) == 2:
            fail("missing input file; try `jik help tran`")
        end
        try tran::run(args[2:])
    elif command == "build":
        if len(args) == 2:
            fail("missing input file; try `jik help build`")
        end
        try build_command::run(args[2:])
    elif command == "run":
        if len(args) == 2:
            fail("missing input file; try `jik help run`")
        end
        status := try run_command::run(args[2:])
        return status
    else:
        fail(concat("unknown command: ", command))
    end
    return 0
end
