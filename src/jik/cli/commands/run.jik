//! Reserve a temporary build workspace, compile, execute, and clean up.

use "jik/argparse" as ap
use "jik/io"
use "jik/path"
use "jik/process"
use "jik/sys"

use "../../compiler"
use "../native_build"
use "../cc_flags"
use "../utils"


func make_parser(r: Region) -> ap::Parser:
    parser := ap::new("jik run", r)
    ap::set_description(parser, "Translate a Jik source code file to C, build it with the selected C compiler, and run the executable.")
    ap::add_positional(parser, "input", "Input file")
    utils::add_compiler_options(parser)
    utils::add_diagnostic_options(parser)
    utils::add_runtime_options(parser)
    return parser
end


throws func execute(comp: compiler::Compiler, foreign cc: String, foreign workspace: String, foreign flags: Vec[String], foreign program_args: Vec[String], release: bool) -> int:
    executable := path::join([copy(workspace), "program.exe"])
    try native_build::compile(comp, cc, executable, flags, release, false)
    compiler::verbose(comp, concat("run ", executable))
    exit_status := try process::run(executable, program_args)
    return exit_status
end


throws func compile_and_execute(foreign input: String, foreign workspace: String, foreign cc: String, foreign flags: Vec[String], foreign program_args: Vec[String], foreign options: ap::ParseResult, release: bool) -> int:
    config := compiler::Config{
        input_path = copy(input),
        output_path = path::join([copy(workspace), "program.c"])
    }
    comp := try compiler::new(config)
    utils::apply_options(comp.config, options)
    status := try execute(comp, cc, workspace, flags, program_args, release)
    return status
end


throws func run(args: Vec[String]) -> int:
    parser := make_parser()
    separator := len(args)
    i := 0
    while i < len(args):
        if args[i] == "--":
            separator = i
            break
        end
        // Option values may themselves be the literal "--".
        if args[i] == "--cc" or args[i] == "--ccflags":
            i += 1
        end
        i += 1
    end
    result := try ap::parse(parser, args[:separator])
    program_args := args[separator + 1:] if separator < len(args) else args[len(args):]
    input := result.positionals["input"]?
    explicit := result.options["--cc"]?["compiler"]? if result.options["--cc"] is Some else ""
    flag_text := result.options["--ccflags"]?["args"]? if result.options["--ccflags"] is Some else ""
    flags := try cc_flags::parse(flag_text, sys::platform() == "windows")
    cc := try utils::select_compiler(explicit)
    workspace := try utils::make_workspace()
    status := 0
    try completed := compile_and_execute(input, workspace, cc, flags, program_args,
        result, result.options["--release"] is Some):
        status = completed
    except:
        msg := error_msg()
        code := error_code()
        try utils::cleanup_workspace(workspace):
        except:
            io::write_stderr(concat("jik: temporary cleanup failed: ", error_msg(), "\n"))
        end
        fail(msg, code)
    end
    try utils::cleanup_workspace(workspace)
    return status
end
