//! Report installation paths, version, and package configuration.

use "jik/argparse" as ap
use "jik/bytes"
use "jik/path"
use "jik/process"
use "jik/string"
use "jik/sys"

use "../../language/native"
use "../utils"
use "../../version"


func make_parser(r: Region) -> ap::Parser:
    parser := ap::new("jik env", r)
    ap::set_description(parser, "Print resolved Jik configuration values as key=value lines.")
    return parser
end


throws func run(args: Vec[String]):
    try ap::parse(make_parser(), args)
    executable := try sys::executable_path()
    root := path::dirname(executable)
    cc := ""
    target := "unknown"
    profile := native::Profile.UNKNOWN
    try selected := utils::select_compiler("", _):
        cc = copy(selected)
        try result := process::capture(cc, ["-dumpmachine"]):
            if result.code == 0:
                output := try bytes::to_string_ascii(result.out)
                errors := try bytes::to_string_ascii(result.err)
                text := string::trim(concat(output, errors))
                if len(text) > 0:
                    target = copy(text)
                    profile = native::normalize_target(target)
                end
            end
        except:
            // Configuration inspection also works with an unavailable compiler.
        end
    except:
        // No discovered compiler is a configuration value, not an env failure.
    end
    package_path := sys::getenv("JIK_PKG_PATH")
    pkg := ""
    if package_path is Some:
        pkg = copy(package_path?)
    end
    println(concat("version=", version::VERSION))
    println(concat("platform=", sys::platform()))
    println(concat("root=", root))
    // The trailing separator matches the seed's installed library path.
    separator := "\\" if sys::platform() == "windows" else "/"
    println(concat("jiklib=", path::join([root, "jiklib"]), separator))
    println(concat("core_include=", path::join([root, "support", "include"])))
    println(concat("pkg_path=", pkg))
    println(concat("cc=", cc))
    println(concat("cc_target=", target))
    println(concat("cc_profile=", native::ProfileNames[profile]))
end
