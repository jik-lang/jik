//! Parse translation options and write C, optionally invoking its formatter.

use "jik/argparse" as ap
use "jik/string"
use "jik/process"

use "../compiler"
use "utils"


func make_parser(r: Region) -> ap::Parser:
    parser := ap::new("jik tran", r)
    ap::set_description(parser, "Translate a Jik source code file to C.")
    ap::add_positional(parser, "input", "Input file")
    opt_out := ap::add_option(parser, "--out", "-o", "Output file (default: beside the input, with a .c suffix)")
    ap::add_option_positional(opt_out, "file", "Output path.")
    ap::add_option(parser, "--dump-ast", "", "Print the parsed AST for each module.")
    ap::add_option(parser, "--embed-core", "", "Embed the installed core.h support library into the generated C.")
    ap::add_option(parser, "--emit-source-loc", "", "Emit source path:line:column comments before generated declarations.")
    ap::add_option(parser, "--format-c", "", "Format the generated C file in place with clang-format. Fails if clang-format is not available.")
    ap::add_option(parser, "--verbose", "", "Print translation and formatting stages to stderr.")
    utils::add_runtime_options(parser)
    return parser
end


throws func run(args: Vec[String]):
    p := make_parser()
    res := try ap::parse(p, args)
    input_file := res.positionals["input"]?
    output_file := res.options["--out"]?["file"]? if res.options["--out"] is Some else ""
    if not (res.options["--out"] is Some):
        stem := must string::slice(input_file, 0, len(input_file) - 4) if string::ends_with(input_file, ".jik") else input_file
        output_file = concat(stem, ".c")
    end
    config := compiler::Config{
        input_path = input_file,
        output_path = output_file,
        embed_core = res.options["--embed-core"] is Some,
        emit_source_loc = res.options["--emit-source-loc"] is Some
    }
    comp := try compiler::new(config)
    utils::apply_options(comp.config, res)
    try comp.run()
    if res.options["--format-c"] is Some:
        compiler::verbose(comp, concat("format output: ", output_file))
        try format_c(output_file)
    end
end


throws func format_c(output_file: String):
    try available := process::capture("clang-format", ["--version"]):
        if available.code != 0:
            fail("clang-format not available")
        end
    except:
        fail("clang-format not available")
    end
    status := 0
    try completed := process::run("clang-format", ["-i", output_file]):
        status = completed
    except:
        fail(concat("clang-format failed: ", error_msg()))
    end
    if status != 0:
        fail(concat("clang-format failed (exit ", string::from_int(status), ")"))
    end
end
