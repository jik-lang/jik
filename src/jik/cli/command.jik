//! Command identities and names shared by CLI dispatch and help.

// Command name and one-line description shown in CLI help.
struct Command:
    name: String
    summary: String
end


COMMANDS := [
    Command{name = "new", summary = "create a new Jik project"},
    Command{name = "tran", summary = "translate Jik source to C"},
    Command{name = "check", summary = "check syntax, types and regions"},
    Command{name = "env", summary = "print resolved Jik configuration"},
    Command{name = "build", summary = "translate and build Jik source to executable"},
    Command{name = "run", summary = "translate, build and run executable"},
    Command{name = "test", summary = "discover, build and run tests in a directory"},
    Command{name = "help", summary = "show help for command or topic"},
    Command{name = "version", summary = "show Jik version"}
]
