use "jik/testing" as test
use "jik/string"

use "support"
use "test_strings"
use "../../src/bootstrap/source"
use "../../src/bootstrap/diag"
use "../../src/bootstrap/lexer/lexer"
use "../../src/bootstrap/lexer/token"
use "../../src/bootstrap/lexer/string_literal"
use "../../src/bootstrap/semantic/resolution/identifier"


func test_whitespace_comment_spans(ts) -> void:
    file := source::SourceFile{id = 17, text = " \t\r//x\r\nfoo_2\t:= 42//tail\r\n\r\nbar"}
    diagnostics := diag::Diagnostics{}[.file]
    scanned := lexer::tokenize(file, diagnostics)
    kinds := [token::TokenType.NEWLINE, token::TokenType.IDENTIFIER, token::TokenType.DECLARE,
        token::TokenType.INTEGER, token::TokenType.NEWLINE, token::TokenType.NEWLINE,
        token::TokenType.IDENTIFIER, token::TokenType.EOF]
    starts := [7, 8, 14, 17, 26, 28, 29, 32]
    stops := [8, 13, 16, 19, 27, 29, 32, 32]
    test::suite_assert(ts, diagnostics.error_count == 0 and len(scanned) == len(kinds), site())
    if len(scanned) != len(kinds):
        return
    end
    for index, item in scanned:
        test::suite_assert(ts, item.type == kinds[index], site())
        test::suite_assert(ts, item.span.source_id == 17 and item.span.start == starts[index] and item.span.stop == stops[index], site())
    end
end


func test_eof_and_comments(ts) -> void:
    endings := ["", " \t\r", "// trailing comment", "// UTF8: Ž😀", "// quote: '\" $ \\", "// comment\r"]
    for ending in endings:
        file := source::SourceFile{text = ending}
        diagnostics := diag::Diagnostics{}[.file]
        scanned := lexer::tokenize(file, diagnostics)
        test::suite_assert(ts, diagnostics.error_count == 0 and len(scanned) == 1, site())
        test::suite_assert(ts, scanned[0].type == token::TokenType.EOF and scanned[0].span.start == len(ending) and scanned[0].span.stop == len(ending), site())
        scanner := lexer::new(file)
        first := scanner.next_token(diagnostics)
        again := scanner.next_token(diagnostics)
        test::suite_assert(ts, first.type == token::TokenType.EOF and again.type == token::TokenType.EOF and scanner.pos == len(ending), site())
    end
    parsed := support::parse_source("func main():\r\n\t// ignored\r\n\tprintln(\"// text\") // trailing\r\nend//EOF")
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    test::suite_assert(ts, len(parsed.ast.get_root_module().declarations) == 1, site())
    significant := support::parse_source("func main():\n    value := 1 value = 2\nend\n")
    test::suite_assert(ts, significant.diagnostics.error_count > 0, site())
end


func test_ascii_identifiers(ts) -> void:
    for value = 0, 256:
        byte := string_literal::byte_from_value(value)
        letter := (value >= 65 and value <= 90) or (value >= 97 and value <= 122)
        start := letter or value == 95
        tail := start or (value >= 48 and value <= 57)
        test::suite_assert(ts, lexer::is_identifier_start(byte) == start, site())
        test::suite_assert(ts, lexer::valid_identifier_char(byte) == tail, site())
    end
    names := "_ _value __value _Value value_2 IF True vec dictionary optional foreigner throws_"
    file := source::SourceFile{text = names}
    diagnostics := diag::Diagnostics{}[.file]
    scanned := lexer::tokenize(file, diagnostics)
    test::suite_assert(ts, diagnostics.error_count == 0 and len(scanned) == 13, site())
    test::suite_assert(ts, scanned[0].type == token::TokenType.UNDERSCORE, site())
    for index = 1, len(scanned) - 1:
        test::suite_assert(ts, scanned[index].type == token::TokenType.IDENTIFIER, site())
    end
end


func test_reserved_words(ts) -> void:
    // This list comes from the seed keyword classifier. Future feature words
    // stay reserved even before their statements have bootstrap implementations.
    words := ["func", "throws", "must", "try", "except", "end", "struct", "enum", "table", "variant",
        "if", "elif", "else", "while", "for", "break", "continue", "return", "use", "as", "extern", "init",
        "true", "false", "of", "and", "or", "not", "is", "Vec", "Dict", "Option", "Some", "None", "in",
        "match", "case", "other", "foreign", "_"]
    for word in words:
        file := source::SourceFile{text = concat(word, " ", word, "suffix")}
        diagnostics := diag::Diagnostics{}[.file]
        scanned := lexer::tokenize(file, diagnostics)
        test::suite_assert(ts, diagnostics.error_count == 0 and len(scanned) == 3, site())
        test::suite_assert(ts, scanned[0].type != token::TokenType.IDENTIFIER and scanned[0].type != token::TokenType.ERROR, site())
        test::suite_assert(ts, scanned[1].type == token::TokenType.IDENTIFIER, site())
        test::suite_assert(ts, token::TokenTypeNames[scanned[0].type] == word, site())
    end
end


func test_recovery(ts) -> void:
    inputs := ["$;`\nfunc valid():\nend", "\"unterminated\nfunc valid():\nend",
        "\"escape\\\nfunc valid():\nend", "'\\q'\nfunc valid():\nend", "'\nfunc valid():\nend"]
    for text in inputs:
        parsed := support::parse_source(text)
        test::suite_assert(ts, parsed.diagnostics.error_count > 0, site())
        test::suite_assert(ts, len(parsed.ast.get_root_module().declarations) == 1, site())
        last_stop := 0
        file := source::SourceFile{text}
        diagnostics := diag::Diagnostics{}[.file]
        scanned := lexer::tokenize(file, diagnostics)
        for item in scanned:
            test::suite_assert(ts, item.span.start >= last_stop and item.span.stop >= item.span.start and item.span.stop <= len(text), site())
            if item.type != token::TokenType.EOF:
                test::suite_assert(ts, item.span.stop > item.span.start, site())
            end
            last_stop = item.span.stop
        end
    end
end


func test_reserved_declarations(ts) -> void:
    test_strings::check_error(ts, "func jik_hidden():\nend\n", "reserved identifier prefix")
    test_strings::check_error(ts, "func f(size_t: int):\nend\n", "reserved identifier")
    test_strings::check_error(ts, "struct Box:\n    NULL: int\nend\n", "reserved identifier")
    test_strings::check_error(ts, "variant V:\n    JikValue: int\nend\n", "reserved identifier prefix")
    good := support::resolve_source("enum E:\n    NULL\n    jik_value\nend\nvariant V:\n    EOF\n    VALUE: int\nend\nfunc size_t() -> int:\n    _value := 1\n    return _value\nend\n")
    test::suite_assert(ts, good.diagnostics.error_count == 0, site())
    test::suite_assert(ts, identifier::c_reserved("__value") and identifier::c_reserved("_Value"), site())
    test::suite_assert(ts, not identifier::c_reserved("_value") and not identifier::reserved_prefix("jik"), site())
end


func run_tests(ts) -> void:
    println("[test] test_lexical_rules")
    test_whitespace_comment_spans(ts)
    test_eof_and_comments(ts)
    test_ascii_identifiers(ts)
    test_reserved_words(ts)
    test_recovery(ts)
    test_reserved_declarations(ts)
end
