use "jik/testing" as test
use "jik/string"

use "support"
use "../../src/bootstrap/lexer/lexer"
use "../../src/bootstrap/lexer/token"
use "../../src/bootstrap/source"
use "../../src/bootstrap/diag"
use "../../src/bootstrap/parser/ast"
use "../../src/bootstrap/semantic/typing/typecheck"


func test_tokens(ts) -> void:
    file := source::SourceFile{text = "+= -= *= /= %= + - * / % = -> // comment\n"}
    diagnostics := diag::Diagnostics{}[.file]
    tokens := lexer::tokenize(file, diagnostics)
    expected := [token::TokenType.OP_PLUS_EQ, token::TokenType.OP_MINUS_EQ,
        token::TokenType.OP_TIMES_EQ, token::TokenType.OP_DIV_EQ, token::TokenType.OP_MOD_EQ,
        token::TokenType.OP_PLUS, token::TokenType.OP_MINUS, token::TokenType.OP_TIMES,
        token::TokenType.OP_DIV, token::TokenType.OP_MOD, token::TokenType.ASSIGN,
        token::TokenType.ARROW, token::TokenType.NEWLINE, token::TokenType.EOF]
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    test::suite_assert(ts, len(tokens) == len(expected), site())
    if len(tokens) != len(expected):
        return
    end
    spellings := ["+=", "-=", "*=", "/=", "%="]
    for index, kind in expected:
        test::suite_assert(ts, tokens[index].type == kind, site())
        if index < len(spellings):
            test::suite_assert(ts, tokens[index].span.start == index * 3, site())
            test::suite_assert(ts, tokens[index].span.stop == index * 3 + 2, site())
            test::suite_assert(ts, token::TokenTypeNames[kind] == spellings[index], site())
        end
    end
end


func test_lowering_and_spans(ts) -> void:
    text := "func main():\n    value := 10\n    value+=2+3*4\n    value-=2\n    value*=3\n    value/=2// comment\n    value%=9\n    value=42\n    return value\nend\n"
    parsed := support::parse_source(text)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    if parsed.diagnostics.error_count > 0:
        return
    end
    root := parsed.ast.get_root_module()
    body := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL.body
    operations := [ast::BinaryOp.PLUS, ast::BinaryOp.MINUS, ast::BinaryOp.TIMES, ast::BinaryOp.DIV, ast::BinaryOp.MOD]
    spellings := ["value+=2+3*4", "value-=2", "value*=3", "value/=2", "value%=9"]
    for index, op in operations:
        node := parsed.ast.nodes[body.statements[index + 1]]
        test::suite_assert(ts, node.kind is ASSIGN, site())
        if not (node.kind is ASSIGN):
            continue
        end
        statement := node.kind.ASSIGN
        test::suite_assert(ts, statement.compound, site())
        value := parsed.ast.nodes[statement.value]
        test::suite_assert(ts, value.kind is BINARY, site())
        if not (value.kind is BINARY):
            continue
        end
        binary := value.kind.BINARY
        test::suite_assert(ts, binary.op == op and binary.left == statement.target, site())
        test::suite_assert(ts, parsed.ast.nodes[statement.target].kind.IDENTIFIER_EXPR.name == "value", site())
        test::suite_assert(ts, must string::slice(text, node.span.start, node.span.stop) == spellings[index], site())
        test::suite_assert(ts, value.span.start == node.span.start and value.span.stop == node.span.stop, site())
        if index == 0:
            rhs := parsed.ast.nodes[binary.right].kind.BINARY
            test::suite_assert(ts, rhs.op == ast::BinaryOp.PLUS, site())
            test::suite_assert(ts, parsed.ast.nodes[rhs.right].kind.BINARY.op == ast::BinaryOp.TIMES, site())
        end
    end
    ordinary := parsed.ast.nodes[body.statements[6]].kind.ASSIGN
    test::suite_assert(ts, not ordinary.compound, site())
    test::suite_assert(ts, parsed.ast.nodes[ordinary.value].kind is INTEGER_LITERAL, site())
end


func test_composite_targets(ts) -> void:
    text := "struct Box:\n    value: int\nend\nfunc main():\n    box := Box{value=10}\n    values := [20]\n    box.value += 2\n    values[0] *= 3\nend\n"
    comp := support::infer_source(text, 0)
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    body := mod.ast.nodes[root.declarations[1]].kind.FUNCTION_DECL.body
    for index = 2, 4:
        statement := mod.ast.nodes[body.statements[index]].kind.ASSIGN
        binary := mod.ast.nodes[statement.value].kind.BINARY
        target := mod.ast.nodes[statement.target]
        test::suite_assert(ts, statement.compound and binary.left == statement.target, site())
        test::suite_assert(ts, target.inferred_type? == mod.ast.nodes[statement.value].inferred_type?, site())
        if index == 2:
            test::suite_assert(ts, target.kind is FIELD, site())
        else:
            test::suite_assert(ts, target.kind is INDEX and target.kind.INDEX.is_store, site())
        end
    end
    operators := ["+=", "-=", "*=", "/=", "%="]
    for op in operators:
        parsed := support::parse_source(concat("func main():\n    values := [1]\n    values[0] ", op, "\n    return 0\nend\n"))
        test::suite_assert(ts, parsed.diagnostics.error_count == 1, site())
        recovered := parsed.ast.get_root_module()
        test::suite_assert(ts, len(recovered.declarations) == 1, site())
        if len(recovered.declarations) == 1:
            statements := parsed.ast.nodes[recovered.declarations[0]].kind.FUNCTION_DECL.body.statements
            test::suite_assert(ts, len(statements) == 2 and parsed.ast.nodes[statements[1]].kind is RETURN, site())
        end
    end
end


func test_inference_and_codegen(ts) -> void:
    text := "func increase(value):\n    value += 2\n    return value\nend\nfunc scale(value) -> double:\n    value *= 2\n    return value\nend\nfunc main():\n    count: int\n    count += increase(19)\n    while count < 42:\n        count += 21\n    end\n    return count\nend\n"
    comp := support::infer_source(text, 0)
    support::check_signature(ts, comp, "increase", "func(int) -> int")
    support::check_signature(ts, comp, "scale", "func(double) -> double")
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    translation := must support::translate(text, "")
    test::suite_assert(ts, string::find(translation, "jik_v_count = (jik_v_count + jik_m0_increase(19));") >= 0, site())
    test::suite_assert(ts, string::find(translation, "jik_v_value = (jik_v_value * 2);") >= 0, site())
    loop := support::infer_source("func main():\n    total := 0\n    for index = 0, 5:\n        index += 1\n        total += index\n    end\n    return total\nend\n", 0)
    typecheck::run(loop)
    test::suite_assert(ts, loop.diagnostics.error_count == 0, site())
end


func check_error(ts, foreign text: String, foreign summary: String) -> void:
    comp := support::infer_source(text, 0)
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
    if len(comp.diagnostics.messages) != 1:
        return
    end
    message := comp.diagnostics.messages[0]
    if message.summary != summary:
        println(concat("expected: ", summary, "; got: ", message.summary, "\n", text))
    end
    test::suite_assert(ts, message.summary == summary, site())
    test::suite_assert(ts, message.span is Some, site())
    if message.span is Some:
        test::suite_assert(ts, message.span?.stop > message.span?.start, site())
    end
end


func test_invalid_operands_and_targets(ts) -> void:
    operators := ["+=", "-=", "*=", "/=", "%="]
    for op in operators:
        summary := "type inference conflict" if op == "%=" else "invalid numeric operands"
        check_error(ts, concat("func main():\n    value := true\n    value ", op, " false\n    return 0\nend\n"), summary)
        check_error(ts, concat("func main():\n    missing ", op, " 2\n    return 0\nend\n"), "semantic analysis")
    end
    check_error(ts, "func main():\n    value := 1\n    value += 2.5\n    return 0\nend\n", "type inference conflict")
    check_error(ts, "func main():\n    value := 3.5\n    value %= 2\n    return 0\nend\n", "type inference conflict")
    check_error(ts, "func main():\n    value += 2\n    value := 1\n    return 0\nend\n", "semantic analysis")
    check_error(ts, "func empty():\nend\nfunc main():\n    value := 1\n    value -= empty()\n    return 0\nend\n", "type inference conflict")
    check_error(ts, "func change(value: char):\n    value += value\nend\nfunc main():\n    return 0\nend\n", "invalid numeric operands")
end


func test_recovery(ts) -> void:
    operators := ["+=", "-=", "*=", "/=", "%="]
    for op in operators:
        parsed := support::parse_source(concat("func main():\n    value := 1\n    value ", op, "\n    return value\nend\nfunc next():\n    return 0\nend\n"))
        test::suite_assert(ts, parsed.diagnostics.error_count == 1, site())
        root := parsed.ast.get_root_module()
        test::suite_assert(ts, len(root.declarations) == 2, site())
        if len(root.declarations) != 2:
            continue
        end
        body := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL.body
        test::suite_assert(ts, len(body.statements) == 2, site())
        if len(body.statements) == 2:
            test::suite_assert(ts, parsed.ast.nodes[body.statements[1]].kind is RETURN, site())
        end
    end
end


func run_tests(ts) -> void:
    println("[test] test_compound_assignments")
    test_tokens(ts)
    test_lowering_and_spans(ts)
    test_inference_and_codegen(ts)
    test_composite_targets(ts)
    test_invalid_operands_and_targets(ts)
    test_recovery(ts)
end
