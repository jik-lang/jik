use "jik/testing" as test

use "../../src/bootstrap/modules/module_loader"
use "../../src/bootstrap/diag"
use "../../src/bootstrap/source"
use "../../src/bootstrap/lexer/lexer"
use "../../src/bootstrap/parser/parser"
use "../../src/bootstrap/parser/ast"


func check_alias_collision(ts, foreign input_path: String, foreign alias: String) -> void:
    sources := source::SourceManager{}
    diagnostics := diag::Diagnostics{}
    id := must sources.add_source(input_path)
    file := sources.sources[id]
    tokens := lexer::tokenize(file, diagnostics)
    tree := parser::parse(file, tokens, diagnostics)
    test::suite_assert(ts, diagnostics.error_count == 0, site())

    module_loader::resolve_imports(sources, tree, diagnostics, file)
    test::suite_assert(ts, diagnostics.error_count == 1, site())
    test::suite_assert(ts, len(diagnostics.messages) == 1, site())
    if len(diagnostics.messages) != 1:
        return
    end
    message := diagnostics.messages[0]
    test::suite_assert(ts, message.summary == concat("duplicate import alias: ", alias), site())
    test::suite_assert(ts, message.span is Some, site())
    if message.span is Some:
        second_import := tree.nodes[tree.get_root_module().imports[1]]
        test::suite_assert(ts, message.span?.source_id == file.id, site())
        test::suite_assert(ts, message.span?.start == second_import.span.start, site())
        test::suite_assert(ts, message.span?.stop == second_import.span.stop, site())
    end
end


func test_effective_alias(ts) -> void:
    implicit := ast::Import{path = "first/../first/helper"}
    explicit := ast::Import{path = "first/helper", alias = Some{"utility"}}
    test::suite_assert(ts, ast::effective_alias(implicit) == "helper", site())
    test::suite_assert(ts, ast::effective_alias(explicit) == "utility", site())
    test::suite_assert(ts, implicit.alias is None, site())
    test::suite_assert(ts, explicit.alias is Some, site())
end


func test_aliases_are_module_local(ts) -> void:
    sources := source::SourceManager{}
    diagnostics := diag::Diagnostics{}
    input_paths := ["test/bootstrap/input/import_aliases/scopes/left.jik", "test/bootstrap/input/import_aliases/scopes/right.jik"]
    for input_path in input_paths:
        id := must sources.add_source(input_path)
        file := sources.sources[id]
        tokens := lexer::tokenize(file, diagnostics)
        tree := parser::parse(file, tokens, diagnostics)
        imports := module_loader::resolve_imports(sources, tree, diagnostics, file)
        test::suite_assert(ts, len(imports) == 1, site())
    end
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    test::suite_assert(ts, len(sources.sources) == 4, site())
end


func run_tests(ts) -> void:
    println("[test] test_import_aliases")
    test_effective_alias(ts)
    check_alias_collision(ts, "test/bootstrap/input/import_aliases/implicit_collision.jik", "helper")
    check_alias_collision(ts, "test/bootstrap/input/import_aliases/explicit_collision.jik", "utility")
    check_alias_collision(ts, "test/bootstrap/input/import_aliases/implicit_explicit_collision.jik", "helper")
    check_alias_collision(ts, "test/bootstrap/input/import_aliases/explicit_implicit_collision.jik", "helper")
    test_aliases_are_module_local(ts)
end
