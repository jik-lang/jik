use "jik/testing" as test
use "jik/string"

use "../../src/bootstrap/program"
use "support"
use "../../src/bootstrap/source"
use "../../src/bootstrap/diag"
use "../../src/bootstrap/lexer/lexer"
use "../../src/bootstrap/lexer/token"
use "../../src/bootstrap/parser/parser"
use "../../src/bootstrap/parser/ast"
use "../../src/bootstrap/semantic/regions/regions"
use "../../src/bootstrap/language/region_source"
use "../../src/bootstrap/semantic/typing/typecheck"


func analyze(foreign text: String, r: Region) -> program::Program:
    comp := support::infer_source(text, -1, r)
    typecheck::run(comp)
    regions::run(comp)
    return comp
end


func test_decoded_tokens(ts) -> void:
    text := "\"quote:\\\" slash:\\\\ apostrophe:\\' tabs:\\t lines:\\n\\r hex:\\x41F UTF8:Ž😀\""
    expected := "quote:\" slash:\\ apostrophe:' tabs:\t lines:\n\r hex:AF UTF8:Ž😀"
    file := source::SourceFile{text}
    diagnostics := diag::Diagnostics{}[.file]
    tokens := lexer::tokenize(file, diagnostics)
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    test::suite_assert(ts, len(tokens) == 2, site())
    if len(tokens) != 2:
        return
    end
    test::suite_assert(ts, tokens[0].type == token::TokenType.STRING, site())
    test::suite_assert(ts, tokens[0].text is Some, site())
    if tokens[0].text is Some:
        test::suite_assert(ts, tokens[0].text? == expected, site())
    end
    test::suite_assert(ts, tokens[0].span.start == 0 and tokens[0].span.stop == len(text), site())

    multiline_text := "\"\"\"line one\r\nline two\\n Ž😀 \"quote\" \n\"\"\"\n42"
    multiline := source::SourceFile{text = multiline_text}
    errors := diag::Diagnostics{}[.multiline]
    scanned := lexer::tokenize(multiline, errors)
    test::suite_assert(ts, errors.error_count == 0, site())
    test::suite_assert(ts, len(scanned) == 4, site())
    if len(scanned) != 4:
        return
    end
    content := "line one\r\nline two\\n Ž😀 \"quote\" \n"
    test::suite_assert(ts, scanned[0].type == token::TokenType.STRING_MULTILINE, site())
    test::suite_assert(ts, scanned[0].text is Some, site())
    if scanned[0].text is Some:
        test::suite_assert(ts, scanned[0].text? == content, site())
    end
    test::suite_assert(ts, scanned[0].span.stop == len(content) + 6, site())
    test::suite_assert(ts, scanned[1].type == token::TokenType.NEWLINE, site())
    test::suite_assert(ts, scanned[2].type == token::TokenType.INTEGER, site())
    test::suite_assert(ts, scanned[2].span.start == scanned[0].span.stop + 1, site())
end


func test_literal_spans_and_defaults(ts) -> void:
    text := "func label(r: Region) -> String:\n    return \"label\"[r]\nend\nfunc empty(r: Region) -> String:\n    value: String[r]\n    return value\nend\n"
    file := source::SourceFile{text}
    diagnostics := diag::Diagnostics{}[.file]
    tokens := lexer::tokenize(file, diagnostics)
    tree := parser::parse(file, tokens, diagnostics)
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    if diagnostics.error_count > 0:
        return
    end
    for tok in tokens:
        if tok.type == token::TokenType.STRING:
            test::suite_assert(ts, must string::slice(text, tok.span.start, tok.span.stop) == "\"label\"", site())
        end
    end
    root := tree.get_root_module()
    function := tree.nodes[root.declarations[0]].kind.FUNCTION_DECL
    returned := tree.nodes[function.body.statements[0]].kind.RETURN.value
    test::suite_assert(ts, returned is Some, site())
    if returned is Some:
        value := tree.nodes[returned?]
        test::suite_assert(ts, value.kind is STRING_LITERAL, site())
        test::suite_assert(ts, must string::slice(text, value.span.start, value.span.stop) == "\"label\"[r]", site())
    end
    default_function := tree.nodes[root.declarations[1]].kind.FUNCTION_DECL
    declaration := tree.nodes[default_function.body.statements[0]].kind.LOCAL_DECL
    test::suite_assert(ts, declaration.initializer is Some, site())
    if declaration.initializer is Some:
        default_value := tree.nodes[declaration.initializer?].kind.STRING_LITERAL
        test::suite_assert(ts, default_value.value == "" and default_value.destination is Some, site())
    end
end


func test_caller_owned_construction(ts) -> void:
    text := "func explicit(r: Region) -> String:\n    return \"explicit\"[r]\nend\nfunc direct(r: Region) -> String:\n    return \"direct\"\nend\nfunc implicit(r: Region) -> String:\n    value := \"implicit\"@\n    return value\nend\nfunc owner(value: String) -> String:\n    return \"owner\"[.value]\nend\nfunc empty(r: Region) -> String:\n    value: String[r]\n    return value\nend\nfunc borrowed(value: String) -> String:\n    copied := value\n    return (copied)\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    for id in root.declarations:
        function := mod.ast.nodes[id].kind.FUNCTION_DECL
        test::suite_assert(ts, not function.needs_local_region and not function.is_region_safe, site())
        statement := mod.ast.nodes[function.body.statements[len(function.body.statements) - 1]].kind.RETURN
        test::suite_assert(ts, statement.value is Some, site())
        if statement.value is Some:
            value := mod.ast.nodes[statement.value?]
            test::suite_assert(ts, value.region_source.kind == region_source::Kind.CALLER, site())
        end
    end
    // Reanalysis must reset and then reconstruct literal destinations and flags.
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    for id in root.declarations:
        test::suite_assert(ts, not mod.ast.nodes[id].kind.FUNCTION_DECL.needs_local_region, site())
    end
end


func test_call_contracts_and_safety(ts) -> void:
    text := "func keep(value: String, r: Region) -> String:\n    return value\nend\nfunc relay(r: Region) -> String:\n    return keep(\"payload\", r)\nend\nfunc first(value: String, r: Region, remaining: int) -> int:\n    if remaining == 0:\n        return 0\n    end\n    return second(value, r, remaining - 1)\nend\nfunc second(value: String, r: Region, remaining: int) -> int:\n    keep(value, r)\n    return first(value, r, remaining)\nend\nfunc equal(left: String, right: String) -> bool:\n    return left == right\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    for index = 0, 4:
        test::suite_assert(ts, not mod.ast.nodes[root.declarations[index]].kind.FUNCTION_DECL.is_region_safe, site())
    end
    test::suite_assert(ts, mod.ast.nodes[root.declarations[4]].kind.FUNCTION_DECL.is_region_safe, site())
    relay := mod.ast.nodes[root.declarations[1]].kind.FUNCTION_DECL
    call_id := mod.ast.nodes[relay.body.statements[0]].kind.RETURN.value?
    call := mod.ast.nodes[call_id].kind.CALL
    literal := mod.ast.nodes[call.arguments[0]]
    test::suite_assert(ts, literal.region_source.kind == region_source::Kind.CALLER, site())
    test::suite_assert(ts, literal.allocation_target is Some, site())
    test::suite_assert(ts, not relay.needs_local_region, site())
end


func test_emission_and_cleanup(ts) -> void:
    text := "func produce(r: Region) -> String:\n    scratch := \"scratch\"\n    result := \"Ž\"[r]\n    return result\nend\nfunc main():\n    value := produce()\n    if value != \"Ž\":\n        return 1\n    end\n    return 42\nend\n"
    translation := must support::translate(text, "")
    test::suite_assert(ts, string::find(translation, "jik_string_new(\"\\305\\275\", jik_v_r)") >= 0, site())
    test::suite_assert(ts, string::find(translation, "jik_string_cmp(jik_v_value,") >= 0, site())
    result := string::find(translation, "JikString * jik_return_value = jik_v_result;")
    cleanup := string::find(translation, "jik_region_free(jik_local_region);")
    returned := string::find(translation, "return jik_return_value;")
    test::suite_assert(ts, result >= 0 and cleanup > result and returned > cleanup, site())
end


func check_error(ts, foreign text: String, foreign expected: String) -> void:
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
    if len(comp.diagnostics.messages) != 1:
        return
    end
    message := comp.diagnostics.messages[0]
    test::suite_assert(ts, message.summary == expected, site())
    test::suite_assert(ts, message.span is Some, site())
end


func test_invalid_regions(ts) -> void:
    check_error(ts, "func bad(r: Region) -> String:\n    value := \"local\"\n    return value\nend\n", "cannot return local allocation")
    check_error(ts, "func bad() -> String:\n    return \"local\"\nend\n", "cannot return local allocation")
    check_error(ts, "func bad(r: Region) -> String:\n    return (\"local\")\nend\n", "cannot return local allocation")
    check_error(ts, "func bad(value: String):\n    value = \"local\"\nend\n", "region mismatch")
    check_error(ts, "func bad(r: Region):\n    value := \"local\"\n    value = \"caller\"[r]\nend\n", "region mismatch")
    check_error(ts, "func bad(value: String, r: Region) -> String:\n    local := \"local\"\n    return local if true else value\nend\n", "region mismatch")
    check_error(ts, "func keep(value: String, r: Region) -> String:\n    return value\nend\nfunc bad(r: Region):\n    local := \"local\"\n    keep(local, r)\nend\n", "region mismatch")
    check_error(ts, "func bad(left: Region, right: Region) -> int:\n    value := \"invalid\"@\n    return 0\nend\n", "invalid implicit allocation")
    check_error(ts, "func bad():\n    value := \"invalid\"@\nend\n", "invalid implicit allocation")
    check_error(ts, "func bad():\n    primitive := 1\n    value := \"invalid\"[primitive]\nend\n", "invalid allocation destination")
    check_error(ts, "func bad():\n    primitive := 1\n    value := \"invalid\"[.primitive]\nend\n", "invalid region target")
    check_error(ts, "func bad():\n    value := \"invalid\"[missing]\nend\n", "semantic analysis")
end


func test_invalid_lexing_and_recovery(ts) -> void:
    invalid := ["\"bad\\q\"", "\"bad\\0\"", "\"bad\\x00\"", "\"bad\\x1\"", "\"bad\\xGG\"", "\"unterminated", "\"line\nbreak\"", "\"\"\"unterminated"]
    for text in invalid:
        file := source::SourceFile{text}
        diagnostics := diag::Diagnostics{}[.file]
        lexer::tokenize(file, diagnostics)
        test::suite_assert(ts, diagnostics.error_count > 0, site())
    end
    parsed := support::parse_source("func main():\n    value := \"invalid\"[_]\n    return 42\nend\nfunc next():\n    return 0\nend\n")
    test::suite_assert(ts, parsed.diagnostics.error_count == 1, site())
    root := parsed.ast.get_root_module()
    test::suite_assert(ts, len(root.declarations) == 2, site())
    if len(root.declarations) == 2:
        function := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL
        test::suite_assert(ts, len(function.body.statements) == 1, site())
        if len(function.body.statements) == 1:
            test::suite_assert(ts, parsed.ast.nodes[function.body.statements[0]].kind is RETURN, site())
        end
    end
    check_error(ts, "func bad(r: Region):\n    value: String[r] = \"invalid\"\nend\n", "allocation suffix belongs on initializer")
end


func run_tests(ts) -> void:
    println("[test] test_strings")
    test_decoded_tokens(ts)
    test_literal_spans_and_defaults(ts)
    test_caller_owned_construction(ts)
    test_call_contracts_and_safety(ts)
    test_emission_and_cleanup(ts)
    test_invalid_regions(ts)
    test_invalid_lexing_and_recovery(ts)
end
