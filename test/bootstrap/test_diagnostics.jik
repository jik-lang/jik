use "jik/string"
use "jik/testing" as test

use "../../src/bootstrap/diag"
use "../../src/bootstrap/source"


func format_at(foreign text: String, offset: int, r: Region) -> String:
    sources := source::SourceManager{}[r]
    file := source::SourceFile{id = 0, path = "diagnostic.jik", text = copy(text, r)}[r]
    source::_add_line_starts(file)
    sources.sources.push(file)
    diagnostics := diag::Diagnostics{}[r]
    span := source::Span{source_id = 0, start = offset, stop = offset}[r]
    diag::error(diagnostics, "example", "detail", Some{span})
    return diag::format_all(diagnostics, sources, r)
end


func test_empty_input(ts) -> void:
    formatted := format_at("", 0, _)
    test::suite_assert(ts, string::find(formatted, "diagnostic.jik:1:1\n") >= 0, site())
    test::suite_assert(ts, string::find(formatted, "1 |\n  |^\n") >= 0, site())
end


func test_line_endings_and_eof(ts) -> void:
    lf := format_at("first\nsecond\n", 6, _)
    test::suite_assert(ts, string::find(lf, "diagnostic.jik:2:1\n") >= 0, site())
    test::suite_assert(ts, string::find(lf, "2 |second\n") >= 0, site())
    crlf := format_at("first\r\nsecond\r\n", 8, _)
    test::suite_assert(ts, string::find(crlf, "diagnostic.jik:2:2\n") >= 0, site())
    test::suite_assert(ts, string::find(crlf, "\r") == -1, site())
    test::suite_assert(ts, string::find(crlf, "2 |second\n  | ^\n") >= 0, site())
    eof := format_at("first\nsecond", 12, _)
    test::suite_assert(ts, string::find(eof, "diagnostic.jik:2:7\n") >= 0, site())
    test::suite_assert(ts, string::find(eof, "  |      ^\n") >= 0, site())
    trailing_eof := format_at("first\r\nsecond\r\n", 15, _)
    test::suite_assert(ts, string::find(trailing_eof, "diagnostic.jik:3:1\n") >= 0, site())
    test::suite_assert(ts, string::find(trailing_eof, "3 |\n  |^\n") >= 0, site())
end


func test_tab_alignment(ts) -> void:
    formatted := format_at("\tvalue\n", 1, _)
    test::suite_assert(ts, string::find(formatted, "diagnostic.jik:1:2\n") >= 0, site())
    test::suite_assert(ts, string::find(formatted, "1 |\tvalue\n  |\t^\n") >= 0, site())
end


func test_messages_without_sources(ts) -> void:
    sources := source::SourceManager{}
    diagnostics := diag::Diagnostics{}
    diag::error(diagnostics, "first", "a path", None)
    diag::error(diagnostics, "second", "", None)
    formatted := diag::format_all(diagnostics, sources)
    test::suite_assert(ts, formatted == "jik error: first\n    a path\njik error: second\n", site())
end


func run_tests(ts) -> void:
    println("[test] test_diagnostics")
    test_empty_input(ts)
    test_line_endings_and_eof(ts)
    test_tab_alignment(ts)
    test_messages_without_sources(ts)
end
