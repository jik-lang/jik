use "jik/string"
use "jik/testing" as test

use "../../src/bootstrap/compiler"
use "../../src/bootstrap/diag"


func check_compile_error(ts, foreign input_path: String, foreign expected: String, expected_count: int) -> void:
    config := compiler::Config{input_path = copy(input_path)}
    comp := must compiler::new(config)
    try compiler::translate(comp):
        test::suite_assert(ts, false, site())
    except:
        msg := error_msg()
        code := error_code()
        test::suite_assert(ts, comp.program.diagnostics.error_count == expected_count, site())
        test::suite_assert(ts, code != compiler::ERROR_REPORTED, site())
        formatted := diag::format_all(comp.program.diagnostics, comp.program.sources)
        text := msg if expected_count == 0 else formatted
        test::suite_assert(ts, string::find(text, expected) >= 0, site())
    end
end


func run_tests(ts) -> void:
    println("[test] test_compiler_errors")
    check_compile_error(ts, "test/bootstrap/input/printing/invalid/region.jik", "unsupported print type", 1)
