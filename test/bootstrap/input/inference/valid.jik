use "helper" as h

func main() -> int:
    choice := h::pass(1 < 2)
    if choice:
        return count(5) + 37
    end
    return 0
end

func count(n):
    if n < 1:
        return 0
    end
    return 1 + count(n - 1)
end

func widen(value: double) -> double:
    result := value + 1
    return result
end

func letter(value: char) -> char:
    return value
end

func stop() -> void:
    return
end
