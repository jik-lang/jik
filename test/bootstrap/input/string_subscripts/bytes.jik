func main():
    text := "AŽ😀Z"
    if len(text) != 8 or text[0] != text[:1][0] or text[7] != text[7:][0]:
        return 1
    end
    if text[1:3] != "Ž" or text[3:7] != "😀":
        return 2
    end
    println(text[0], ":", text[1:3], ":", text[3:7], ":", text[7])
    raw := "\xFF\x80A"
    if raw[0] != raw[:1][0] or raw[1] != raw[1:2][0]:
        return 3
    end
    if raw[:1] != "\xFF" or raw[1:2] != "\x80":
        return 4
    end
    return 42
end
