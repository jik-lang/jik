func tick(counts: Vec[int], index: int, value: int) -> int:
    counts[index] = counts[index] + 1
    return value
end

func pair(first: int, second: int) -> int:
    return first * 10 + second
end

func stamp(trace: Vec[int], value: int) -> int:
    push(trace, value)
    return len(trace)
end

func receiver(counts: Vec[int], values: Vec[int]) -> Vec[int]:
    counts[0] = counts[0] + 1
    return values
end

func main():
    trace: Vec[int]
    order := pair(stamp(trace, 1), stamp(trace, 2))
    // Both argument orders are valid. Each call must finish exactly once.
    if len(trace) != 2 or not ((order == 12 and trace[0] == 1 and trace[1] == 2) or (order == 21 and trace[0] == 2 and trace[1] == 1)):
        return 5
    end
    counts := [0, 0, 0]
    combined := pair(tick(counts, 0, 1), tick(counts, 1, 2))
    total := tick(counts, 0, 3) + tick(counts, 1, 4)
    values := [0]
    receiver(counts, values)[tick(counts, 1, 0)] = tick(counts, 2, 9)
    if combined != 12 or total != 7 or values[0] != 9 or counts[0] != 3 or counts[1] != 3 or counts[2] != 1:
        return 1
    end
    skipped := false and tick(counts, 2, 1) > 0
    taken := true or tick(counts, 2, 1) > 0
    selected := tick(counts, 0, 8) if tick(counts, 1, 1) > 0 else tick(counts, 2, 0)
    if skipped or not taken or selected != 8 or counts[0] != 4 or counts[1] != 4 or counts[2] != 1:
        return 2
    end
    executed := true and tick(counts, 2, 1) > 0
    fallback := false or tick(counts, 2, 1) > 0
    alternate := tick(counts, 2, 0) if false else tick(counts, 0, 6)
    if not executed or not fallback or alternate != 6 or counts[0] != 5 or counts[2] != 3:
        return 6
    end
    repeated := [3 of tick(counts, 1, 7)]
    if counts[0] != 5 or counts[1] != 7 or repeated[2] != 7:
        return 3
    end
    empty := [0 of tick(counts, 2, 0)]
    if len(empty) != 0 or counts[2] != 3:
        return 4
    end
    println("once and lazy")
end
