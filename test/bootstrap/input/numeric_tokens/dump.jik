use "jik/string"

use "../../../../src/bootstrap/source"
use "../../../../src/bootstrap/diag"
use "../../../../src/bootstrap/lexer/lexer"
use "../../../../src/bootstrap/lexer/token"
use "../../../../src/bootstrap/lexer/string_literal"


// Build with the seed to inspect the bootstrap lexer independently of parsing.
func main(args):
    if len(args) != 2:
        return 2
    end
    file := source::SourceFile{text = copy(args[1], _)}
    diagnostics := diag::Diagnostics{}[.file]
    scanned := lexer::tokenize(file, diagnostics)
    if diagnostics.error_count > 0:
        for message in diagnostics.messages:
            println(message.summary)
        end
        return 1
    end
    for item in scanned:
        if item.type == token::TokenType.EOF:
            continue
        end
        spelling := must string::slice(file.text, item.span.start, item.span.stop)
        if item.type == token::TokenType.INTEGER or item.type == token::TokenType.DOUBLE:
            spelling = string::replace(spelling, "_", "")
        elif item.type == token::TokenType.CHAR:
            spelling = string::from_int(string_literal::byte_value(item.character))
        elif item.type == token::TokenType.NEWLINE:
            spelling = ""
        end
        println(token::TokenTypeNames[item.type], "\t", item.span.start, "\t", spelling)
    end
end
