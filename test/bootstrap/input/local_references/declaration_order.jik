use "jik/testing" as test

use "../../../jik/test_linked_list" as lists


func choose(flag: bool) -> int:
    if flag:
        value := 7
        return value
    end
    value := 9
    return value
end


throws func answer() -> int:
    return 42
end


func main():
    if true:
        value := 1
        assert(value == 1)
    end
    if true:
        value := 2
        assert(value == 2)
    end
    value := 3
    assert(value == 3)
    assert(choose(true) == 7)
    assert(choose(false) == 9)

    while true:
        text: String = "inner"
        assert(text == "inner")
        break
    end
    text := "outer"
    assert(text == "outer")

    try result := answer():
        assert(result == 42)
    except:
        assert(false)
    end
    result := 7
    assert(result == 7)

    ts := test::suite_new()
    lists::run_tests(ts)
    test::suite_finish(ts)
end
