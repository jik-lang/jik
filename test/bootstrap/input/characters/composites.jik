use "shared" as base

func main():
    values := ['a', 'b']
    push(values, 'c')
    values[0] = 'z'
    if pop(values) != 'c':
        return 1
    end
    optional := Some{'d'}
    if optional? != 'd':
        return 2
    end
    dictionary := {"key": 'e'}
    dictionary["key"] = 'f'
    if dictionary["key"]? != 'f':
        return 3
    end
    box := base::Box{value = 'g'}
    box.value = 'h'
    item := base::Item.BYTE{'i'}
    if item.BYTE != 'i' or box.value != 'h' or base::initial != 'j' or base::Letters[base::Key.A] != 'k':
        return 4
    end
    for index, value in values:
        print(index, ":", value, ";")
    end
    word := "ab"
    matches := 0
    for byte in word:
        if byte == 'a' or byte == 'b':
            matches += 1
        end
    end
    empty: Option[char]
    println(matches, ":", optional, ":", empty, ":", box.value, ":", item.BYTE)
end
