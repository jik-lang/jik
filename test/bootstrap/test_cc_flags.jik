use "jik/testing" as test
use "jik/argparse" as ap
use "jik/bytes"
use "jik/fs"
use "jik/path"
use "jik/process"
use "jik/string"

use "../../src/bootstrap/cli/cc_flags"
use "../../src/bootstrap/cli/build" as build_command
use "../../src/bootstrap/cli/run" as run_command
use "../../src/bootstrap/cli/utils" as cli_utils
use "language/utils"


func check_split(ts: test::TestSuite, foreign text: String, windows: bool, foreign expected: Vec[String]):
    actual := must cc_flags::parse(text, windows)
    test::suite_assert(ts, len(actual) == len(expected), site())
    if len(actual) == len(expected):
        for index, value in expected:
            test::suite_assert(ts, actual[index] == value, site())
        end
    end
end


func test_splitting(ts: test::TestSuite):
    empty: Vec[String]
    platforms := [false, true]
    for windows in platforms:
        check_split(ts, "", windows, empty)
        check_split(ts, " \t\r\n ", windows, empty)
        check_split(ts, "-O0 -DVALUE=42\t-g", windows, ["-O0", "-DVALUE=42", "-g"])
        check_split(ts, "-I\"include dir\" -include \"flag value.h\"", windows, ["-Iinclude dir", "-include", "flag value.h"])
        check_split(ts, "\"\" before\" middle \"after", windows, ["", "before middle after"])
        check_split(ts, "-DNAME=\\\"value\\\"", windows, ["-DNAME=\"value\""])
        check_split(ts, "& > $NAME", windows, ["&", ">", "$NAME"])
        try cc_flags::parse("-I\"unfinished", windows):
            test::suite_assert(ts, false, site())
        except:
            test::suite_assert(ts, error_msg() == "--ccflags: unterminated quote", site())
        end
    end
    check_split(ts, "-IC:\\sdk\\include \\\\server\\share", true, ["-IC:\\sdk\\include", "\\\\server\\share"])
    check_split(ts, "\"C:\\folder with spaces\\\\\"", true, ["C:\\folder with spaces\\"])
    check_split(ts, "'literal'", true, ["'literal'"])
    check_split(ts, "\"a\"\"b\"", true, ["a\"b"])
    check_split(ts, "-I'include dir' escaped\\ space", false, ["-Iinclude dir", "escaped space"])
    check_split(ts, "'C:\\folder' \"C:\\folder\"", false, ["C:\\folder", "C:\\folder"])
    try cc_flags::parse("trailing\\", false):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_msg() == "--ccflags: trailing escape", site())
    end
end


func test_parsers(ts: test::TestSuite):
    // Both commands must register the option, but flag splitting and native
    // build failures are shared behavior rather than a command permutation.
    parsers := [build_command::make_parser(), run_command::make_parser()]
    for parser in parsers:
        result := must ap::parse(parser, ["input.jik", "--release", "--ccflags", "-DVALUE=42 -O0"])
        option := result.options["--ccflags"]
        test::suite_assert(ts, option is Some, site())
        if option is Some:
            test::suite_assert(ts, option?["args"]? == "-DVALUE=42 -O0", site())
        end
        test::suite_assert(ts, result.options["--release"] is Some, site())
        try ap::parse(parser, ["input.jik", "--ccflags"]):
            test::suite_assert(ts, false, site())
        except:
            test::suite_assert(ts, string::contains(error_msg(), "missing value for option --ccflags"), site())
        end
    end
end


func test_commands(ts: test::TestSuite):
    tool := utils::compiler_command(_)
    input := "test/bootstrap/input/cc_flags/source dir/main.jik"
    flags := "-DCC_FLAGS_VALUE=42 -DCC_FLAGS_SECOND=7 -I\"test/bootstrap/input/cc_flags/include dir\" -include \"flag value.h\" -O0"
    workspace := must cli_utils::make_workspace()
    output := path::join([workspace, "program with spaces.exe"])
    built := must process::capture(tool, ["build", input, "--out", output, "--release", "--ccflags", flags])
    if built.code != 0:
        println(must bytes::to_string_ascii(built.err))
    end
    test::suite_assert(ts, built.code == 0 and fs::is_file(output), site())
    if built.code == 0:
        no_args: Vec[String]
        program := must process::capture(output, no_args)
        test::suite_assert(ts, program.code == 0, site())
        text := must bytes::to_string_ascii(program.out)
        test::suite_assert(ts, string::find(text, "ccflags passed") >= 0, site())
    end
    // test_preview covers flags passed to a target probe; test_run_command
    // covers missing-compiler handling and execution cleanup.
    must cli_utils::cleanup_workspace(workspace)
end


func run_tests(ts: test::TestSuite):
    println("[test] test_cc_flags")
    test_splitting(ts)
    test_parsers(ts)
    test_commands(ts)
end
