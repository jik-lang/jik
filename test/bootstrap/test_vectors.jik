use "jik/testing" as test
use "jik/string"

use "../../src/bootstrap/program"
use "support"
use "../../src/bootstrap/compiler"
use "../../src/bootstrap/parser/ast"
use "../../src/bootstrap/language/types"
use "../../src/bootstrap/language/region_source"
use "../../src/bootstrap/semantic/typing/typecheck"
use "../../src/bootstrap/semantic/regions/regions"


func analyze(foreign text: String, r: Region) -> program::Program:
    comp := support::infer_source(text, -1, r)
    typecheck::run(comp)
    regions::run(comp)
    return comp
end


func test_literal_shapes(ts) -> void:
    text := "func build(r: Region):\n    empty: Vec[Vec[String]][r]\n    values := [\n        1,\n        2\n    ][r]\n    repeated := [2 of [3, 4]]\n    middle := values[:1]\n    item := repeated[0][1]\nend\n"
    parsed := support::parse_source(text)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    if parsed.diagnostics.error_count > 0:
        return
    end
    tree := parsed.ast
    root := tree.get_root_module()
    body := tree.nodes[root.declarations[0]].kind.FUNCTION_DECL.body
    test::suite_assert(ts, len(body.statements) == 5, site())
    if len(body.statements) != 5:
        return
    end
    empty := tree.nodes[tree.nodes[body.statements[0]].kind.LOCAL_DECL.initializer?]
    test::suite_assert(ts, empty.kind is VECTOR_LITERAL, site())
    test::suite_assert(ts, len(empty.kind.VECTOR_LITERAL.elements) == 0 and empty.kind.VECTOR_LITERAL.annotation is Some, site())
    test::suite_assert(ts, empty.kind.VECTOR_LITERAL.destination is Some, site())
    annotation := tree.nodes[tree.nodes[body.statements[0]].kind.LOCAL_DECL.annotation?]
    test::suite_assert(ts, must string::slice(text, annotation.span.start, annotation.span.stop) == "Vec[Vec[String]]", site())
    test::suite_assert(ts, must string::slice(text, empty.span.start, empty.span.stop) == "Vec[Vec[String]][r]", site())
    values := tree.nodes[tree.nodes[body.statements[1]].kind.LOCAL_DECL.initializer?].kind.VECTOR_LITERAL
    test::suite_assert(ts, len(values.elements) == 2 and values.count is None and values.destination is Some, site())
    repeated := tree.nodes[tree.nodes[body.statements[2]].kind.LOCAL_DECL.initializer?].kind.VECTOR_LITERAL
    test::suite_assert(ts, len(repeated.elements) == 1 and repeated.count is Some, site())
    test::suite_assert(ts, tree.nodes[repeated.elements[0]].kind is VECTOR_LITERAL, site())
    slice := tree.nodes[tree.nodes[body.statements[3]].kind.LOCAL_DECL.initializer?].kind.SLICE
    test::suite_assert(ts, slice.start is None and slice.stop is Some, site())
    index := tree.nodes[tree.nodes[body.statements[4]].kind.LOCAL_DECL.initializer?].kind.INDEX
    test::suite_assert(ts, tree.nodes[index.value].kind is INDEX, site())
end


func test_inference_and_defaults(ts) -> void:
    // A known Vec result constrains its element, then the unannotated parameter.
    comp := support::infer_source("func build(value) -> Vec[int]:\n    return [value]\nend\n", -1)
    support::check_signature(ts, comp, "build", "func(int) -> Vec[int]")
    typecheck::run(comp)
    regions::run(comp)
    // The constructor is local; returning it has no eligible Region parameter.
    test::suite_assert(ts, comp.diagnostics.error_count == 1, site())

    inferred := support::infer_source("func build(value, r: Region) -> Vec[int]:\n    return [value]\nend\nfunc identity(values):\n    return values\nend\nfunc main():\n    values: Vec[int] = identity(build(42))\n    return values[0]\nend\n", 0)
    support::check_signature(ts, inferred, "build", "func(int, Region) -> Vec[int]")
    support::check_signature(ts, inferred, "identity", "func(Vec[int]) -> Vec[int]")
    typecheck::run(inferred)
    regions::run(inferred)
    test::suite_assert(ts, inferred.diagnostics.error_count == 0, site())

    // This fixture was previously rejected because Vec defaults were unsupported.
    config := compiler::Config{input_path = "test/bootstrap/input/typed_locals/composite_default.jik"}
    compiled := must compiler::new(config)
    translation := must compiler::translate(compiled)
    test::suite_assert(ts, string::find(translation, "_new(jik_local_region, 0)") >= 0, site())
    test::suite_assert(ts, string::find(translation, "jik_region_free(jik_local_region)") >= 0, site())
end


func test_nested_regions(ts) -> void:
    text := "func direct(r: Region) -> Vec[Vec[String]]:\n    return [[\"nested\"]]\nend\nfunc store(values: Vec[Vec[String]]):\n    values[0] = [\"replacement\"]\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is VECTOR_LITERAL or node.kind is STRING_LITERAL:
            test::suite_assert(ts, node.region_source.kind == region_source::Kind.CALLER, site())
            test::suite_assert(ts, node.allocation_target is Some, site())
        end
    end
    root := mod.ast.get_root_module()
    for id in root.declarations:
        function := mod.ast.nodes[id].kind.FUNCTION_DECL
        test::suite_assert(ts, not function.needs_local_region, site())
        test::suite_assert(ts, function.is_region_safe == (function.name == "store"), site())
    end
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
end


func test_call_safety(ts) -> void:
    text := "func read(values: Vec[String]) -> String:\n    return values[0]\nend\nfunc compare(left: Vec[String], right: Vec[String]) -> bool:\n    return left[0] == right[0]\nend\nfunc update(values: Vec[int]):\n    values[0] = 42\nend\nfunc allocate(r: Region, owner: Vec[String]) -> int:\n    values := [\"stored\"][r]\n    return len(values)\nend\nfunc empty(r: Region, owner: Vec[String]) -> int:\n    values: Vec[String][r]\n    return len(values)\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    expected := [false, true, true, false, true]
    root := mod.ast.get_root_module()
    for index, id in root.declarations:
        test::suite_assert(ts, mod.ast.nodes[id].kind.FUNCTION_DECL.is_region_safe == expected[index], site())
    end
end


func test_errors_and_recovery(ts) -> void:
    cases := [
        "func main():\n    values := []\nend\n",
        "func main():\n    values := [1, true]\nend\n",
        "func main():\n    values := [1, 2.0]\nend\n",
        "func main():\n    values := [true of 1]\nend\n",
        "func main():\n    values := [1]\n    item := values[false]\nend\n",
        "func main():\n    values := [1]\n    item := values[:false]\nend\n",
        "func main():\n    values := [1]\n    values[:] = [2]\nend\n",
        "func main():\n    item := ([1])[0]\nend\n",
        "func main():\n    item := len(42)\nend\n",
        "func invalid(value: String):\n    values := [value]\nend\n",
        "func invalid(values: Vec[String]):\n    local := \"local\"\n    values[0] = local\nend\n"
    ]
    for input_text in cases:
        comp := analyze(input_text)
        test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
        if comp.diagnostics.error_count == 1:
            test::suite_assert(ts, comp.diagnostics.messages[0].span is Some, site())
        end
    end
    // A failed nested suffix must restore parser depth before the next statement.
    text := "func build(r: Region):\n    invalid := [\"nested\"[r]]\n    valid := [1][r]\n    return 0\nend\n"
    parsed := support::parse_source(text)
    test::suite_assert(ts, parsed.diagnostics.error_count == 1, site())
    root := parsed.ast.get_root_module()
    test::suite_assert(ts, len(root.declarations) == 1, site())
    if len(root.declarations) == 1:
        body := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL.body
        test::suite_assert(ts, len(body.statements) == 2, site())
        if len(body.statements) == 2:
            test::suite_assert(ts, parsed.ast.nodes[body.statements[0]].kind is LOCAL_DECL, site())
            test::suite_assert(ts, parsed.ast.nodes[body.statements[1]].kind is RETURN, site())
        end
    end
end


func test_checked_index_metadata(ts) -> void:
    comp := support::infer_source("func first(values: Vec[int]) -> int:\n    return values[0]\nend\n", -1)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is INDEX:
            node.inferred_type = Some{types::atom(mod.type_store, types::Atom.BOOL)}[.node]
        end
    end
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count > 0, site())
end


func run_tests(ts) -> void:
    println("[test] test_vectors")
    test_literal_shapes(ts)
    test_inference_and_defaults(ts)
    test_nested_regions(ts)
    test_call_safety(ts)
    test_errors_and_recovery(ts)
    test_checked_index_metadata(ts)
end
