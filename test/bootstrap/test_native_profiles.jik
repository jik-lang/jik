use "jik/testing" as test
use "jik/string"

use "support"
use "../../src/bootstrap/language/native"
use "../../src/bootstrap/lexer/lexer"
use "../../src/bootstrap/lexer/token"
use "../../src/bootstrap/source"
use "../../src/bootstrap/diag"


func test_lexing(ts):
    file := source::SourceFile{id = 3, text = "@platform(windows)\n@profile(windows-x64-mingw)\n@link(\"x\")\n"}
    diagnostics := diag::Diagnostics{}
    tokens := lexer::tokenize(file, diagnostics)
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    test::suite_assert(ts, tokens[0].type == token::TokenType.DIRECTIVE_PLATFORM, site())
    test::suite_assert(ts, tokens[0].span.start == 0 and tokens[0].span.stop == 9, site())
    test::suite_assert(ts, tokens[0].span.source_id == 3, site())
    test::suite_assert(ts, tokens[5].type == token::TokenType.DIRECTIVE_PROFILE, site())
end


func test_guard_state(ts):
    text := "@includedir(\"common\")\n@platform(windows)\n@profile(windows - x64 - mingw)\n@link(\"one\", \"two\")\n@platform(linux)\n@copy(\"still-mingw\")\n@profile(linux-x64-gnu)\n@libdir(\"linux\")\n@platform(all)\n@profile(all)\n@link(\"reset\")"
    parsed := support::parse_source(text)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    if parsed.diagnostics.error_count > 0:
        return
    end
    requirements := parsed.ast.get_root_module().requirements
    test::suite_assert(ts, len(requirements) == 5, site())
    test::suite_assert(ts, requirements[0].platform == native::Platform.ALL and requirements[0].profile == native::Profile.ALL, site())
    test::suite_assert(ts, requirements[1].platform == native::Platform.WINDOWS and requirements[1].profile == native::Profile.WINDOWS_X64_MINGW, site())
    test::suite_assert(ts, requirements[1].arguments[0] == "one" and requirements[1].arguments[1] == "two", site())
    test::suite_assert(ts, requirements[1].span.start == string::find(text, "@link"), site())
    test::suite_assert(ts, requirements[2].platform == native::Platform.LINUX and requirements[2].profile == native::Profile.WINDOWS_X64_MINGW, site())
    test::suite_assert(ts, requirements[3].profile == native::Profile.LINUX_X64_GNU, site())
    test::suite_assert(ts, requirements[4].platform == native::Platform.ALL and requirements[4].profile == native::Profile.ALL, site())
    fresh := support::parse_source("@link(\"fresh\")\n")
    requirement := fresh.ast.get_root_module().requirements[0]
    test::suite_assert(ts, requirement.platform == native::Platform.ALL and requirement.profile == native::Profile.ALL, site())
    // Selectors never conditionally compile declarations, including imported C.
    translation := must support::translate("@platform(linux)\n@profile(linux-x64-gnu)\n@embed{C}\n#define PROFILE_PAYLOAD 42\nC\nfunc main():\n    return 0\nend\n", "", _)
    test::suite_assert(ts, string::find(translation, "#define PROFILE_PAYLOAD 42") >= 0, site())
end


func test_target_and_matching(ts):
    targets := ["x86_64-w64-mingw32", "x86_64-pc-windows-gnu\r\n", "x86_64-unknown-linux-gnu", "x86_64-pc-windows-msvc", "aarch64-linux-gnu", "x86_64-linux-musl", ""]
    expected := [native::Profile.WINDOWS_X64_MINGW, native::Profile.WINDOWS_X64_MINGW, native::Profile.LINUX_X64_GNU, native::Profile.UNKNOWN, native::Profile.UNKNOWN, native::Profile.UNKNOWN, native::Profile.UNKNOWN]
    for index, target in targets:
        test::suite_assert(ts, native::normalize_target(target) == expected[index], site())
    end
    requirements := [
        native::Requirement{platform = native::Platform.WINDOWS, profile = native::Profile.WINDOWS_X64_MINGW},
        native::Requirement{platform = native::Platform.WINDOWS, profile = native::Profile.LINUX_X64_GNU},
        native::Requirement{platform = native::Platform.ALL, profile = native::Profile.ALL}
    ]
    test::suite_assert(ts, native::requires_profile(requirements, native::Platform.WINDOWS), site())
    test::suite_assert(ts, not native::requires_profile(requirements, native::Platform.LINUX), site())
    test::suite_assert(ts, native::supports_profile(requirements, native::Platform.WINDOWS, native::Profile.WINDOWS_X64_MINGW), site())
    test::suite_assert(ts, native::supports_profile(requirements, native::Platform.WINDOWS, native::Profile.LINUX_X64_GNU), site())
    test::suite_assert(ts, not native::supports_profile(requirements, native::Platform.WINDOWS, native::Profile.UNKNOWN), site())
    test::suite_assert(ts, native::supports_profile(requirements, native::Platform.LINUX, native::Profile.UNKNOWN), site())
    test::suite_assert(ts, not native::active(requirements[0], native::Platform.LINUX, native::Profile.WINDOWS_X64_MINGW), site())
end


func test_rejections_and_recovery(ts):
    invalid := ["@platform(mac)\n", "@profile(windows-x64-msvc)\n", "@profile(windows-x64)\n", "@profile(\"all\")\n", "@platform()\n", "@platform(all, linux)\n", "@link()\n", "@link(1)\n", "@copy(\"a\",)\n", "@libdir(\"a\"\n", "@link(\"\"\"a\"\"\")\n", "func wrong():\n@platform(all)\nend\n"]
    for text in invalid:
        parsed := support::parse_source(concat(text, "func main():\nend\n"))
        test::suite_assert(ts, parsed.diagnostics.error_count > 0, site())
        test::suite_assert(ts, parsed.diagnostics.messages[0].span is Some, site())
        test::suite_assert(ts, len(parsed.ast.get_root_module().declarations) >= 1, site())
    end
end


func run_tests(ts):
    println("[test] test_native_profiles")
    test_lexing(ts)
    test_guard_state(ts)
    test_target_and_matching(ts)
    test_rejections_and_recovery(ts)
end
