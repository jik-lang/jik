use "jik/testing" as test
use "jik/bytes"
use "jik/fs"
use "jik/io"
use "jik/path"
use "jik/process"
use "jik/string"
use "jik/sys"

use "../../src/bootstrap/cli/utils" as cli_utils
use "../../src/bootstrap/compiler"
use "../../src/bootstrap/codegen/codegen"
use "language/utils"
use "test_help_env" as helpers


func compile_and_run(ts: test::TestSuite, foreign cc: String, foreign source: String, foreign executable: String, embedded: bool):
    arguments := ["-std=c11", copy(source), "-o", copy(executable)]
    if not embedded:
        tool := utils::compiler_command(_)
        root := path::dirname(path::normalize(path::join([sys::cwd(), tool]))) if not path::is_absolute(tool) else path::dirname(tool)
        arguments.push("-I")
        arguments.push(path::join([root, "support", "include"]))
    end
    built := must process::capture(cc, arguments)
    if built.code != 0:
        println(must bytes::to_string_ascii(built.err))
    end
    test::suite_assert(ts, built.code == 0, site())
    if built.code == 0:
        no_arguments: Vec[String]
        test::suite_assert(ts, helpers::capture(executable, no_arguments) == "42\n", site())
    end
end


func test_output(ts: test::TestSuite):
    tool := utils::compiler_command(_)
    cc := must cli_utils::select_compiler("")
    workspace := must cli_utils::make_workspace()
    output := path::join([workspace, "output with spaces.c"])
    executable := path::join([workspace, "translated.exe"])
    input := "test/bootstrap/input/translation/main.jik"
    comp := must compiler::new(compiler::Config{input_path = input})
    sid := must compiler::analyze(comp)
    core := must io::read_file("support/include/core.h")
    modes := [false, true]
    for embedded in modes:
        for locations in modes:
            arguments := ["tran", input, "--out", output]
            if embedded:
                arguments.push("--embed-core")
            end
            if locations:
                arguments.push("--emit-source-loc")
            end
            // Check the option matrix in process; only the representative CLI
            // pairs below need output files and native compilation.
            options := codegen::Options{emit_source_loc = locations}
            if embedded:
                options.core_source = Some{core}
            end
            text := must codegen::generate(comp.program, sid, options, .comp)
            test::suite_assert(ts, string::contains(text, "#include \"core.h\"") == not embedded, site())
            test::suite_assert(ts, string::contains(text, "#define JIK_ERR_PREFIX") == embedded, site())
            test::suite_assert(ts, string::contains(text, "// source: ") == locations, site())
            if locations:
                dependency := path::normalize("test/bootstrap/input/translation/dependency.jik")
                escaped := string::replace(dependency, "\\", "\\\\")
                declaration_lines := [1, 5, 10, 15, 20, 22]
                for location in declaration_lines:
                    test::suite_assert(ts, string::contains(text, concat("// source: ", escaped, ":", string::from_int(location), ":1\n")), site())
                end
                main_path := string::replace(path::normalize(input), "\\", "\\\\")
                test::suite_assert(ts, string::contains(text, concat("// source: ", main_path, ":3:1\n")), site())
                test::suite_assert(ts, string::contains(text, concat("// source: ", main_path, ":4:5\n")), site())
            end
            // Compile external core without locations and embedded core with them.
            if embedded == locations:
                test::suite_assert(ts, helpers::capture(tool, arguments) == "", site())
                test::suite_assert(ts, must io::read_file(output) == text, site())
                compile_and_run(ts, cc, output, executable, embedded)
            end
        end
    end
    // Installed core lookup must not depend on the input's directory or cwd.
    installed := path::join([workspace, "relocated compiler.exe"])
    must fs::copy_file(tool, installed)
    assert(helpers::make_executable(installed) == 0)
    previous := must io::read_file(output)
    helpers::check_failure(ts, installed, ["tran", input, "--out", output, "--embed-core"], "could not read support header")
    test::suite_assert(ts, must io::read_file(output) == previous, site())
    test::suite_assert(ts, helpers::capture(installed, ["tran", input, "--out", output]) == "", site())
    // Default output stays beside the input, including when its path has spaces.
    local_input := path::join([workspace, "default output.jik"])
    local_output := path::join([workspace, "default output.c"])
    must fs::copy_file(input, local_input)
    must fs::copy_file("test/bootstrap/input/translation/dependency.jik", path::join([workspace, "dependency.jik"]))
    dumped := helpers::capture(tool, ["tran", local_input, "--embed-core", "--emit-source-loc", "--dump-ast"])
    test::suite_assert(ts, string::contains(dumped, "[AST: "), site())
    test::suite_assert(ts, string::contains(must io::read_file(local_output), "// source: "), site())
    help := helpers::capture(tool, ["help", "tran"])
    options := ["--embed-core", "--emit-source-loc", "--format-c"]
    for option in options:
        test::suite_assert(ts, string::contains(help, option), site())
        helpers::check_failure(ts, tool, ["tran", input, "--out", output, option, option], "duplicate option")
        helpers::check_failure(ts, tool, ["check", input, option], "unknown option")
    end
    helpers::check_failure(ts, tool, ["tran", "test/bootstrap/input/preview/invalid.jik", "--out", output, "--embed-core", "--emit-source-loc"], "missing")
    helpers::check_failure(ts, tool, ["tran", input, "--out", workspace, "--embed-core"], "could not write output")
    must cli_utils::cleanup_workspace(workspace)
end


func run_tests(ts: test::TestSuite):
    println("[test] test_translation_options")
    test_output(ts)
end
