use "jik/testing" as test
use "jik/string"

use "support"
use "test_regions"
use "../../src/bootstrap/language/builtin"
use "../../src/bootstrap/language/region_source"
use "../../src/bootstrap/semantic/typing/typecheck"
use "../../src/bootstrap/semantic/regions/regions"
use "../../src/bootstrap/language/types"


func test_site_inference_and_regions(ts) -> void:
    text := "func capture() -> Site:\n    return site()\nend\nfunc line(value):\n    return site_line(value)\nend\nfunc describe(value, r: Region) -> String:\n    local := site_file(value)\n    return site_code(value, r)\nend\n"
    comp := support::infer_source(text, -1)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    declarations := mod.ast.get_root_module().declarations
    capture := mod.ast.nodes[declarations[0]].kind.FUNCTION_DECL
    captured := mod.ast.nodes[mod.ast.nodes[capture.body.statements[0]].kind.RETURN.value?]
    test::suite_assert(ts, captured.kind.CALL.builtin? == builtin::Kind.SITE, site())
    test::suite_assert(ts, captured.inferred_type? == types::atom(mod.type_store, types::Atom.SITE), site())
    test::suite_assert(ts, capture.is_region_safe and not capture.needs_local_region, site())
    line := mod.ast.nodes[declarations[1]].kind.FUNCTION_DECL
    test::suite_assert(ts, mod.ast.nodes[line.parameters[0]].inferred_type? == types::atom(mod.type_store, types::Atom.SITE), site())
    test::suite_assert(ts, line.is_region_safe and not line.needs_local_region, site())
    describe := mod.ast.nodes[declarations[2]].kind.FUNCTION_DECL
    local := mod.ast.nodes[describe.body.statements[0]]
    call := mod.ast.nodes[local.kind.LOCAL_DECL.initializer?]
    test::suite_assert(ts, call.kind.CALL.auto_region and len(call.kind.CALL.arguments) == 2, site())
    test::suite_assert(ts, call.region_source.kind == region_source::Kind.LOCAL and describe.needs_local_region, site())
    returned := mod.ast.nodes[mod.ast.nodes[describe.body.statements[1]].kind.RETURN.value?]
    test::suite_assert(ts, returned.region_source.kind == region_source::Kind.CALLER and returned.region_source.parameter_id == describe.parameters[1], site())
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0 and returned.region_source.parameter_id == describe.parameters[1], site())
end


func test_site_emission(ts) -> void:
    final_line := support::parse_source("origin := site()")
    test::suite_assert(ts, final_line.diagnostics.error_count == 0, site())
    same_line := support::parse_source("first := site() second := site()")
    test::suite_assert(ts, same_line.diagnostics.error_count > 0, site())
    text := "func capture() -> Site:\n    return site(\n    ) // following line\nend\nfunc main():\n    value := capture()\n    assert(site_line(value) == 2)\nend\n"
    code := must support::translate(text, "")
    test::suite_assert(ts, string::find(code, "JikSite jik_m0_capture(") >= 0, site())
    test::suite_assert(ts, string::find(code, "\", \"    return site(\", 2)") >= 0, site())
end


func test_site_restrictions(ts) -> void:
    test_regions::check_error(ts, "func bad():\n    value := site(1)\nend\n", "call arity mismatch")
    test_regions::check_error(ts, "func bad():\n    value := site_line()\nend\n", "call arity mismatch")
    test_regions::check_error(ts, "func bad():\n    value := site_file()\nend\n", "call arity mismatch")
    test_regions::check_error(ts, "func bad():\n    value := site_code(1)\nend\n", "type inference conflict")
    test_regions::check_error(ts, "func bad():\n    value := site_file(site(), 1)\nend\n", "type inference conflict")
    test_regions::check_error(ts, "func bad() -> String:\n    return site_code(site())\nend\n", "cannot return local allocation")
    test_regions::check_error(ts, "func bad():\n    if site():\n        return\n    end\nend\n", "invalid condition type")
end


func run_tests(ts) -> void:
    println("[test] test_site")
    test_site_inference_and_regions(ts)
    test_site_emission(ts)
    test_site_restrictions(ts)
end
