use "jik/testing" as test
use "jik/string"

use "../../src/bootstrap/program"
use "../../src/bootstrap/semantic/resolution/resolve"
use "support"
use "../../src/bootstrap/language/types"
use "../../src/bootstrap/modules/module"


func declaration_type(mod: module::Module, name: String) -> int:
    entry := mod.global_scope.symbols[name]
    if entry is None:
        return -1
    end
    declaration := mod.ast.nodes[entry?.origin].kind.TYPE_DECL
    return declaration.resolved_type? if declaration.resolved_type is Some else -1
end


func test_canonical_store(ts) -> void:
    store := types::Store{}
    int_type := types::atom(store, types::Atom.INT)
    bool_type := types::atom(store, types::Atom.BOOL)
    option := must types::container(store, types::Container.OPTION, int_type)
    dictionary := must types::container(store, types::Container.DICTIONARY, option)
    vector := must types::container(store, types::Container.VECTOR, dictionary)
    again := must types::container(store, types::Container.VECTOR, dictionary)
    different := must types::container(store, types::Container.VECTOR, bool_type)
    test::suite_assert(ts, types::equal(store, vector, again), site())
    test::suite_assert(ts, not types::equal(store, vector, different), site())
    test::suite_assert(ts, not types::equal(store, -1, -1), site())
    test::suite_assert(ts, must types::format(store, vector) == "Vec[Dict[Option[int]]]", site())
    left := must types::named(store, types::NamedKind.STRUCT, 20, 5, "Box")
    alias := must types::named(store, types::NamedKind.STRUCT, 20, 5, "Alias")
    right := must types::named(store, types::NamedKind.STRUCT, 30, 5, "Box")
    distinct := must types::named(store, types::NamedKind.STRUCT, 20, 6, "Another")
    test::suite_assert(ts, types::equal(store, left, alias), site())
    test::suite_assert(ts, not types::equal(store, left, right), site())
    test::suite_assert(ts, not types::equal(store, left, distinct), site())
    test::suite_assert(ts, must types::format(store, left) == "module[20]::Box", site())
    signature := must types::function(store, [int_type, vector], bool_type, false)
    repeated := must types::function(store, [int_type, vector], bool_type, false)
    reordered := must types::function(store, [vector, int_type], bool_type, false)
    test::suite_assert(ts, types::equal(store, signature, repeated), site())
    test::suite_assert(ts, not types::equal(store, signature, reordered), site())
    test::suite_assert(ts, must types::format(store, signature) == "func(int, Vec[Dict[Option[int]]]) -> bool", site())
    spellings := ["int", "double", "bool", "char", "String", "void", "Region", "Site"]
    for spelling in spellings:
        builtin := types::builtin(store, spelling)
        test::suite_assert(ts, builtin is Some, site())
        if builtin is Some:
            test::suite_assert(ts, must types::format(store, builtin?) == spelling, site())
        end
    end
    try types::container(store, types::Container.VECTOR, -1):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_msg() == "invalid container element type ID", site())
    end
    try types::function(store, [int_type, -1], bool_type, false):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_msg() == "invalid function parameter type ID", site())
    end
    try types::format(store, len(store.types)):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_msg() == "invalid type ID", site())
    end
end


func test_type_spans_and_recovery(ts) -> void:
    text := "func f(value: Vec[Option[int]]) -> Dict[Option[bool]]:\nend\n"
    comp := support::resolve_source(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    function := mod.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL
    parameter := mod.ast.nodes[function.parameters[0]].kind.PARAMETER
    description := mod.ast.nodes[parameter.annotation?]
    test::suite_assert(ts, must string::slice(text, description.span.start, description.span.stop) == "Vec[Option[int]]", site())
    return_node := mod.ast.nodes[function.return_annotation?]
    test::suite_assert(ts, must string::slice(text, return_node.span.start, return_node.span.stop) == "Dict[Option[bool]]", site())
    malformed := support::resolve_source("func broken(value: Vec[Option[int]):\nend\nfunc main():\n    return 0\nend\n")
    test::suite_assert(ts, malformed.diagnostics.error_count == 1, site())
    recovered_root := malformed.modules[0].ast.get_root_module()
    test::suite_assert(ts, len(recovered_root.declarations) == 1, site())
    if len(recovered_root.declarations) == 1:
        test::suite_assert(ts, malformed.modules[0].ast.nodes[recovered_root.declarations[0]].kind.FUNCTION_DECL.name == "main", site())
    end
end


func test_shared_named_identity(ts) -> void:
    comp := program::Program{}
    support::add_source(comp, "struct Box:\n    items: Vec[Option[int]]\nend\n", 0)
    support::add_source(comp, "struct Wrapped:\n    item: common::Box\nend\n", 1)
    support::add_source(comp, "func accept(a: shared::Box, b: bridge::Wrapped, c: Box, d: Option[Vec[Dict[shared::Box]]]) -> shared::Box:\n    return a\nend\nstruct Box:\n    flag: bool\nend\n", 2)
    span := comp.modules[0].ast.nodes[0].span
    comp.modules[1].imports.push(module::ResolvedImport{target_id = 0, alias = "common", span})
    comp.modules[2].imports.push(module::ResolvedImport{target_id = 0, alias = "shared", span})
    comp.modules[2].imports.push(module::ResolvedImport{target_id = 1, alias = "bridge", span})
    resolve::resolve_declarations(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    shared := declaration_type(comp.modules[0], "Box")
    wrapped := declaration_type(comp.modules[1], "Wrapped")
    local_type := declaration_type(comp.modules[2], "Box")
    store := comp.modules[2].type_store
    test::suite_assert(ts, shared != local_type, site())
    wrapper_definition := store.types[wrapped].kind.NAMED
    test::suite_assert(ts, wrapper_definition.member_types[0] == shared, site())
    function_id := comp.modules[2].global_scope.symbols["accept"]?.origin
    function := comp.modules[2].ast.nodes[function_id].kind.FUNCTION_DECL
    expected_parameters := [shared, wrapped, local_type]
    for index, expected_type in expected_parameters:
        parameter := comp.modules[2].ast.nodes[function.parameters[index]].kind.PARAMETER
        description := comp.modules[2].ast.nodes[parameter.annotation?].kind.TYPE_NAME
        test::suite_assert(ts, description.resolved_type? == expected_type, site())
    end
    test::suite_assert(ts, comp.modules[2].ast.nodes[function.return_annotation?].kind.TYPE_NAME.resolved_type? == shared, site())
    nested_parameter := comp.modules[2].ast.nodes[function.parameters[3]].kind.PARAMETER
    nested := comp.modules[2].ast.nodes[nested_parameter.annotation?].kind.TYPE_NAME.resolved_type?
    test::suite_assert(ts, must types::format(store, nested) == "Option[Vec[Dict[module[0]::Box]]]", site())
    test::suite_assert(ts, comp.modules[2].ast.nodes[function_id].inferred_type is None, site())
    // All three modules can read the types created while resolving the entry.
    test::suite_assert(ts, len(comp.modules[0].type_store.types) == len(store.types), site())
    test::suite_assert(ts, must types::format(comp.modules[0].type_store, nested) == "Option[Vec[Dict[module[0]::Box]]]", site())
end


func check_error(ts, foreign text: String, foreign expected: String) -> void:
    comp := support::resolve_source(text)
    test::suite_assert(ts, comp.diagnostics.error_count > 0, site())
    found := false
    for message in comp.diagnostics.messages:
        if message.summary == expected:
            found = true
            test::suite_assert(ts, message.span is Some, site())
        end
    end
    test::suite_assert(ts, found, site())
end


func test_invalid_types(ts) -> void:
    check_error(ts, "func f(x: Missing):\nend\n", "unknown type")
    check_error(ts, "func f(x: missing::Box):\nend\n", "unknown import alias")
    check_error(ts, "func f(x: Vec):\nend\n", "missing type argument")
    check_error(ts, "func f(x: Vec[]):\nend\n", "invalid type arguments")
    check_error(ts, "func f(x: Dict[int, bool]):\nend\n", "invalid type arguments")
    check_error(ts, "func f(x: int[bool]):\nend\n", "invalid type constructor")
    check_error(ts, "func f(x: Vec[Option[Missing]]):\nend\n", "unknown type")
    check_error(ts, "func helper():\nend\nfunc f(x: helper):\nend\n", "expected a type")
    check_error(ts, "func f(x: void):\nend\n", "invalid parameter type")
    check_error(ts, "struct Box:\n    x: int\n    x: bool\nend\n", "duplicate type member")
    check_error(ts, "enum Mode:\n    ON\n    ON\nend\n", "duplicate type member")
    check_error(ts, "struct Node:\n    next: Node\nend\n", "illegal recursive type")
    check_error(ts, "struct Node:\n    next: Vec[Node]\nend\n", "illegal recursive type")
    check_error(ts, "variant Expr:\n    NEXT: Dict[Expr]\nend\n", "illegal recursive type")
    check_error(ts, "struct First:\n    next: Second\nend\nstruct Second:\n    next: First\nend\n", "illegal recursive type")
    check_error(ts, "struct Box:\nend\nfunc Box():\nend\n", "semantic analysis")
    check_error(ts, "struct int:\nend\n", "invalid type name")
    check_error(ts, "func f(x: Vec[Option[int]):\nend\nfunc main():\n    return 0\nend\n", "unexpected token")
end


func test_declarations_and_recursion(ts) -> void:
    comp := support::resolve_source("struct Node:\n    next: Option[Vec[Node]]\nend\nvariant Value:\n    NODE: Node\n    EMPTY\nend\nenum Mode:\n    ON\n    OFF\nend\nextern struct Native as Handle\nfunc f(value: Value, mode: Mode, handle: Handle) -> void:\nend\n")
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    store := mod.type_store
    node_type := declaration_type(mod, "Node")
    value_type := declaration_type(mod, "Value")
    mode_type := declaration_type(mod, "Mode")
    handle_type := declaration_type(mod, "Handle")
    test::suite_assert(ts, store.types[node_type].kind.NAMED.kind == types::NamedKind.STRUCT, site())
    test::suite_assert(ts, store.types[value_type].kind.NAMED.kind == types::NamedKind.VARIANT, site())
    test::suite_assert(ts, store.types[mode_type].kind.NAMED.kind == types::NamedKind.ENUM, site())
    test::suite_assert(ts, store.types[handle_type].kind.NAMED.kind == types::NamedKind.EXTERN_STRUCT, site())
    field := store.types[node_type].kind.NAMED.member_types[0]
    test::suite_assert(ts, must types::format(store, field) == "Option[Vec[module[0]::Node]]", site())
end


func run_tests(ts) -> void:
    println("[test] test_types")
    test_canonical_store(ts)
    test_shared_named_identity(ts)
    test_invalid_types(ts)
    test_declarations_and_recursion(ts)
    test_type_spans_and_recovery(ts)
end
