use "jik/string"
use "jik/testing" as test

use "support"
use "../../src/bootstrap/parser/format"
use "../../src/bootstrap/semantic/typing/typecheck"


func test_branch_shapes_and_scopes(ts) -> void:
    text := "func choose(flag: int):\n    if flag == 0:\n        item := 1\n        return item\n    elif flag == 1:\n        item := 2\n        return item\n    else:\n        item := 3\n        return item\n    end\nend\n"
    parsed := support::parse_source(text, _)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    root := parsed.ast.get_root_module()
    function := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL
    node := parsed.ast.nodes[function.body.statements[0]]
    statement := node.kind.IF
    test::suite_assert(ts, len(statement.branches) == 2, site())
    test::suite_assert(ts, statement.else_body is Some, site())
    test::suite_assert(ts, len(statement.else_body?.statements) == 2, site())
    test::suite_assert(ts, node.span.start == 28 and node.span.stop == 193, site())
    formatted := format::format(parsed.ast)
    test::suite_assert(ts, string::find(formatted, "ELIF") >= 0, site())
    test::suite_assert(ts, string::find(formatted, "ELSE") >= 0, site())
    comp := support::infer_source(text, -1)
    support::check_signature(ts, comp, "choose", "func(int) -> int")
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    mod := comp.modules[0]
    checked := mod.ast.nodes[mod.global_scope.symbols["choose"]?.origin].kind.FUNCTION_DECL
    branches := mod.ast.nodes[checked.body.statements[0]].kind.IF
    for branch in branches.branches:
        test::suite_assert(ts, branch.body.scope.parent is Some, site())
        test::suite_assert(ts, branch.body.scope.symbols["item"]?.origin == branch.body.statements[0], site())
        comparison := mod.ast.nodes[branch.condition].kind.BINARY
        test::suite_assert(ts, mod.ast.nodes[comparison.left].kind.IDENTIFIER_EXPR.local_origin? == checked.parameters[0], site())
    end
    test::suite_assert(ts, branches.else_body?.scope.symbols["item"]?.origin == branches.else_body?.statements[0], site())
    test::suite_assert(ts, checked.body.scope.symbols["item"] is None, site())
end


func test_returns_and_conditions(ts) -> void:
    comp := support::infer_source("func from_else(flag: bool):\n    if flag:\n        value := 0\n    else:\n        return 42\n    end\nend\nfunc from_elif(flag: bool):\n    if flag:\n    elif true:\n        return 42\n    end\nend\n", -1)
    support::check_signature(ts, comp, "from_else", "func(bool) -> int")
    support::check_signature(ts, comp, "from_elif", "func(bool) -> int")
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    // The documented Site-condition seed bug also applies to elif conditions.
    invalid := support::infer_source("func inspect(value: Site):\n    if false:\n    elif value:\n    end\nend\n", -1)
    test::suite_assert(ts, invalid.diagnostics.error_count == 0, site())
    typecheck::run(invalid)
    test::suite_assert(ts, invalid.diagnostics.error_count == 1, site())
    test::suite_assert(ts, invalid.diagnostics.messages[0].summary == "invalid condition type", site())
end


func test_parser_recovery(ts) -> void:
    invalid_sources := ["func main():\n    else:\n    return 0\nend\n",
        "func main():\n    if true:\n    else:\n    else:\n    end\nend\n",
        "func main():\n    if true:\n    elif:\n    end\nend\n",
        "func main():\n    if true:\n    elif false:\n"]
    for text in invalid_sources:
        parsed := support::parse_source(text, _)
        test::suite_assert(ts, parsed.diagnostics.error_count > 0, site())
    end
end


func run_tests(ts) -> void:
    println("[test] test_branches")
    test_branch_shapes_and_scopes(ts)
    test_returns_and_conditions(ts)
    test_parser_recovery(ts)
end
