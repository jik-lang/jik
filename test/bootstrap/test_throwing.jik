use "jik/testing" as test
use "jik/string"

use "support"
use "test_regions"
use "../../src/bootstrap/parser/format"
use "../../src/bootstrap/parser/ast"
use "../../src/bootstrap/language/types"
use "../../src/bootstrap/language/builtin"
use "../../src/bootstrap/semantic/typing/typecheck"
use "../../src/bootstrap/semantic/typing/inference"
use "../../src/bootstrap/semantic/regions/regions"


func test_signatures_and_fail(ts) -> void:
    text := "throws func example(code: int) -> int:\n    message := concat(\"failure\")\n    if code > 0:\n        return code\n    end\n    fail(message, code)\nend\n"
    comp := support::infer_source(text, -1)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    origin := mod.ast.get_root_module().declarations[0]
    node := mod.ast.nodes[origin]
    function := node.kind.FUNCTION_DECL
    signature := node.inferred_type?
    test::suite_assert(ts, function.is_throwing and function.needs_local_region, site())
    test::suite_assert(ts, node.span.start == 0 and node.span.stop == len(text) - 1, site())
    test::suite_assert(ts, mod.type_store.types[signature].kind.FUNCTION.is_throwing, site())
    test::suite_assert(ts, must types::format(mod.type_store, signature) == "throws func(int) -> int", site())
    call := mod.ast.nodes[function.body.statements[2]]
    test::suite_assert(ts, call.kind.CALL.builtin? == builtin::Kind.FAIL, site())
    test::suite_assert(ts, call.inferred_type? == types::atom(mod.type_store, types::Atom.VOID), site())
    test::suite_assert(ts, string::find(format::format(mod.ast), "THROWS FUNCTION") >= 0, site())
    inference::run(comp, -1)
    test::suite_assert(ts, comp.diagnostics.error_count == 0 and node.inferred_type? == signature, site())
end


func test_throwing_type_identity(ts) -> void:
    store := types::Store{}
    integer := types::atom(store, types::Atom.INT)
    plain := must types::function(store, [integer], integer, false)
    throwing := must types::function(store, [integer], integer, true)
    repeated := must types::function(store, [integer], integer, true)
    test::suite_assert(ts, throwing == repeated and throwing != plain, site())
    test::suite_assert(ts, must types::format(store, plain) == "func(int) -> int", site())
    test::suite_assert(ts, must types::format(store, throwing) == "throws func(int) -> int", site())
end


func test_fail_restrictions(ts) -> void:
    test_regions::check_error(ts, "throws func bad():\n    fail()\nend\n", "call arity mismatch")
    test_regions::check_error(ts, "throws func bad():\n    fail(\"x\", 1, 2)\nend\n", "call arity mismatch")
    test_regions::check_error(ts, "throws func bad():\n    fail(true)\nend\n", "invalid fail argument")
    test_regions::check_error(ts, "throws func bad():\n    fail(1.5)\nend\n", "invalid fail argument")
    test_regions::check_error(ts, "throws func bad():\n    fail(1, 2)\nend\n", "invalid fail argument")
    test_regions::check_error(ts, "throws func bad():\n    fail(\"x\", false)\nend\n", "invalid fail argument")
    test_regions::check_error(ts, "func bad():\n    fail(0)\nend\n", "fail outside throwing function")
    test_regions::check_error(ts, "func bad():\n    while true:\n        fail(0)\n    end\nend\n", "fail outside throwing function")
    test_regions::check_error(ts, "throws func bad():\n    value := fail(0)\nend\n", "void value")
    test_regions::check_error(ts, "throws func failer():\n    fail(0)\nend\nfunc bad():\n    failer()\nend\n", "unhandled throwing call")
    test_regions::check_error(ts, "func bad(fail: int):\nend\n", "semantic analysis")
    test_regions::check_error(ts, "throws func bad() -> int:\n    fail(0)\nend\n", "type inference conflict")
end


func test_invalid_call_metadata(ts) -> void:
    text := "func target() -> int:\n    return 1\nend\nfunc caller() -> int:\n    return target()\nend\n"
    modes := [0, 1, 2]
    for mode in modes:
        comp := support::infer_source(text, -1)
        test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
        mod := comp.modules[0]
        caller := mod.ast.nodes[mod.ast.get_root_module().declarations[1]].kind.FUNCTION_DECL
        call := mod.ast.nodes[mod.ast.nodes[caller.body.statements[0]].kind.RETURN.value?].kind.CALL
        if mode == 0:
            call.target = Some{ast::DeclarationRef{source_id = 100, origin = 0}}[.call]
        elif mode == 1:
            call.target = Some{ast::DeclarationRef{source_id = 0, origin = -1}}[.call]
        else:
            call.target = Some{ast::DeclarationRef{source_id = 0, origin = mod.ast.root}}[.call]
        end
        typecheck::run(comp)
        test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
        test::suite_assert(ts, comp.diagnostics.messages[0].summary == "invalid call target", site())
    end
    unresolved := support::infer_source("throws func bad(message, code):\n    fail(message, code)\nend\n", -1)
    test::suite_assert(ts, unresolved.diagnostics.error_count > 0, site())
end


func test_cleanup_emission(ts) -> void:
    text := "throws func work(flag: bool) -> int:\n    values := [3, 4]\n    if flag:\n        fail(concat(\"failed\"), 0)\n    end\n    return len(values)\nend\nfunc main():\nend\n"
    code := must support::translate(text, "")
    test::suite_assert(ts, string::find(code, "JikError *jik_err_arg") >= 0, site())
    test::suite_assert(ts, string::find(code, "jik_error_set(jik_err_arg, jik_fail_code, jik_fail_message->data);") >= 0, site())
    test::suite_assert(ts, string::find(code, "jik_return_value = ") >= 0, site())
    test::suite_assert(ts, string::find(code, "jik_cleanup:;\n    jik_region_free(jik_local_region);\n    return jik_return_value;") >= 0, site())
    code_only := must support::translate("throws func bad():\n    fail(0)\nend\nfunc main():\nend\n", "")
    test::suite_assert(ts, string::find(code_only, "jik_error_set(jik_err_arg, jik_fail_code, \"\");") >= 0, site())
    test::suite_assert(ts, string::find(code_only, "jik_region_new") < 0, site())
    main := support::parse_source("throws func main():\nend\n")
    test::suite_assert(ts, main.diagnostics.error_count == 0, site())
    try support::translate("throws func main():\nend\n", ""):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_msg() == "semantic analysis failed", site())
    end
end


func run_tests(ts) -> void:
    println("[test] test_throwing")
    test_signatures_and_fail(ts)
    test_throwing_type_identity(ts)
    test_fail_restrictions(ts)
    test_invalid_call_metadata(ts)
    test_cleanup_emission(ts)
end
