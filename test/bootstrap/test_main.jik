use "jik/testing" as test
use "jik/string"

use "support"
use "../../src/bootstrap/semantic/typing/typecheck"
use "../../src/bootstrap/semantic/regions/regions"
use "../../src/bootstrap/language/types"
use "../../src/bootstrap/language/region_source"


func test_main_argument_inference(ts) -> void:
    comp := support::infer_source("func main(words):\n    first := words[0]\nend\n", 0)
    support::check_signature(ts, comp, "main", "func(Vec[String]) -> int")
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count == 0:
        mod := comp.modules[0]
        function := mod.ast.nodes[mod.global_scope.symbols["main"]?.origin].kind.FUNCTION_DECL
        argument := mod.ast.nodes[function.parameters[0]]
        test::suite_assert(ts, argument.region_source.kind == region_source::Kind.CALLER, site())
        test::suite_assert(ts, not function.needs_local_region, site())
    end
    ordinary := support::infer_source("func main(value: int) -> int:\n    return value\nend\n", -1)
    support::check_signature(ts, ordinary, "main", "func(int) -> int")
end


func test_main_wrapper_cleanup(ts) -> void:
    code := must support::translate("text := \"global\"\nfunc main(args):\n    local := concat(\"local\")\n    if len(args) > 1:\n        return 23\n    end\nend\n", "")
    test::suite_assert(ts, string::find(code, "int main(int argc, char **argv)") >= 0, site())
    test::suite_assert(ts, string::find(code, "jik_args->data[jik_i] = jik_string_new(argv[jik_i], jik_argument_region);") >= 0, site())
    call := string::find(code, "int jik_status = jik_m0_main(jik_args);")
    arguments_freed := string::find(code, "jik_region_free(jik_argument_region);")
    globals_freed := string::find(code, "jik_region_free(jik_global_region);")
    status := string::find(code, "return jik_status;")
    test::suite_assert(ts, call >= 0 and arguments_freed > call and globals_freed > arguments_freed and status > globals_freed, site())
end


func test_main_signature_restrictions(ts) -> void:
    sources := [
        "func main(args: int):\nend\n",
        "func main(args: Vec[int]):\nend\n",
        "func main(args) -> String:\n    return \"bad\"\nend\n",
        "func main(args):\n    return\nend\n"
    ]
    for source in sources:
        comp := support::infer_source(source, 0)
        test::suite_assert(ts, comp.diagnostics.error_count > 0, site())
    end
end


func run_tests(ts) -> void:
    println("[test] test_main")
    test_main_argument_inference(ts)
    test_main_wrapper_cleanup(ts)
    test_main_signature_restrictions(ts)
end
