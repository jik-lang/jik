use "jik/io"
use "jik/fs"
use "jik/std"
use "jik/string"
use "jik/sys"
use "jik/testing" as test

func compiler_command(r: Region):
    selected := sys::getenv("JIK_TEST_COMPILER", r)
    if selected is Some and len(selected?) > 0:
        if sys::platform() == "windows":
            return string::replace(selected?, "/", "\\", r)
        end
        return selected?
    end
    std::panic("JIK_TEST_COMPILER is required; use make test-boot or select the compiler explicitly.\n")
end

func write_string_to_file(foreign path: String, foreign s: String):
    f := must io::open(path, "w", _)
    must io::write(f, s)
    must io::close(f)
end

func remove_if_exists(foreign path: String):
    try fs::remove_file(path):
    except:
    end
end

func compile_fail_cmd(foreign src_path: String, foreign out_path: String, r):
    return concat(compiler_command(r), " tran ", src_path, " --out test/bootstrap/language/tmp/translation.c > ", out_path, " 2>&1", r)
end

func compile_check_cmd(foreign src_path: String, foreign out_path: String, r):
    return concat(compiler_command(r), " check ", src_path, " > ", out_path, " 2>&1", r)
end

func report_compile_failure(foreign source: String, foreign expected: String, foreign out: String, status: int):
    if status == 0:
        println("Unexpected compilation success:\n", source)
    end
    println("Expected error: ", expected)
    println("Compiler output:\n", out)
end

func assert_compile_succeeds_source(ts, foreign prog: String):
    src_path := "test/bootstrap/language/tmp/cs_temp.jik"
    out_path := "test/bootstrap/language/tmp/cs_temp.out"
    remove_if_exists(src_path)
    remove_if_exists(out_path)
    write_string_to_file(src_path, prog)

    status := sys::system(compile_check_cmd(src_path, out_path, _))
    if status != 0:
        println("Expected successful check. Compiler output:\n", must io::read_file(out_path, _))
    end
    test::suite_assert(ts, status == 0, site())

    remove_if_exists(src_path)
    remove_if_exists(out_path)
end

func assert_compile_fail_file(ts, foreign src_path: String, foreign expected: String):
    out_path := "test/bootstrap/language/tmp/cf_temp.out"
    remove_if_exists(out_path)

    status := sys::system(compile_fail_cmd(src_path, out_path, _))
    f := must io::open(out_path, "r", _)
    out := must io::read(f, _)
    must io::close(f)
    matched := string::find(out, expected) != -1
    if status == 0 or not matched:
        report_compile_failure(src_path, expected, out, status)
    end
    test::suite_assert(ts, status != 0, site())
    test::suite_assert(ts, matched, site())

    remove_if_exists(out_path)
    remove_if_exists("test/bootstrap/language/tmp/translation.c")
end

func assert_compile_fail_source(ts, foreign prog: String, foreign expected: String):
    src_path := "test/bootstrap/language/tmp/cf_temp.jik"
    out_path := "test/bootstrap/language/tmp/cf_temp.out"
    remove_if_exists(src_path)
    remove_if_exists(out_path)
    write_string_to_file(src_path, prog)

    status := sys::system(compile_fail_cmd(src_path, out_path, _))
    f := must io::open(out_path, "r", _)
    out := must io::read(f, _)
    must io::close(f)
    matched := string::find(out, expected) != -1
    // Module identity is independent of the diagnostic's platform separators.
    if string::starts_with(expected, "reuse of module "):
        matched = string::find(string::replace(out, "\\", "/", _), expected) != -1
    end
    if status == 0 or not matched:
        report_compile_failure(prog, expected, out, status)
    end
    test::suite_assert(ts, status != 0, site())
    test::suite_assert(ts, matched, site())

    remove_if_exists(src_path)
    remove_if_exists(out_path)
    remove_if_exists("test/bootstrap/language/tmp/translation.c")
end

func assert_compile_fails_source(ts, foreign prog: String):
    src_path := "test/bootstrap/language/tmp/temp.jik"
    out_path := "test/bootstrap/language/tmp/cf_temp.out"
    remove_if_exists(src_path)
    remove_if_exists(out_path)
    write_string_to_file(src_path, prog)
    status := sys::system(compile_fail_cmd(src_path, out_path, _))
    if status == 0:
        println("Unexpected compilation success:\n", prog)
    end
    test::suite_assert(ts, status != 0, site())
    remove_if_exists(src_path)
    remove_if_exists(out_path)
    remove_if_exists("test/bootstrap/language/tmp/translation.c")
end
