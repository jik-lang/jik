use "jik/testing" as test
use "jik/string"

use "../../src/bootstrap/program"
use "support"
use "../../src/bootstrap/language/builtin"
use "../../src/bootstrap/language/types"
use "../../src/bootstrap/semantic/typing/typecheck"
use "../../src/bootstrap/semantic/regions/regions"


func analyze(foreign text: String, r: Region) -> program::Program:
    comp := support::infer_source(text, -1, r)
    typecheck::run(comp)
    regions::run(comp)
    return comp
end


func test_variadic_calls_and_lifetimes(ts) -> void:
    text := "func borrowed(value: String):\n    print(value)\nend\nfunc number(value: int):\n    println(value)\nend\nfunc vector(value: Vec[String]):\n    println(value)\nend\nfunc empty():\n    print()\n    println()\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    expected_frames := [false, true, true, false]
    for index, id in root.declarations:
        function := mod.ast.nodes[id].kind.FUNCTION_DECL
        test::suite_assert(ts, function.is_region_safe, site())
        test::suite_assert(ts, function.needs_local_region == expected_frames[index], site())
        for statement in function.body.statements:
            node := mod.ast.nodes[statement]
            test::suite_assert(ts, node.kind.CALL.builtin is Some and builtin::is_output(node.kind.CALL.builtin?), site())
            test::suite_assert(ts, node.inferred_type? == types::atom(mod.type_store, types::Atom.VOID), site())
        end
    end
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    for index, id in root.declarations:
        test::suite_assert(ts, mod.ast.nodes[id].kind.FUNCTION_DECL.needs_local_region == expected_frames[index], site())
    end
end


func test_rejections(ts) -> void:
    inputs := [
        "func main():\n    println(_)\nend\n",
        "func invalid(value: Site):\n    print(value)\nend\n",
        "func invalid(value: Vec[Site]):\n    print(value)\nend\n",
        "func main():\n    values := [1]\n    print(clear(values))\nend\n",
        "func main():\n    value := println(42)\nend\n",
        "func main():\n    print := 1\nend\n",
        "func invalid(println: int):\n    return println\nend\n",
        "func main():\n    println(42, missing)\nend\n"
    ]
    expected := ["unsupported print type", "unsupported print type", "unsupported print type", "void value", "void value", "semantic analysis", "semantic analysis", "semantic analysis"]
    for index, text in inputs:
        comp := analyze(text)
        test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
        if comp.diagnostics.error_count == 1:
            test::suite_assert(ts, comp.diagnostics.messages[0].summary == expected[index], site())
            test::suite_assert(ts, comp.diagnostics.messages[0].span is Some, site())
        end
    end
end


func test_codegen_and_cleanup(ts) -> void:
    text := "func returning(value: String) -> String:\n    println(42)\n    return value\nend\nfunc main():\n    println([[1], [2]])\n    print()\n    println()\n    result := returning(\"borrowed\")\n    return 0\nend\n"
    translation := must support::translate(text, "", _)
    test::suite_assert(ts, string::find(translation, "jik_print(NULL, 0)") >= 0, site())
    test::suite_assert(ts, string::find(translation, "jik_println(NULL, 0)") >= 0, site())
    test::suite_assert(ts, string::find(translation, "static JikString *jik_vec_vec_int32_t_tostr") >= 0, site())
    test::suite_assert(ts, string::find(translation, "jik_int_tostr(42, jik_local_region)") >= 0, site())
    captured := string::find(translation, "jik_return_value = jik_v_value;")
    destroyed := string::find(translation, "jik_region_free(jik_local_region);")
    returned := string::find(translation, "return jik_return_value;")
    test::suite_assert(ts, captured >= 0 and destroyed > captured and returned > destroyed, site())

    borrowed := must support::translate("func show(value: String):\n    println(value)\nend\nfunc main():\n    println()\n    return 0\nend\n", "", _)
    test::suite_assert(ts, string::find(borrowed, "jik_region_new") < 0, site())
    test::suite_assert(ts, string::find(borrowed, "jik_println((JikString *[]){jik_v_value}, 1)") >= 0, site())
end


func test_callable_override(ts) -> void:
    comp := analyze("func print(value: int) -> int:\n    return value\nend\nfunc main():\n    return print(42)\nend\n")
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    for node in comp.modules[0].ast.nodes:
        if node.kind is CALL:
            test::suite_assert(ts, node.kind.CALL.builtin is None and node.kind.CALL.target is Some, site())
        end
    end
end


func test_opaque_values(ts) -> void:
    text := "extern struct NativeHandle as Handle\nextern init func native_new as new(r: Region) -> Handle\nstruct Holder:\n    handle: Handle\nend\nvariant Choice:\n    Value: Handle\nend\nfunc show(value: Handle, holder: Holder, choice: Choice, optional: Option[Handle], values: Vec[Handle], lookup: Dict[Handle]):\n    println(value, holder, choice, optional, values, lookup)\nend\n"
    comp := analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
end


func run_tests(ts) -> void:
    println("[test] test_printing")
    test_variadic_calls_and_lifetimes(ts)
    test_rejections(ts)
    test_codegen_and_cleanup(ts)
    test_callable_override(ts)
    test_opaque_values(ts)
end
