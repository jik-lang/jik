use "jik/testing" as test
use "jik/argparse" as ap
use "jik/bytes"
use "jik/io"
use "jik/path"
use "jik/process"
use "jik/string"

use "../../src/jik/cli/run" as run_command
use "../../src/jik/cli/build" as build_command
use "../../src/jik/cli/tran" as tran_command
use "../../src/jik/cli/utils" as cli_utils
use "../../src/jik/compiler"
use "language/utils"


func text(value: bytes::Bytes) -> String:
    decoded := must bytes::to_string_ascii(value, .value)
    return string::replace(decoded, "\r\n", "\n", .value)
end


func check_regions(foreign ts: test::TestSuite, result: process::Result):
    test::suite_assert(ts, result.code == 0 and text(result.out) == "42\n", site())
    diagnostic := text(result.err)
    test::suite_assert(ts, string::contains(diagnostic, "region stats") and string::contains(diagnostic, "alive=0"), site())
    test::suite_assert(ts, string::contains(diagnostic, "region lifetime tree") and string::contains(diagnostic, "main.arguments"), site())
    // Early return, throwing cleanup and fallthrough must leave sibling regions
    // at the same depth. Ignore generated names, region IDs and allocation counts.
    depth := -1
    seen := 0
    for line in string::split(diagnostic, "\n"):
        if string::contains(line, "::early.local") or string::contains(line, "::faulty.local") or string::contains(line, "::normal.local"):
            current := string::find(line, "R")
            if depth < 0:
                depth = current
            end
            test::suite_assert(ts, current == depth and depth > 0, site())
            seen += 1
        end
    end
    test::suite_assert(ts, seen == 3, site())
end


func test_configuration(ts: test::TestSuite):
    parsers := [build_command::make_parser(), run_command::make_parser(), tran_command::make_parser()]
    for parser in parsers:
        config := compiler::Config{}
        defaults := must ap::parse(parser, ["input.jik"])
        cli_utils::apply_options(config, defaults)
        test::suite_assert(ts, not config.region_stats and not config.region_tree and not config.unsafe_no_bounds_checks and not config.verbose and not config.dump_ast, site())
        enabled := must ap::parse(parser, ["input.jik", "--region-stats", "--region-tree", "--unsafe-no-bounds-checks", "--verbose", "--dump-ast"])
        cli_utils::apply_options(config, enabled)
        test::suite_assert(ts, config.region_stats and config.region_tree and config.unsafe_no_bounds_checks and config.verbose and config.dump_ast, site())
    end
end


func check_stage_order(ts: test::TestSuite, foreign diagnostic: String, foreign stages: Vec[String]):
    previous := -1
    for stage in stages:
        offset := string::find(diagnostic, stage)
        test::suite_assert(ts, offset > previous, site())
        if offset < 0:
            return
        end
        previous = offset
    end
end


func test_verbose_failures(ts: test::TestSuite, foreign tool: String):
    lexical := must process::capture(tool, ["check", "test/jik/input/diagnostics/lexical.jik", "--verbose"])
    lexical_error := text(lexical.err)
    test::suite_assert(ts, lexical.code != 0 and bytes::len(lexical.out) == 0, site())
    test::suite_assert(ts, string::starts_with(lexical_error, "jik: lex and parse sources\n"), site())
    test::suite_assert(ts, not string::contains(lexical_error, "jik: analyze program"), site())
    unresolved := must process::capture(tool, ["check", "test/jik/input/preview/invalid.jik", "--verbose"])
    resolution_error := text(unresolved.err)
    test::suite_assert(ts, unresolved.code != 0 and bytes::len(unresolved.out) == 0, site())
    test::suite_assert(ts, string::contains(resolution_error, "jik: analyze program") and not string::contains(resolution_error, "jik: check regions"), site())
    inferred := must process::capture(tool, ["check", "test/jik/input/inference/unanchored_recursion.jik", "--verbose"])
    inference_error := text(inferred.err)
    test::suite_assert(ts, inferred.code != 0 and bytes::len(inferred.out) == 0, site())
    test::suite_assert(ts, string::contains(inference_error, "jik: analyze program"), site())
    test::suite_assert(ts, not string::contains(inference_error, "jik: check regions"), site())
end


func run_tests(ts: test::TestSuite):
    println("[test] test_runtime_options")
    test_configuration(ts)
    tool := utils::compiler_command(_)
    workspace := must cli_utils::make_workspace()
    source := "test/jik/input/runtime_options/main.jik"
    generated := path::join([workspace, "runtime.c"])
    // Execute instrumentation once. Other commands share its configuration and
    // code generation; their option registration is checked above.
    check_regions(ts, must process::capture(tool, ["run", source, "--region-stats", "--region-tree"]))
    translated := must process::capture(tool, ["tran", source, "--out", generated, "--embed-core", "--region-stats", "--region-tree", "--verbose"])
    test::suite_assert(ts, translated.code == 0 and bytes::len(translated.out) == 0 and bytes::len(translated.err) > 0, site())
    translation := must io::read_file(generated)
    test::suite_assert(ts, string::contains(translation, "#define JIK_REGION_STATS") and string::contains(translation, "jik_region_tree_enter("), site())
    bounds := "test/jik/input/runtime_options/bounds.jik"
    checked := must process::capture(tool, ["run", bounds])
    unchecked := must process::capture(tool, ["run", bounds, "--unsafe-no-bounds-checks"])
    test::suite_assert(ts, checked.code == 0 and text(checked.out) == "42 checked\n" and bytes::len(checked.err) == 0, site())
    test::suite_assert(ts, unchecked.code == 0 and text(unchecked.out) == "42 unchecked\n" and bytes::len(unchecked.err) == 0, site())
    quiet := must process::capture(tool, ["check", source])
    verbose := must process::capture(tool, ["check", source, "--verbose"])
    test::suite_assert(ts, quiet.code == 0 and verbose.code == 0 and bytes::len(quiet.out) == 0 and bytes::len(verbose.out) == 0, site())
    test::suite_assert(ts, bytes::len(quiet.err) == 0 and string::ends_with(text(verbose.err), "jik: check regions\n"), site())
    test::suite_assert(ts, not string::contains(text(verbose.err), "check passed"), site())
    test::suite_assert(ts, text(verbose.err) == "jik: lex and parse sources\njik: analyze program\njik: check regions\n", site())
    test_verbose_failures(ts, tool)
    imported := must process::capture(tool, ["check", "test/jik/input/preview/main.jik", "--verbose"])
    test::suite_assert(ts, imported.code == 0 and bytes::len(imported.out) == 0, site())
    // Imported modules must not add per-module progress messages.
    test::suite_assert(ts, text(imported.err) == text(verbose.err), site())
    executed := must process::capture(tool, ["run", source, "--release", "--ccflags", "-DJIK_VERBOSE_TEST=1", "--verbose"])
    execution_log := text(executed.err)
    test::suite_assert(ts, executed.code == 0 and text(executed.out) == "42\n", site())
    check_stage_order(ts, execution_log, ["jik: check regions", "jik: generate C", "jik: write output: ", "jik: compile ", "jik: run "])
    test::suite_assert(ts, string::contains(execution_log, "-O3") and string::contains(execution_log, "-DJIK_VERBOSE_TEST=1"), site())
    test::suite_assert(ts, string::contains(execution_log, "program.c") and string::contains(execution_log, "program.exe"), site())
    dumped := must process::capture(tool, ["check", source, "--dump-ast"])
    test::suite_assert(ts, dumped.code == 0 and bytes::len(dumped.err) == 0, site())
    test::suite_assert(ts, string::starts_with(text(dumped.out), "[AST: ") and not string::contains(text(dumped.out), "check passed"), site())
    must cli_utils::cleanup_workspace(workspace)
end
