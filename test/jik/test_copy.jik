use "jik/testing" as test

use "../../src/jik/semantic/typing/rules"
use "support"
use "test_regions"
use "../../src/jik/language/builtin"
use "../../src/jik/language/region_source"
use "../../src/jik/semantic/typing/typecheck"
use "../../src/jik/semantic/regions/regions"
use "../../src/jik/language/types"


func test_copy_regions(ts) -> void:
    text := "func duplicate(foreign source: Vec[String], r: Region) -> Vec[String]:\n    local := copy(source)\n    return copy(local, r)\nend\n"
    comp := support::infer_source(text, -1)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    function := mod.ast.nodes[mod.ast.get_root_module().declarations[0]].kind.FUNCTION_DECL
    local := mod.ast.nodes[function.body.statements[0]]
    call := mod.ast.nodes[local.kind.LOCAL_DECL.initializer?]
    test::suite_assert(ts, call.kind.CALL.builtin? == builtin::Kind.COPY, site())
    test::suite_assert(ts, call.kind.CALL.auto_region and len(call.kind.CALL.arguments) == 2, site())
    test::suite_assert(ts, call.region_source.kind == region_source::Kind.LOCAL and function.needs_local_region, site())
    returned := mod.ast.nodes[mod.ast.nodes[function.body.statements[1]].kind.RETURN.value?]
    test::suite_assert(ts, returned.region_source.kind == region_source::Kind.CALLER, site())
    test::suite_assert(ts, returned.region_source.parameter_id == function.parameters[1], site())
    test::suite_assert(ts, returned.inferred_type? == mod.ast.nodes[function.parameters[0]].inferred_type?, site())
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0 and returned.region_source.parameter_id == function.parameters[1], site())
end


func test_copy_restrictions(ts) -> void:
    test_regions::check_error(ts, "func bad():\n    value := copy(1)\nend\n", "unsupported copy type")
    test_regions::check_error(ts, "func bad():\n    value := copy([[1]])\nend\n", "unsupported copy type")
    test_regions::check_error(ts, "func bad(source: String) -> String:\n    return copy(source)\nend\n", "cannot return local allocation")
    test_regions::check_error(ts, "func bad(foreign source: String) -> String:\n    return copy(source, .source)\nend\n", "cannot return foreign composite value")
end


func test_copy_type_boundary(ts) -> void:
    store := types::Store{}
    types::initialize(store)
    integer := types::atom(store, types::Atom.INT)
    text := types::atom(store, types::Atom.STRING)
    vector := must types::container(store, types::Container.VECTOR, text)
    nested := must types::container(store, types::Container.VECTOR, vector)
    external := must types::named(store, types::NamedKind.EXTERN_STRUCT, 0, 1, "Handle")
    test::suite_assert(ts, rules::is_copyable(store, text) and rules::is_copyable(store, vector), site())
    test::suite_assert(ts, not rules::is_copyable(store, integer), site())
    test::suite_assert(ts, not rules::is_copyable(store, nested), site())
    test::suite_assert(ts, not rules::is_copyable(store, external), site())
end


func test_copy_safe_store(ts) -> void:
    text := "func append(values: Vec[String], text: String):\n    push(values, copy(text, .values))\nend\nfunc invoke(values: Vec[String]):\n    local := \"local\"\n    append(values, local)\nend\n"
    comp := support::infer_source(text, -1)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count == 0:
        mod := comp.modules[0]
        append := mod.ast.nodes[mod.ast.get_root_module().declarations[0]].kind.FUNCTION_DECL
        test::suite_assert(ts, append.is_region_safe, site())
    end
    test_regions::check_error(ts, "func append(values: Vec[String], text: String, r: Region):\n    push(values, copy(text, r))\nend\nfunc invoke(values: Vec[String]):\n    local := \"local\"\n    append(values, local, _)\nend\n", "region mismatch")
end


func run_tests(ts) -> void:
    println("[test] test_copy")
    test_copy_regions(ts)
    test_copy_restrictions(ts)
    test_copy_type_boundary(ts)
    test_copy_safe_store(ts)
end
