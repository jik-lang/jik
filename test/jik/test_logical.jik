use "jik/string"
use "jik/testing" as test

use "support"
use "../../src/jik/parser/ast"
use "../../src/jik/parser/format"
use "../../src/jik/semantic/typing/typecheck"
use "../../src/jik/language/types"


func test_precedence(ts) -> void:
    parsed := support::parse_source("func main():\n    value := not false and true or false if true else false if false else true\nend\n", _)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    root := parsed.ast.get_root_module()
    function := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL
    initializer := parsed.ast.nodes[function.body.statements[0]].kind.LOCAL_DECL.initializer?
    node := parsed.ast.nodes[initializer]
    test::suite_assert(ts, node.kind is CONDITIONAL, site())
    selection := node.kind.CONDITIONAL
    logical := parsed.ast.nodes[selection.when_true].kind.BINARY
    test::suite_assert(ts, logical.op == ast::BinaryOp.OR, site())
    conjunction := parsed.ast.nodes[logical.left].kind.BINARY
    test::suite_assert(ts, conjunction.op == ast::BinaryOp.AND, site())
    test::suite_assert(ts, parsed.ast.nodes[conjunction.left].kind.UNARY.op == ast::UnaryOp.NOT, site())
    test::suite_assert(ts, parsed.ast.nodes[selection.when_false].kind is CONDITIONAL, site())
    text := format::format(parsed.ast)
    test::suite_assert(ts, string::find(text, "CONDITIONAL") >= 0, site())
end


func test_inferred_results(ts) -> void:
    comp := support::infer_source("func logical(left, right):\n    return left and right or false\nend\nfunc select(flag: bool):\n    return 1 if flag else 2.5\nend\nfunc exact(value, flag: bool) -> int:\n    return value if flag else 42\nend\nfunc boolean(value, flag: bool):\n    return value if flag else true\nend\n", -1)
    support::check_signature(ts, comp, "logical", "func(bool, bool) -> bool")
    support::check_signature(ts, comp, "select", "func(bool) -> double")
    support::check_signature(ts, comp, "exact", "func(int, bool) -> int")
    support::check_signature(ts, comp, "boolean", "func(bool, bool) -> bool")
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    // A double result cannot choose the type of an unconstrained numeric branch.
    ambiguous := support::infer_source("func ambiguous(value, flag: bool) -> double:\n    return value if flag else 1.0\nend\n", -1)
    test::suite_assert(ts, ambiguous.diagnostics.error_count == 1, site())
    test::suite_assert(ts, ambiguous.diagnostics.messages[0].summary == "unresolved type", site())
end


func test_checker_independence(ts) -> void:
    comp := support::infer_source("func select(flag: bool):\n    return 1 if flag else 2.5\nend\n", -1)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is CONDITIONAL:
            node.inferred_type = Some{types::atom(mod.type_store, types::Atom.INT)}[.node]
        end
    end
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count > 0, site())
    test::suite_assert(ts, comp.diagnostics.messages[0].summary == "type mismatch", site())
end


func run_tests(ts) -> void:
    println("[test] test_logical")
    test_precedence(ts)
    test_inferred_results(ts)
    test_checker_independence(ts)
end
