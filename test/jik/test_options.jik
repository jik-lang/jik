use "jik/testing" as test

use "support"
use "test_strings"
use "../../src/jik/parser/ast"
use "../../src/jik/language/types"
use "../../src/jik/semantic/typing/typecheck"
use "../../src/jik/language/region_source"


func test_context_and_types(ts) -> void:
    text := "struct Box:\n    value: Option[String]\nend\nfunc missing(r: Region) -> Option[int]:\n    return None\nend\nfunc read(value: Option[int]) -> int:\n    return unwrap(value) if value is Some else 0\nend\nfunc main():\n    integer := Some{7}\n    absent: Option[int]\n    absent = None\n    nested: Option[Option[int]] = Some{None}\n    values := [None, integer, None]\n    choice := None if true else integer\n    default_box: Box\n    box := Box{value = None}\n    return read(None)\nend\n"
    comp := test_strings::analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is OPTION_LITERAL:
            element := types::option_element(mod.type_store, node.inferred_type?)
            test::suite_assert(ts, element is Some, site())
            literal := node.kind.OPTION_LITERAL
            if literal.value is Some and element is Some:
                test::suite_assert(ts, mod.ast.nodes[literal.value?].inferred_type? == element?, site())
            end
        elif node.kind is OPTION_CHECK:
            test::suite_assert(ts, node.inferred_type? == types::atom(mod.type_store, types::Atom.BOOL), site())
        end
    end
end


func test_regions_and_recursion(ts) -> void:
    text := "struct Node:\n    text: String\n    next: Option[Node]\nend\nfunc make(r: Region) -> Option[Node]:\n    result := Some{Node{text = \"caller\"}}@\n    return result\nend\nfunc read(left: Option[Node], right: Option[Node]) -> bool:\n    return left is Some and right is Some and left?.text == unwrap(right).text\nend\nfunc take(value: Option[Node]) -> Node:\n    return value?\nend\nfunc main():\n    value := make()\n    return 42\nend\n"
    comp := test_strings::analyze(text)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    make := mod.ast.nodes[root.declarations[1]].kind.FUNCTION_DECL
    read := mod.ast.nodes[root.declarations[2]].kind.FUNCTION_DECL
    take := mod.ast.nodes[root.declarations[3]].kind.FUNCTION_DECL
    test::suite_assert(ts, not make.needs_local_region and not make.is_region_safe, site())
    test::suite_assert(ts, read.is_region_safe and not read.needs_local_region, site())
    test::suite_assert(ts, not take.is_region_safe and not take.needs_local_region, site())
    for node in mod.ast.nodes:
        if node.kind is OPTION_LITERAL or node.kind is STRUCT_LITERAL or node.kind is STRING_LITERAL or node.kind is DEFAULT_VALUE:
            test::suite_assert(ts, node.region_source.kind == region_source::Kind.CALLER, site())
            test::suite_assert(ts, node.allocation_target is Some, site())
        elif node.kind is UNWRAP:
            test::suite_assert(ts, node.region_source.kind == region_source::Kind.CALLER, site())
        end
    end
end


func test_errors(ts) -> void:
    test_strings::check_error(ts, "func bad():\n    value := None\nend\n", "unresolved type")
    test_strings::check_error(ts, "func bad():\n    value: int = None\nend\n", "invalid option type")
    test_strings::check_error(ts, "func bad():\n    value: Option[int] = Some{true}\nend\n", "type inference conflict")
    test_strings::check_error(ts, "func bad():\n    value: Option[int] = Some{1.5}\nend\n", "type inference conflict")
    test_strings::check_error(ts, "func bad():\n    value := 1?\nend\n", "invalid unwrap")
    test_strings::check_error(ts, "func bad():\n    value := unwrap(1)\nend\n", "invalid unwrap")
    test_strings::check_error(ts, "func bad():\n    value := 1 is Some\nend\n", "invalid option check")
    test_strings::check_error(ts, "func bad():\n    value := unwrap()\nend\n", "call arity mismatch")
    test_strings::check_error(ts, "func bad():\n    value := unwrap(Some{1}, Some{2})\nend\n", "call arity mismatch")
    test_strings::check_error(ts, "func bad(r: Region) -> Option[String]:\n    text := \"local\"\n    return Some{text}\nend\n", "region mismatch")
    test_strings::check_error(ts, "func bad(r: Region) -> String:\n    value := Some{\"local\"}\n    return value?\nend\n", "cannot return local allocation")
    test_strings::check_error(ts, "func bad(r: Region) -> String:\n    value := Some{\"local\"}\n    return unwrap(value)\nend\n", "cannot return local allocation")
    test_strings::check_error(ts, "func bad(value: Option[int]):\n    value = None\nend\n", "region mismatch")
    test_strings::check_error(ts, "func bad():\n    value: Option[Region]\nend\n", "invalid option type")
    test_strings::check_error(ts, "func bad(value: Option[Region]):\nend\n", "invalid option type")
    test_strings::check_error(ts, "func bad() -> Option[void]:\n    return None\nend\n", "invalid option type")
    test_strings::check_error(ts, "struct Invalid:\n    value: Option[void]\nend\n", "invalid option type")
end


func test_checked_metadata(ts) -> void:
    comp := support::infer_source("func read(value: Option[int]) -> int:\n    return value?\nend\n", -1)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is UNWRAP:
            node.inferred_type = Some{types::atom(mod.type_store, types::Atom.BOOL)}[.node]
        end
    end
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count > 0, site())
end


func test_parser_recovery(ts) -> void:
    parsed := support::parse_source("func main(r: Region):\n    invalid := Some{\"nested\"[r]}\n    valid := Some{7}[r]\n    return 42\nend\n")
    test::suite_assert(ts, parsed.diagnostics.error_count == 1, site())
    root := parsed.ast.get_root_module()
    test::suite_assert(ts, len(root.declarations) == 1, site())
    if len(root.declarations) == 1:
        test::suite_assert(ts, len(parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL.body.statements) == 2, site())
    end
end


func run_tests(ts) -> void:
    println("[test] test_options")
    test_context_and_types(ts)
    test_regions_and_recursion(ts)
    test_errors(ts)
    test_checked_metadata(ts)
    test_parser_recovery(ts)
end
