use "jik/testing" as test
use "jik/argparse" as ap
use "jik/bytes"
use "jik/fs"
use "jik/io"
use "jik/path"
use "jik/process"
use "jik/string"
use "jik/sys"

use "../../src/jik/cli/commands/run" as run_command
use "../../src/jik/cli/utils" as cli_utils
use "language/utils"
use "test_help_env" as helpers


func check_run(ts: test::TestSuite, foreign tool: String, foreign args: Vec[String], status: int, foreign output: String, foreign diagnostic: String, foreign temporary: String):
    result := must process::capture(tool, args)
    out := must bytes::to_string_ascii(result.out)
    err := must bytes::to_string_ascii(result.err)
    if result.code != status or not string::contains(err, diagnostic):
        println("run ", args, " => ", result.code, "\n", out, err)
    end
    test::suite_assert(ts, result.code == status, site())
    test::suite_assert(ts, string::replace(out, "\r\n", "\n") == output, site())
    if diagnostic != "":
        test::suite_assert(ts, string::contains(err, diagnostic), site())
    end
    // Inspect the whole isolated temp root, not internal generated filenames.
    test::suite_assert(ts, len(must fs::read_dir(temporary)) == 0, site())
end


func run_tests(ts: test::TestSuite):
    println("[test] test_run_command")
    // Argument rejection belongs to the parser and needs no child process.
    parser := run_command::make_parser()
    forms := [["main.jik", "extra-program-argument"]]
    for args in forms:
        try ap::parse(parser, args):
            test::suite_assert(ts, false, site())
        except:
            test::suite_assert(ts, string::contains(error_msg(), "unexpected positional"), site())
        end
    end
    tool := utils::compiler_command(_)
    workspace := must cli_utils::make_workspace()
    temporary := path::join([workspace, "temporary files with spaces"])
    must fs::mkdir(temporary)
    source := path::join([workspace, "source with spaces.jik"])
    must fs::copy_file("test/jik/input/run_command/main.jik", source)
    must fs::copy_file("test/jik/input/run_command/payload.txt", path::join([workspace, "payload.txt"]))
    adjacent := [path::join([workspace, "source with spaces.c"]), path::join([workspace, "source with spaces.exe"]), path::join([workspace, "source with spaces"])]
    for file in adjacent:
        must io::write_file(file, "preserve adjacent output")
    end
    old_tmp := sys::getenv("TMP")
    old_temp := sys::getenv("TEMP")
    old_tmpdir := sys::getenv("TMPDIR")
    assert(helpers::set_environment("TMP", temporary, true) == 0)
    assert(helpers::set_environment("TEMP", temporary, true) == 0)
    assert(helpers::set_environment("TMPDIR", temporary, true) == 0)

    // Real compilations cover spaced paths, output streams, copying, and
    // nonzero child status, including cleanup after the copied program exits.
    check_run(ts, tool, ["run", source], 7, "argc=1\ncopied payload\n", "child stderr", temporary)
    check_run(ts, tool, ["run", source, "--"], 7, "argc=1\ncopied payload\n", "child stderr", temporary)
    check_run(ts, tool, ["run", source, "--release", "--", "hello world", "", "--cc", "--", "a\"b", "C:\\path with spaces\\", "&|<>"], 7,
        "argc=8\narg=hello world\narg=\narg=--cc\narg=--\narg=a\"b\narg=C:\\path with spaces\\\narg=&|<>\ncopied payload\n", "child stderr", temporary)
    check_run(ts, tool, ["run", "--", "extra-program-argument"], 1, "", "missing input file", temporary)
    check_run(ts, tool, ["run", source, "--unknown", "--", "argument"], 1, "", "unknown option", temporary)
    check_run(ts, tool, ["run", "test/jik/input/run_command/copy_failure.jik"], 1, "", "could not copy native requirement", temporary)
    check_run(ts, tool, ["run", "test/jik/input/diagnostics/lexical.jik"], 1, "", "unexpected character", temporary)
    check_run(ts, tool, ["run", source, "--cc", "__jik_missing_run_cc__"], 1, "", "could not start process", temporary)

    helpers::restore_environment("TMP", old_tmp)
    helpers::restore_environment("TEMP", old_temp)
    helpers::restore_environment("TMPDIR", old_tmpdir)
    for file in adjacent:
        test::suite_assert(ts, must io::read_file(file) == "preserve adjacent output", site())
    end
    must fs::remove_dir(temporary)
    must cli_utils::cleanup_workspace(workspace)
end
