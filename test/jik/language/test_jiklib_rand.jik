use "jik/testing" as test
use "jik/rand"


func test_determinism_int(ts):
    r1 := rand::new(12345, _)
    r2 := rand::new(12345, _)

    failed := false
    for i = 0, 1000:
        if rand::next_int(r1) != rand::next_int(r2):
            failed = true
            break
        end
    end
    test::suite_assert(ts, not failed, site())
end


func test_determinism_double(s):
    r1 := rand::new(-7, _)
    r2 := rand::new(-7, _)

    failed := false
    for i = 0, 1000:
        if rand::next_double(r1) != rand::next_double(r2):
            failed = true
            break
        end
    end
    test::suite_assert(s, not failed, site())
end


func test_next_double_range(s):
    r := rand::new(1, _)
    failed := false
    for i = 0, 10000:
        x := rand::next_double(r)
        if x < 0.0 or x >= 1.0:
            failed = true
            break
        end
    end
    test::suite_assert(s, not failed, site())
end


func test_range_int_bounds(s):
    r := rand::new(999, _)

    lo := -10
    hi := 17

    failed := false
    for i = 0, 50000:
        try x := rand::range_int(r, lo, hi):
            if x < lo or x >= hi:
                failed = true
                break
            end
        except:
            failed = true
            break
        end
    end
    test::suite_assert(s, not failed, site())
end


func run_tests(ts):    
    println("[test] language/test_jiklib_rand")
    test_determinism_int(ts)
    test_determinism_double(ts)
    test_next_double_range(ts)
    test_range_int_bounds(ts)
    rng := rand::new_time()
    test::suite_assert(ts, rand::next_int(rng) >= 0, site())
    try value := rand::range_int(rng, 3, 3):
        test::suite_assert(ts, false, site())
    except:
        test::suite_assert(ts, error_code() != 0, site())
    end
end
