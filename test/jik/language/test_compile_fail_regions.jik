use "jik/testing" as test

use "utils"

func run_tests(ts):
    println("[test] language/test_compile_fail_regions")

    // Returning local region
    utils::assert_compile_fails_source(ts,
"""
func foo():
    x := [3 of 0]
    return x
end


func main():
    res := foo()
end   
"""
    )

    // Composite literal cannot transfer a local value into a caller-owned region
    utils::assert_compile_fail_source(ts,
"""
func pack(a: String, b: String):
    values := [a, b][.a]
end

func outer(a: String):
    b := "local"
    pack(a, b)
end

func main():
    outer("caller")
end
""",
        "all storing/returning call arguments must belong to the same region"
    )

    // A call literal must not be implicitly promoted into the global region.
    utils::assert_compile_fail_source(ts,
"""
struct Log:
    entries: Vec[String]
end

GLOBAL_LOG := Log{entries = [0 of ""]}

func record(text: String, log: Log):
    push(log.entries, text)
end

func main():
    record("entry", GLOBAL_LOG)
end
""",
        "all storing/returning call arguments must belong to the same region"
    )

    // A local literal cannot be implicitly promoted while storing into a global container.
    utils::assert_compile_fail_source(ts,
"""
items := [1 of ""]

func main():
    items[0] = "entry"
end
""",
        "the assigned value must belong to the destination's region"
    )

    // Global bindings cannot be reassigned, even though global composites are mutable.
    utils::assert_compile_fail_source(ts,
"""
value := 1

func main():
    value = 2
end
""",
        "global bindings are immutable"
    )

    // Subscript set to local region
    utils::assert_compile_fails_source(ts,
"""
func foo(v):
    x := [0 of 0]
    v[0] = x
end


func main():
    v := [3 of [2 of 1]]
    foo(v)
end
"""
    )

    // Push element from local region
    utils::assert_compile_fails_source(ts,
"""
func foo(v):
    x := [0 of 0]
    push(v, x)
end


func main():
    v := [3 of [2 of 1]]
    foo(v)
end
"""
    )

    // foreign
    utils::assert_compile_fails_source(ts,
"""
func foo(foreign v1, v2):
    v1[0] = v2
end


func main():
    v := [3 of [2 of 1]]
    x := [2, 6]
    foo(v, x)
end
"""
    )

    // Returning foreign composite
    utils::assert_compile_fail_source(ts,
"""
func id_foreign(foreign s: String) -> String:
    return s
end

func main():
    x := "abc"
    y := id_foreign(x)
end
""",
        "cannot return foreign composite value"
    )

    // Option payload allocated in local region but Option allocated in caller-owned region
    utils::assert_compile_fail_source(ts,
"""
func foo(v):
    x := "aaa"
    y := Some{x}[.v]
end

func main():
    v := Some{"aaa"}
    foo(v)
end
""",
        "Option payloads must belong to the containing Option's region"
    )

    // Variant payload allocated in local region but variant allocated in caller-owned region
    utils::assert_compile_fail_source(ts,
"""
variant Box:
    TEXT: String
end

func foo(v):
    x := "aaa"
    y := Box.TEXT{x}[.v]
end

func main():
    v := Box.TEXT{"aaa"}
    foo(v)
end
""",
        "variant payloads must belong to the containing variant's region"
    )

    // Vector element allocated in local region but vector allocated in caller-owned region
    utils::assert_compile_fail_source(ts,
"""
func foo(v):
    x := "aaa"
    y := [x][.v]
end

func main():
    v := [1 of "aaa"]
    foo(v)
end
""",
        "vector elements must belong to the containing vector's region"
    )

    // Mixed-region vector literal may only be borrowed as a default local temporary
    utils::assert_compile_fail_source(ts,
"""
func foo(foreign v: Vec[String]) -> void:
end

func bar(path: String, r: Region):
    x := "aaa"
    foo([path, x][r])
end

func main():
    bar("abc", _)
end
""",
        "vector elements must belong to the containing vector's region"
    )

    // Dictionary value allocated in local region but dictionary allocated in caller-owned region
    utils::assert_compile_fail_source(ts,
"""
func foo(v):
    x := "aaa"
    y := {"a": x}[.v]
end

func main():
    v: Dict[String]
    foo(v)
end
""",
        "dictionary values must belong to the containing dictionary's region"
    )

end
