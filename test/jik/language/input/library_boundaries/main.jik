use "jik/region"
use "jik/std"
use "jik/strbuf"
use "jik/sys"
use "jik/io"
use "jik/testing" as test

// Supply stdin without shell quoting or an interactive prompt.
extern func bootstrap_library_stdin as open_stdin(path: String) -> bool
extern func bootstrap_library_stdin_write as open_write_only_stdin(path: String) -> bool

@embed{C}
static bool bootstrap_library_stdin(JikString *path) {
    return freopen(path->data, "r", stdin) != NULL;
}
static bool bootstrap_library_stdin_write(JikString *path) {
    return freopen(path->data, "wb", stdin) != NULL;
}
C

func main(args):
    assert(len(args) >= 2)
    if args[1] == "input":
        assert(len(args) == 3)
        assert(open_stdin(args[2]))
        print(must std::input())
    elif args[1] == "input-lines":
        assert(len(args) == 3)
        assert(open_stdin(args[2]))
        for i = 0, 4:
            line := must std::input()
            print(len(line), ":", line, ";")
        end
    elif args[1] == "input-error" or args[1] == "input-read-error":
        assert(len(args) == 3)
        if args[1] == "input-read-error":
            assert(open_write_only_stdin(args[2]))
        else:
            assert(open_stdin(args[2]))
        end
        before := region::used_bytes(_)
        try line := std::input():
            println("unexpected input success: ", line)
            return 2
        except:
            assert(region::used_bytes(_) == before)
            print(error_code(), ":", error_msg())
        end
    elif args[1] == "panic":
        std::panic("expected library panic")
    elif args[1] == "exit":
        sys::exit(7)
    elif args[1] == "suite-failure":
        ts := test::suite_new()
        test::suite_assert(ts, false, site())
        test::suite_finish(ts)
    elif args[1] == "streams":
        assert(len(args) == 6 and args[2] == "" and args[3] == "two words" and args[4] == "a\"b" and args[5] == "end\\")
        print("stdout")
        io::write_stderr("stderr")
    else:
        before := region::used_bytes(_)
        buffer := strbuf::new("library")
        assert(region::used_bytes(.buffer) > before)
        assert(region::total_bytes(.buffer) >= region::used_bytes(.buffer))
        assert(region::block_count(.buffer) > 0)
        region::print_stats(.buffer)
        strbuf::print(buffer)
    end
end
