use "jik/testing" as test
use "utils"

func test_compile_fail_01(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    x: int
end

func main():
    a := Foo
end
""",
        "struct name cannot be used as a value")
end

func test_compile_fail_02(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Fruit:
    ANANAS
    BANANA
end

func main():
    a := Fruit
end
""",
        "enum name cannot be used as a value")
end

func test_compile_fail_03(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Value:
    INT: int
end

func main():
    a := Value
end
""",
        "variant name cannot be used as a value")
end

func test_compile_fail_04(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Value:
    INT: int
end

func main():
    a := Value.INT
end
""",
        "variant tag cannot be used as a value")
end

func test_compile_fail_05(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    items: Vec[Foo]
end

func main():
end
""",
        "illegal recursive struct definition")
end

func test_compile_fail_06(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Value:
    INT: int
    TEXT: String
end

func main():
    v := Value.INT{1}
    match v:
        case Value.INT{x}:
            print(x)
    end
end
""",
        "match doesn't exhaust all variant tags")
end

func test_compile_fail_07(ts):
    utils::assert_compile_fail_source(ts,
"""
func jik_bad():
end

func main():
end
""",
        "uses one of reserved prefixes")
end

func test_compile_fail_08(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    jik_x := 1
end
""",
        "uses one of reserved prefixes")
end

func test_compile_fail_09(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    jik_field: int
end

func main():
end
""",
        "uses one of reserved prefixes")
end

func test_compile_fail_10(ts):
    utils::assert_compile_fail_source(ts,
"""
use "jik/io"

func main():
    f := io::File{}
end
""",
        "external struct type has no init function")
end

func test_compile_fail_11(ts):
    utils::assert_compile_fail_source(ts,
"""
use "jik/io"

func main():
    f: io::File
end
""",
        "external struct type has no init function")
end

func test_compile_fail_12(ts):
    utils::assert_compile_fail_source(ts,
"""
use "jik/io"

struct Foo:
    f: io::File
end

func main():
end
""",
        "external struct type has no init function")
end

func test_compile_fail_13(ts):
    utils::assert_compile_fail_source(ts,
"""
extern struct jik_TestOpaque as
    TestOpaque

extern init func jik_test_opaque_new1 as
    new1(region: Region) -> TestOpaque

extern init func jik_test_opaque_new2 as
    new2(region: Region) -> TestOpaque

@embed{C_END}
typedef struct jik_TestOpaque {
    int x;
} jik_TestOpaque;

jik_TestOpaque *
jik_test_opaque_new1(JikRegion *r)
{
    return jik_region_alloc(r, sizeof(jik_TestOpaque));
}

jik_TestOpaque *
jik_test_opaque_new2(JikRegion *r)
{
    return jik_region_alloc(r, sizeof(jik_TestOpaque));
}
C_END

func main():
end
""",
        "extern struct type already has an init function")
end

func test_compile_fail_14(ts):
    utils::assert_compile_fail_source(ts,
"""
func ordinary() -> int:
    return 1
end

func main():
    value := ordinary()!
end
""",
        "non-throwable function cannot be handled with \"must\"")
end

func test_compile_fail_15(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    value := 1
    value!
end
""",
        "expected function call")
end

func test_compile_fail_16(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    value: int
end

func wrong(value: int):
end

func main():
    f := Foo{}
    f.wrong()
end
""",
        "receiver does not match the first parameter")
end

func test_compile_fail_17(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    value := 1
    value.nope()
end
""",
        "uniform function call requires a struct or variant receiver")
end

func test_compile_fail_18(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Choice:
    VALUE: int
end

func wrong(value: int):
end

func main():
    choice := Choice.VALUE{1}
    choice.wrong()
end
""",
        "receiver does not match the first parameter")
end

func test_compile_fail_19(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
    GREEN
end

func main():
    color := Color.RED
    match color:
        case Color.RED:
            println("red")
    end
end
""",
        "match does not exhaust enum Color; missing Color.GREEN")
end

func test_compile_fail_20(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
    GREEN
end

func main():
    color := Color.RED
    match color:
        case Color.RED:
            println("red")
        case Color.RED:
            println("red again")
        case Color.GREEN:
            println("green")
    end
end
""",
        "duplicate enum case: Color.RED")
end

func test_compile_fail_21(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
end

func main():
    color := Color.RED
    match color:
        case Color.BLUE:
            println("blue")
    end
end
""",
        "unknown enum member in match for Color: BLUE")
end

func test_compile_fail_22(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
end

enum Mode:
    RED
end

func main():
    color := Color.RED
    match color:
        case Mode.RED:
            println("wrong")
    end
end
""",
        "wrong enum type in match: expected Color, got Mode")
end

func test_compile_fail_23(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
end

func main():
    color := Color.RED
    match color:
        case Color.RED{value}:
            println(value)
    end
end
""",
        "enum case cannot bind a payload")
end

func test_compile_fail_24(ts):
    utils::assert_compile_fail_source(ts,
"""
enum Color:
    RED
end

func main():
    color := Color.RED
    match color:
        case RED:
            println("red")
    end
end
""",
        "expected qualified enum or variant case")
end

func test_compile_fail_25(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    match 1:
        case Number.ONE:
            println("one")
    end
end
""",
        "expected enum or variant instance")
end

func test_compile_fail_26(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Choice:
    FIRST: int
    SECOND
end

func main():
    choice := Choice.FIRST{1}
    match choice:
        case Choice.FIRST{value}:
            println(value)
        case Choice.FIRST{value}:
            println(value)
        case Choice.SECOND:
            println("second")
    end
end
""",
        "duplicate variant case: Choice.FIRST")
end

func test_compile_fail_27(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    size_t := 1
end
""",
        "identifier \"size_t\" is reserved by the C backend")
end

func test_compile_fail_28(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    EOF := 1
end
""",
        "identifier \"EOF\" is reserved by the C backend")
end

func test_compile_fail_29(ts):
    utils::assert_compile_fail_source(ts,
"""
func main():
    _Private := 1
end
""",
        "identifier \"_Private\" is reserved by the C backend")
end

func test_compile_fail_30(ts):
    utils::assert_compile_fail_source(ts,
"""
variant Value:
    EMPTY
end

func main():
    value := Value.EMPTY
end
""",
        "variant tag cannot be used as a value"
    )

    utils::assert_compile_fail_source(ts,
"""
variant Value:
    EMPTY
end

func invalid(r: Region):
    value := Value.EMPTY[r]
end

func main():
end
""",
        "unsubscriptable type"
    )
end

func test_compile_fail_31(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    x: int
end

func main():
    y := 1
    value := Foo{y}
end
""",
        "unknown field name: \"y\"")
end

func test_compile_fail_32(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    x: int
end

func main():
    value := Foo{x}
end
""",
        "undefined symbol: x")
end

func test_compile_fail_33(ts):
    utils::assert_compile_fail_source(ts,
"""
struct Foo:
    x: int
end

func main():
    x := "wrong"
    value := Foo{x}
end
""",
        "type mismatch: required int, got String")
end

func run_tests(ts):
    test_compile_fail_01(ts)
    test_compile_fail_02(ts)
    test_compile_fail_03(ts)
    test_compile_fail_04(ts)
    test_compile_fail_05(ts)
    test_compile_fail_06(ts)
    test_compile_fail_07(ts)
    test_compile_fail_08(ts)
    test_compile_fail_09(ts)
    test_compile_fail_10(ts)
    test_compile_fail_11(ts)
    test_compile_fail_12(ts)
    test_compile_fail_13(ts)
    test_compile_fail_14(ts)
    test_compile_fail_15(ts)
    test_compile_fail_16(ts)
    test_compile_fail_17(ts)
    test_compile_fail_18(ts)
    test_compile_fail_19(ts)
    test_compile_fail_20(ts)
    test_compile_fail_21(ts)
    test_compile_fail_22(ts)
    test_compile_fail_23(ts)
    test_compile_fail_24(ts)
    test_compile_fail_25(ts)
    test_compile_fail_26(ts)
    test_compile_fail_27(ts)
    test_compile_fail_28(ts)
    test_compile_fail_29(ts)
    test_compile_fail_30(ts)
    test_compile_fail_31(ts)
    test_compile_fail_32(ts)
    test_compile_fail_33(ts)
end
