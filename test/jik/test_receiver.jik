use "jik/testing" as test
use "jik/string"

use "support"
use "test_regions"
use "../../src/jik/semantic/typing/inference"
use "../../src/jik/semantic/typing/typecheck"
use "../../src/jik/semantic/regions/regions"


func test_receiver_parser(ts) -> void:
    text := "func main():\n    value := produce().add(\n        1\n    ).read()\nend\n"
    parsed := support::parse_source(text)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    if parsed.diagnostics.error_count > 0:
        return
    end
    count := 0
    for node in parsed.ast.nodes:
        if node.kind is CALL and node.kind.CALL.is_receiver:
            count += 1
            call := node.kind.CALL
            name := parsed.ast.nodes[call.callee].kind.IDENTIFIER_EXPR.name
            test::suite_assert(ts, node.span.start == string::find(text, "produce()"), site())
            test::suite_assert(ts, len(call.arguments) == (2 if name == "add" else 1), site())
            test::suite_assert(ts, parsed.ast.nodes[call.arguments[0]].kind is CALL, site())
        end
    end
    test::suite_assert(ts, count == 2, site())
end


func test_receiver_resolution(ts) -> void:
    text := "struct Value:\n    number: int\nend\nfunc read(value: Value) -> int:\n    return value.number\nend\nfunc inferred(value):\n    return value.read()\nend\nfunc main():\n    value := Value{number = 42}\n    assert(inferred(value) == 42)\nend\n"
    comp := support::infer_source(text, 0)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    for node in mod.ast.nodes:
        if node.kind is CALL and node.kind.CALL.is_receiver:
            call := node.kind.CALL
            test::suite_assert(ts, call.target is Some and call.builtin is None, site())
            test::suite_assert(ts, call.target?.origin == mod.global_scope.symbols["read"]?.origin, site())
            test::suite_assert(ts, call.target?.source_id == 0 and len(call.arguments) == 1, site())
        end
    end
    inference::run(comp, 0)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
end


func test_receiver_copy_region(ts) -> void:
    text := "func append(values: Vec[String], text: String):\n    values.push(text.copy(.values))\nend\nfunc invoke(values: Vec[String]):\n    text := \"local\"\n    append(values, text)\nend\n"
    comp := support::infer_source(text, -1)
    typecheck::run(comp)
    regions::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count == 0:
        mod := comp.modules[0]
        function := mod.ast.nodes[mod.global_scope.symbols["append"]?.origin].kind.FUNCTION_DECL
        test::suite_assert(ts, function.is_region_safe, site())
    end
end


func test_receiver_errors(ts) -> void:
    test_regions::check_error(ts, "func main():\n    value := 1\n    value.missing()\nend\n", "invalid receiver type")
    test_regions::check_error(ts, "struct Value:\n    number: int\nend\nfunc read(value):\n    return 1\nend\nfunc main():\n    value := Value{}\n    value.read()\nend\n", "unannotated receiver parameter")
    test_regions::check_error(ts, "struct Value:\n    number: int\nend\nfunc read(value: int):\nend\nfunc main():\n    value := Value{}\n    value.read()\nend\n", "receiver type mismatch")
    test_regions::check_error(ts, "func main():\n    values := [1]\n    values.push()\nend\n", "call arity mismatch")
end


func run_tests(ts) -> void:
    println("[test] test_receiver")
    test_receiver_parser(ts)
    test_receiver_resolution(ts)
    test_receiver_copy_region(ts)
    test_receiver_errors(ts)
end
