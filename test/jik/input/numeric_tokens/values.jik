func scale(value: double) -> double:
    return value * 2
end

func main():
    maximum: int = 2_147_483_647
    minimum: int = -2_147_483_648
    if maximum != 2147483647 or minimum != (-2147483647 - 1):
        return 1
    end
    if 1_2.3_4e+0_2 != 1234.0 or 12E-1 != 1.2 or 1e0 != 1.0:
        return 2
    end
    if scale(-1.25e+1) != -25.0 or 10-2*3 != 4:
        return 3
    end
    // No whitespace is required where token boundaries are unambiguous.
    values := [2of 7]
    values[1_0-9] = 9
    optional := Some{1.5e+1}
    if values[1] != 9 or optional? != 15.0:
        return 4
    end
    println(maximum, ":", minimum, ":", values[0], ":", optional?)
end
