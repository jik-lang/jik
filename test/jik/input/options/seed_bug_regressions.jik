func main():
    nested: Option[Option[int]] = Some{None}
    present := Some{7}
    conditional := None if true else present
    values := [None, Some{3}, None]
    if nested is None or nested? is Some or conditional is Some or values[0] is Some or values[1]? != 3:
        return 1
    end
    values[1] = None
    push(values, None)
    if values[1] is Some or values[3] is Some:
        return 2
    end
    println(nested, ":", conditional, ":", values)
    return 42
end
