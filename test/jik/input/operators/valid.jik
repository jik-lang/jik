func mixed(value: double):
    return -value * 2 + 1
end

func char_equal(left: char, right: char):
    return left == right
end

func main():
    if 2 + 3 * 4 != 14:
        return 1
    end
    if (2 + 3) * 4 != 20:
        return 2
    end
    if 7 - 2 - 1 != 4:
        return 3
    end
    if 20 / 5 * 2 != 8:
        return 4
    end
    if 8 % 3 + 1 != 3:
        return 5
    end
    if -(2 + 3) != -5:
        return 6
    end
    if -2 * 3 != -6:
        return 7
    end
    if -8 / 3 != -2:
        return 8
    end
    if -8 % 3 != -2:
        return 9
    end
    if 1_234 != 1234:
        return 10
    end
    if 1.25e+1_0 != 12500000000.0:
        return 12
    end
    if 3.141_592 != 3.141592:
        return 13
    end
    if mixed(2.5) != -4.0:
        return 14
    end
    if 1 != 1.0:
        return 15
    end
    if not (2 > 1):
        return 16
    end
    if not (1 <= 1.0):
        return 17
    end
    if not (2.0 >= 1):
        return 18
    end
    if (not false) != true:
        return 19
    end
    if true == false:
        return 20
    end
    return 42
end
