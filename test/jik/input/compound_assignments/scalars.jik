func adjust(value):
    value += 3
    value -= 2
    value *= 4
    value /= 2
    value %= 9
    return value
end


func main():
    integer := adjust(10)
    decimal := 5.0
    decimal += 2
    decimal -= 1.5
    decimal *= 2
    decimal /= 2.0
    negative := -11
    negative /= 2
    negative %= 3
    if integer != 4 or decimal != 5.5 or negative != -2:
        return 1
    end
    return 42
end
