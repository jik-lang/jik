func main():
    value := "abcdef"
    if value[:] != value or value[:3] != "abc" or value[3:] != "def" or value[1:5] != "bcde":
        return 1
    end
    if value[2:2] != "" or value[:0] != "" or value[6:] != "":
        return 2
    end
    if value[1:5][1:3] != "cd" or value[1:][0] != value[1]:
        return 3
    end
    empty: String
    if empty[:] != "" or empty[:0] != "" or empty[0:] != "" or empty[0:0] != "":
        return 4
    end
    println(value[:3], ":", value[3:], ":", value[1:5])
    return 42
end
