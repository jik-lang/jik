use "library" as lib


global_value := must lib::number(7)
global_text := lib::text()!


func foreign_value(box: lib::Box):
    local := "local"
    assert(lib::read(local, box)! == 8)
end


throws func recursive(depth: int) -> int:
    if depth > 0:
        return recursive(depth - 1)! + 1
    end
    return 0
end


func caller_owned(r: Region) -> String:
    value := must lib::text(r)
    return value
end


throws func fail_zero():
    fail(0)
end


func main():
    assert(global_value == 7 and global_text == "caller-owned")
    value: int = must lib::number(4)
    assert(value == 4)
    value = lib::number(lib::number(5)!)!
    assert(value == 5)
    assert(-lib::number(2)! == -2)
    assert((not lib::flag()!) == false)
    assert(lib::number(2)! * 3 + 1 == 7)
    assert((must lib::number(2)) + 3 == 5)
    assert((lib::number(1)! if true else lib::number(2)!) == 1)
    assert(lib::mode()! == lib::Mode.READY)
    assert(lib::fractional()! == 1.5 and lib::letter()! == 'x')
    assert(lib::new_box(8)!.value == 8)
    box := must lib::new_box(0)
    must box.action()
    box.action()!
    assert(box.value == 2)
    assert(lib::number(box.next()!)! == 3 and box.value == 3)
    foreign_value(box)
    assert(lib::values()![1] == 3)
    assert(lib::option()!? == "payload")
    result := lib::reply()!
    assert(result is TEXT and result.TEXT == "reply")
    here := must lib::location()
    assert(site_line(here) > 0)
    assert(caller_owned() == "caller-owned")
    assert(recursive(3)! == 3)
    assert(true or lib::checked_flag(true)!)
    assert(not (false and lib::checked_flag(true)!))
    values := [lib::number(1)!, must lib::number(2)]
    values[0] = lib::number(9)!
    values[1] += lib::number(3)!
    assert(values[0] == 9 and values[1] == 5)
    for i = 0, 2:
        assert(lib::number(i)! == i)
    end
    try fail_zero():
        assert(false)
    except:
        // A local handler's old failure must not pollute the must wrapper.
        assert(lib::number(6)! == 6)
    end
    lib::number(10)!
    must lib::number(11)
    println("must-ok")
end
