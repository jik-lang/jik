use "jik/testing" as test

use "../../src/jik/semantic/typing/rules"
use "support"
use "../../src/jik/lexer/lexer"
use "../../src/jik/lexer/token"
use "../../src/jik/source"
use "../../src/jik/diag"
use "../../src/jik/parser/ast"
use "../../src/jik/semantic/typing/typecheck"
use "../../src/jik/language/types"


func test_operator_tokens(ts) -> void:
    file := source::SourceFile{text = "* / % <= >= == != < > = // comment\ntrue false not 1_234 2.5e-2"}
    diagnostics := diag::Diagnostics{}[.file]
    tokens := lexer::tokenize(file, diagnostics)
    expected := [token::TokenType.OP_TIMES, token::TokenType.OP_DIV, token::TokenType.OP_MOD,
        token::TokenType.OP_LE, token::TokenType.OP_GE, token::TokenType.OP_EQ,
        token::TokenType.OP_NE, token::TokenType.OP_LT, token::TokenType.OP_GT,
        token::TokenType.ASSIGN, token::TokenType.NEWLINE, token::TokenType.KWD_TRUE,
        token::TokenType.KWD_FALSE, token::TokenType.KWD_NOT, token::TokenType.INTEGER,
        token::TokenType.DOUBLE, token::TokenType.EOF]
    test::suite_assert(ts, diagnostics.error_count == 0, site())
    test::suite_assert(ts, len(tokens) == len(expected), site())
    for index, kind in expected:
        test::suite_assert(ts, tokens[index].type == kind, site())
    end
    test::suite_assert(ts, tokens[3].span.start == 6 and tokens[3].span.stop == 8, site())
    invalid_literals := ["1__2", "1_", "2.3_", "2.3__4", "1e2_"]
    for text in invalid_literals:
        invalid := source::SourceFile{text}
        errors := diag::Diagnostics{}[.invalid]
        lexer::tokenize(invalid, errors)
        test::suite_assert(ts, errors.error_count == 1, site())
        test::suite_assert(ts, errors.messages[0].summary == "invalid numeric literal", site())
    end
end


func test_precedence_tree(ts) -> void:
    parsed := support::parse_source("func main():\n    return -(2 + 3) * 4 / 2 % 7 == 4\nend\n", _)
    test::suite_assert(ts, parsed.diagnostics.error_count == 0, site())
    root := parsed.ast.get_root_module()
    body := parsed.ast.nodes[root.declarations[0]].kind.FUNCTION_DECL.body
    returned := parsed.ast.nodes[body.statements[0]].kind.RETURN.value?
    comparison := parsed.ast.nodes[returned].kind.BINARY
    test::suite_assert(ts, comparison.op == ast::BinaryOp.EQ, site())
    remainder := parsed.ast.nodes[comparison.left].kind.BINARY
    test::suite_assert(ts, remainder.op == ast::BinaryOp.MOD, site())
    division := parsed.ast.nodes[remainder.left].kind.BINARY
    test::suite_assert(ts, division.op == ast::BinaryOp.DIV, site())
    product := parsed.ast.nodes[division.left].kind.BINARY
    test::suite_assert(ts, product.op == ast::BinaryOp.TIMES, site())
    unary := parsed.ast.nodes[product.left].kind.UNARY
    test::suite_assert(ts, unary.op == ast::UnaryOp.NEGATE, site())
    group := parsed.ast.nodes[unary.operand]
    test::suite_assert(ts, group.kind is GROUP, site())
    test::suite_assert(ts, parsed.ast.nodes[group.kind.GROUP].kind.BINARY.op == ast::BinaryOp.PLUS, site())
    test::suite_assert(ts, group.span.start == 25 and group.span.stop == 32, site())
end


func test_inferred_operators(ts) -> void:
    comp := support::infer_source("func scale(value):\n    return -value * 2\nend\nfunc main():\n    flag := not false\n    equal := flag == true\n    decimal := 2.5e+1 / 2 + 1\n    if equal:\n        return scale(-21)\n    end\n    return 0\nend\n", 0)
    support::check_signature(ts, comp, "scale", "func(int) -> int")
    typecheck::run(comp)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    mod := comp.modules[0]
    main := mod.ast.nodes[mod.global_scope.symbols["main"]?.origin].kind.FUNCTION_DECL
    local := mod.ast.nodes[main.body.statements[2]]
    test::suite_assert(ts, local.inferred_type? == types::atom(mod.type_store, types::Atom.DOUBLE), site())
    annotated := support::infer_source("func negate(value) -> int:\n    return -value\nend\nfunc remainder(value) -> int:\n    return value % 3\nend\nfunc invert(value):\n    return not value\nend\n", -1)
    support::check_signature(ts, annotated, "negate", "func(int) -> int")
    support::check_signature(ts, annotated, "remainder", "func(int) -> int")
    support::check_signature(ts, annotated, "invert", "func(bool) -> bool")
    typecheck::run(annotated)
    test::suite_assert(ts, annotated.diagnostics.error_count == 0, site())
end


func test_scalar_rules(ts) -> void:
    store := types::Store{}
    types::initialize(store)
    int_type := types::atom(store, types::Atom.INT)
    double_type := types::atom(store, types::Atom.DOUBLE)
    bool_type := types::atom(store, types::Atom.BOOL)
    char_type := types::atom(store, types::Atom.CHAR)
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.DIV, int_type, int_type)? == int_type, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.TIMES, int_type, double_type)? == double_type, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.EQ, int_type, double_type)? == bool_type, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.NE, char_type, char_type)? == bool_type, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.GT, char_type, char_type) is None, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.EQ, int_type, bool_type) is None, site())
    test::suite_assert(ts, rules::binary_result(store, ast::BinaryOp.MOD, double_type, int_type) is None, site())
end


func run_tests(ts) -> void:
    println("[test] test_operators")
    test_operator_tokens(ts)
    test_precedence_tree(ts)
    test_inferred_operators(ts)
    test_scalar_rules(ts)
end
