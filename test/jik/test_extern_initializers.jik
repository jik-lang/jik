use "jik/testing" as test
use "jik/string"

use "support"
use "test_regions"
use "../../src/jik/parser/format"
use "../../src/jik/language/types"


func test_registration(ts):
    text := "init extern func native_init as arbitrary(foreign r: Region) -> Handle\nextern struct NativeHandle as Handle\nfunc caller():\n    h: Handle\nend\n"
    comp := support::infer_source(text, -1)
    test::suite_assert(ts, comp.diagnostics.error_count == 0, site())
    if comp.diagnostics.error_count > 0:
        return
    end
    mod := comp.modules[0]
    root := mod.ast.get_root_module()
    initializer_id := root.declarations[0]
    declaration := mod.ast.nodes[root.declarations[1]].kind.TYPE_DECL
    definition := mod.type_store.types[declaration.resolved_type?].kind.NAMED
    test::suite_assert(ts, definition.initializer is Some, site())
    test::suite_assert(ts, definition.initializer?.source_id == 0 and definition.initializer?.declaration_id == initializer_id, site())
    test::suite_assert(ts, mod.ast.nodes[initializer_id].kind.FUNCTION_DECL.is_initializer, site())
    test::suite_assert(ts, string::find(format::format(mod.ast), "INIT EXTERN native_init FUNCTION") >= 0, site())
    support::check_signature(ts, comp, "arbitrary", "func(Region) -> module[0]::Handle")
end


func test_invalid_signatures(ts):
    prefix := "extern struct NativeHandle as Handle\n"
    declarations := [
        "extern init func native as f() -> Handle\n",
        "extern init func native as f(r: Region, target: Region) -> Handle\n",
        "extern init func native as f(value: int) -> Handle\n",
        "extern init func native as f(r: Region) -> int\n",
        "extern init func native as f(r: Region) -> String\n",
        "struct Plain:\nend\nextern init func native as f(r: Region) -> Plain\n",
        "extern init func first as f(r: Region) -> Handle\nextern init func second as g(r: Region) -> Handle\n"
    ]
    expected := ["invalid init parameter", "invalid init parameter", "invalid init parameter", "invalid init result", "invalid init result", "invalid init result", "duplicate extern initializer"]
    for index, declaration in declarations:
        comp := support::resolve_source(concat(prefix, declaration))
        test::suite_assert(ts, comp.diagnostics.error_count == 1, site())
        if comp.diagnostics.error_count == 1:
            test::suite_assert(ts, comp.diagnostics.messages[0].summary == expected[index], site())
            test::suite_assert(ts, comp.diagnostics.messages[0].span is Some, site())
        end
    end
    invalid := ["init func f():\nend\n", "extern throws init func native as f(r: Region) -> Handle\n", "init init extern func native as f(r: Region) -> Handle\n", "extern init struct NativeHandle as Handle\n"]
    for declaration in invalid:
        parsed := support::parse_source(declaration)
        test::suite_assert(ts, parsed.diagnostics.error_count > 0, site())
    end
end


func test_opaque_defaults(ts):
    prefix := "extern struct NativeHandle as Handle\n"
    invalid := [
        "func caller():\n    h: Handle\nend\n",
        "func caller():\n    h := Handle{}\nend\n",
        "func caller():\n    h: Vec[Handle]\nend\n",
        "func caller():\n    h: Dict[Handle]\nend\n",
        "struct Holder:\n    value: Handle\nend\n",
        "struct Holder:\n    value: Vec[Handle]\nend\n",
        "struct Holder:\n    value: Dict[Handle]\nend\n",
        "variant Value:\n    Empty\n    Full: Handle\nend\n"
    ]
    for text in invalid:
        test_regions::check_error(ts, concat(prefix, text), "external struct type has no init function")
    end
    test_regions::check_error(ts, concat(prefix, "extern init func native as init_value(r: Region) -> Handle\nfunc caller():\n    h := Handle{field = 1}\nend\n"), "invalid extern fields")
    // None does not construct its opaque payload, including inside a record.
    translated := must support::translate(concat(prefix, "struct Holder:\n    value: Option[Handle]\nend\nfunc main():\n    h := Holder{}\n    assert(h.value is None)\nend\n"), "", _)
    test::suite_assert(ts, string::find(translated, "_none(") >= 0, site())
end


func test_default_emission(ts):
    text := "extern init func native_init as create(r: Region) -> Handle\nextern struct NativeHandle as Handle\nstruct Holder:\n    handle: Handle\nend\nfunc main():\n    first: Handle\n    second := Handle{}\n    holder := Holder{}\nend\n"
    translated := must support::translate(text, "", _)
    test::suite_assert(ts, string::find(translated, "struct NativeHandle * jik_v_first = native_init(jik_local_region)") >= 0, site())
    test::suite_assert(ts, string::find(translated, "struct NativeHandle * jik_v_second = native_init(jik_local_region)") >= 0, site())
    test::suite_assert(ts, string::find(translated, ".jik_f_handle = native_init(jik_local_region)") >= 0, site())
end


func test_caller_destinations(ts):
    prefix := "extern struct NativeHandle as Handle\nextern init func native_init as create(r: Region) -> Handle\n"
    bodies := [
        "func make(r: Region) -> Handle:\n    return Handle{}[r]\nend\n",
        "func make(r: Region) -> Handle:\n    return Handle{}@\nend\n",
        "func make(r: Region) -> Handle:\n    value: Handle[r]\n    return value\nend\n",
        "func make(r: Region) -> Handle:\n    return Handle{}\nend\n"
    ]
    for body in bodies:
        translated := must support::translate(concat(prefix, body, "func main():\nend\n"), "", _)
        test::suite_assert(ts, string::find(translated, "native_init(jik_v_r)") >= 0, site())
        test::suite_assert(ts, string::find(translated, "jik_region_new") < 0, site())
    end
    test_regions::check_error(ts, concat(prefix, "func bad(r: Region) -> Handle:\n    value: Handle\n    return value\nend\n"), "cannot return local allocation")
end


func run_tests(ts):
    println("[test] test_extern_initializers")
    test_registration(ts)
    test_invalid_signatures(ts)
    test_opaque_defaults(ts)
    test_default_emission(ts)
    test_caller_destinations(ts)
end
