//! Command-line argument parser.

use "jik/std"
use "jik/strbuf"


// -------------------------------------------------------------
//      Types
// -------------------------------------------------------------


/// A positional value accepted by the parser or an option.
struct _ArgSpec:
    _name: String
    _help: String
end

/// Configured option handle.
struct ArgumentOption:
    _name: String
    _short_name: String
    _help: String
    _positionals: Vec[_ArgSpec]
end

/// Configured parser.
struct Parser:
    _name: String
    _description: String
    _positionals: Vec[_ArgSpec]
    _options: Vec[ArgumentOption]
end

/// Values returned by `parse`.
struct ParseResult:
    positionals: Dict[String]
    options: Dict[Dict[String]]
end


// -------------------------------------------------------------
//      Configuration helpers
// -------------------------------------------------------------

func _valid_option_name(name: String) -> bool:
    return len(name) > 2 and name[0] == '-' and name[1] == '-'
end

func _valid_short_name(name: String) -> bool:
    return len(name) == 0 or (len(name) == 2 and name[0] == '-')
end

func _has_option_name(foreign parser: Parser, foreign name: String) -> bool:
    for option in parser._options:
        if option._name == name or option._short_name == name:
            return true
        end
    end
    return false
end

func _has_positional_name(foreign parser: Parser, foreign name: String) -> bool:
    for positional in parser._positionals:
        if positional._name == name:
            return true
        end
    end
    return false
end

func _has_option_positional_name(foreign option: ArgumentOption, foreign name: String) -> bool:
    for positional in option._positionals:
        if positional._name == name:
            return true
        end
    end
    return false
end


// -------------------------------------------------------------
//      Configuration API
// -------------------------------------------------------------


/// Create an empty argument parser with a program name for generated help.
///
/// @param name Program name shown in the usage line.
/// @param r Allocation region for the parser and all configured data.
func new(foreign name: String, r: Region) -> Parser:
    parser := Parser{}[r]
    parser._name = copy(name, .parser)
    return parser
end

/// Set the prose description shown before generated help usage.
///
/// @param parser Parser to configure.
/// @param description Description shown before the usage section.
func set_description(parser: Parser, foreign description: String):
    parser._description = copy(description, .parser)
end

/// Add a required positional argument.
///
/// @param parser Parser to configure.
/// @param name Positional argument name.
/// @param help Help text.
func add_positional(parser: Parser, foreign name: String, foreign help: String):
    if len(name) == 0:
        std::panic("argparse: positional name cannot be empty")
    elif _has_positional_name(parser, name):
        std::panic("argparse: duplicate positional name")
    end
    positional := _ArgSpec{
        _name = copy(name, .parser),
        _help = copy(help, .parser)
    }[.parser]
    push(parser._positionals, positional)
end

/// Add an option and return it.
///
/// An option with no declared values acts as a flag.
/// Long names must begin with `--`. Short names are optional; when provided,
/// they must be `-` followed by one character. Duplicate option names
/// terminate through `std::panic`.
///
/// @param parser Parser to configure.
/// @param name Long option name, such as `--verbose`.
/// @param short_name Short option name, such as `-v`, or an empty string for a long-only option.
/// @param help Help text.
/// @returns Configured option handle.
func add_option(parser: Parser, foreign name: String, foreign short_name: String, foreign help: String) -> ArgumentOption:
    if not _valid_option_name(name):
        std::panic("argparse: option name must begin with --")
    elif not _valid_short_name(short_name):
        std::panic("argparse: short option must be empty or - followed by one character")
    elif _has_option_name(parser, name) or (len(short_name) > 0 and _has_option_name(parser, short_name)):
        std::panic("argparse: duplicate option")
    end
    option := ArgumentOption{
        _name = copy(name, .parser),
        _short_name = copy(short_name, .parser),
        _help = copy(help, .parser)
    }[.parser]
    push(parser._options, option)
    return option
end

/// Add a positional value consumed by an option.
///
/// Value names must be unique within an option because they become keys in the parse result.
///
/// @param option Option returned by `add_option`.
/// @param name Value name.
/// @param help Help text.
func add_option_positional(option: ArgumentOption, foreign name: String, foreign help: String):
    if len(name) == 0:
        std::panic("argparse: option value name cannot be empty")
    elif _has_option_positional_name(option, name):
        std::panic("argparse: duplicate option value name")
    end
    positional := _ArgSpec{
        _name = copy(name, .option),
        _help = copy(help, .option)
    }[.option]
    push(option._positionals, positional)
end


// -------------------------------------------------------------
//      Parsing helpers
// -------------------------------------------------------------


func _is_option(arg: String) -> bool:
    return len(arg) > 1 and arg[0] == '-'
end

func _get_option_index(foreign parser: Parser, foreign arg: String) -> int:
    for i = 0, len(parser._options):
        option := parser._options[i]
        if option._name == arg or option._short_name == arg:
            return i
        end
    end
    return -1
end

// -------------------------------------------------------------
//      Parsing API
// -------------------------------------------------------------


/// Parse command-line arguments into a result.
///
/// `args` must not include the executable name. The parsed dictionaries are allocated in `r`. Options may be written with their long or short names.
/// `--` ends option parsing. Repeating an option is a parse error.
/// Supported forms are `--long` and `-s`; grouped short options and inline values such as `--output=file` are not supported.
/// Option values are retrieved by name, such as `result.options["--output"]?["file"]?`.
/// Unknown or repeated options, missing option values, and missing or extra positional arguments return an `argparse:` error.
///
/// @param parser Configured parser.
/// @param args Command-line tokens after the executable name.
/// @param r Allocation region for the returned result.
/// @returns Parsed positional and option values.
throws func parse(foreign parser: Parser, foreign args: Vec[String], r: Region) -> ParseResult:
    result := ParseResult{}[r]
    end_options := false
    current_positional := 0
    i := 0
    while i < len(args):
        arg := args[i]
        if end_options:
            if current_positional >= len(parser._positionals):
                fail(concat("argparse: unexpected positional ", arg, .parser))
            end
            positional := parser._positionals[current_positional]
            result.positionals[copy(positional._name, r)] = copy(arg, r)
            current_positional += 1
            i += 1
            continue
        end
        if arg == "--":
            end_options = true
            i += 1
            continue
        end
        if _is_option(arg):
            option_index := _get_option_index(parser, arg)
            if option_index == -1:
                fail(concat("argparse: unknown option ", arg, .parser))
            end
            option := parser._options[option_index]
            if result.options[option._name] is Some:
                fail(concat("argparse: duplicate option ", arg, .parser))
            end
            required_values := len(option._positionals)
            if i + required_values >= len(args):
                fail(concat("argparse: missing value for option ", arg, .parser))
            end
            values: Dict[String][r]
            j := 0
            while j < required_values:
                positional := option._positionals[j]
                values[copy(positional._name, r)] = copy(args[i + j + 1], r)
                j += 1
            end
            result.options[copy(option._name, r)] = values
            i += required_values + 1
            continue
        end
        if current_positional >= len(parser._positionals):
            fail(concat("argparse: unexpected positional ", arg, .parser))
        end
        positional := parser._positionals[current_positional]
        result.positionals[copy(positional._name, r)] = copy(arg, r)
        current_positional += 1
        i += 1
    end
    if current_positional < len(parser._positionals):
        positional := parser._positionals[current_positional]
        fail(concat("argparse: missing positional ", positional._name, .parser))
    end

    return result
end


// -------------------------------------------------------------
//      Help API
// -------------------------------------------------------------


func _append_spaces(sb: strbuf::StrBuf, count: int):
    i := 0
    while i < count:
        strbuf::append(sb, " ")
        i += 1
    end
end

func _option_spec_len(foreign option: ArgumentOption) -> int:
    size := len(option._name)
    if len(option._short_name) > 0:
        size += len(option._short_name) + 2
    end
    for positional in option._positionals:
        size += len(positional._name) + 3
    end
    return size
end

func _append_option_spec(sb: strbuf::StrBuf, foreign option: ArgumentOption):
    if len(option._short_name) > 0:
        strbuf::append(sb, option._short_name)
        strbuf::append(sb, ", ")
    end
    strbuf::append(sb, option._name)
    for positional in option._positionals:
        strbuf::append(sb, " <")
        strbuf::append(sb, positional._name)
        strbuf::append(sb, ">")
    end
end

/// Format generated parser help text.
///
/// @param parser Configured parser.
/// @param r Allocation region for the returned string.
/// @returns Help text.
func format_help(foreign parser: Parser, r: Region) -> String:
    sb := strbuf::new("", r)
    if len(parser._description) > 0:
        strbuf::append(sb, parser._description)
        strbuf::append(sb, "\n\n")
    end
    strbuf::append(sb, "Usage:\n  ")
    strbuf::append(sb, parser._name)
    for positional in parser._positionals:
        strbuf::append(sb, " <")
        strbuf::append(sb, positional._name)
        strbuf::append(sb, ">")
    end
    for option in parser._options:
        strbuf::append(sb, " [")
        _append_option_spec(sb, option)
        strbuf::append(sb, "]")
    end
    if len(parser._positionals) > 0:
        width := 0
        for positional in parser._positionals:
            if len(positional._name) > width:
                width = len(positional._name)
            end
        end
        strbuf::append(sb, "\n\nPositional arguments:\n")
        for positional in parser._positionals:
            strbuf::append(sb, "    ")
            strbuf::append(sb, positional._name)
            _append_spaces(sb, width - len(positional._name) + 2)
            strbuf::append(sb, positional._help)
            strbuf::append(sb, "\n")
        end
    end
    if len(parser._options) > 0:
        width := 0
        for option in parser._options:
            size := _option_spec_len(option)
            if size > width:
                width = size
            end
        end
        strbuf::append(sb, "\nOptions:\n")
        for option in parser._options:
            strbuf::append(sb, "    ")
            _append_option_spec(sb, option)
            _append_spaces(sb, width - _option_spec_len(option) + 2)
            strbuf::append(sb, option._help)
            strbuf::append(sb, "\n")
            for positional in option._positionals:
                strbuf::append(sb, "        <")
                strbuf::append(sb, positional._name)
                strbuf::append(sb, ">  ")
                strbuf::append(sb, positional._help)
                strbuf::append(sb, "\n")
            end
            if len(option._positionals) > 0:
                strbuf::append(sb, "\n")
            end
        end
    end

    return strbuf::to_string(sb, r)
end
